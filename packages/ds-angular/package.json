{
  "name": "@full-stack-ds/angular",
  "version": "0.1.0",
  "type": "module",
  "description": "Angular implementation of Full Stack DS (Stack primitive + generated components)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/angular.css.d.ts",
      "default": "./dist/angular.css"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ngc": "ngc -p tsconfig.ngc.json",
    "test": "jest --config jest.config.cjs",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@angular/common": "^21.2.13",
    "@angular/core": "^21.2.13"
  },
  "devDependencies": {
    "@angular/common": "^21.2.13",
    "@angular/compiler": "^21.2.13",
    "@angular/compiler-cli": "^21.2.13",
    "@angular/core": "^21.2.13",
    "@angular/platform-browser": "^21.2.13",
    "@angular/platform-browser-dynamic": "^21.2.13",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "axe-core": "^4.11.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^16.1.5",
    "rxjs": "^7.8.0",
    "typescript": "^6.0.2",
    "zone.js": "^0.15.0"
  },
  "dependencies": {
    "@full-stack-ds/iconography": "workspace:*"
  },
  "license": "MIT",
  "author": "DesignPaths, LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paths-Design/full-stack-ds.git",
    "directory": "packages/ds-angular"
  },
  "homepage": "https://github.com/Paths-Design/full-stack-ds/tree/main/packages/ds-angular#readme",
  "bugs": {
    "url": "https://github.com/Paths-Design/full-stack-ds/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
