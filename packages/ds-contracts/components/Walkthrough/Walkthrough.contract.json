{
  "$schema": "../../component.contract.schema.json",
  "name": "Walkthrough",
  "description": "Guided tour surface anchored to page elements. Consumers control visibility, step content and previous/next boundaries; step dots emit the selected index.",
  "layer": "composer",
  "category": "structure",
  "anatomy": {
    "parts": [
      "root",
      "content",
      "title",
      "description",
      "controls",
      "skip",
      "prev",
      "next",
      "dots",
      "dot",
      "counter"
    ],
    "details": {
      "root": {
        "tag": "div",
        "description": "Guided-tour status region for the active walkthrough step.",
        "role": "root",
        "aria": {
          "role": "status",
          "attributes": [
            "aria-label"
          ]
        }
      },
      "content": {
        "tag": "div",
        "description": "Panel content containing the active step title and description.",
        "role": "content"
      },
      "title": {
        "tag": "h3",
        "description": "Heading for the active walkthrough step.",
        "role": "label"
      },
      "description": {
        "tag": "p",
        "description": "Supporting explanatory text for the active walkthrough step.",
        "role": "content"
      },
      "controls": {
        "tag": "div",
        "description": "Control group for skipping, navigating, and indicating walkthrough progress.",
        "role": "group"
      },
      "skip": {
        "tag": "button",
        "description": "Button that exits or skips the walkthrough.",
        "role": "trigger",
        "interactive": true,
        "focusable": true
      },
      "prev": {
        "tag": "button",
        "description": "Button that moves to the previous walkthrough step.",
        "role": "trigger",
        "interactive": true,
        "focusable": true
      },
      "next": {
        "tag": "button",
        "description": "Button that advances to the next walkthrough step or completes the tour.",
        "role": "trigger",
        "interactive": true,
        "focusable": true
      },
      "dots": {
        "tag": "div",
        "description": "Progress-dot group representing the full step sequence.",
        "role": "group"
      },
      "dot": {
        "tag": "button",
        "description": "Step navigation dot for a single walkthrough step.",
        "role": "trigger",
        "multiple": true,
        "interactive": true,
        "focusable": true,
        "aria": {
          "attributes": [
            "aria-label"
          ]
        }
      },
      "counter": {
        "tag": "span",
        "description": "Visible current-step count within the walkthrough sequence.",
        "role": "context"
      }
    },
    "dom": {
      "tag": "div",
      "part": "root",
      "attrs": {
        "role": "status"
      },
      "bindings": {
        "aria-label": "prop:label"
      },
      "children": [
        {
          "tag": "div",
          "part": "content",
          "attrs": {
            "role": "group"
          },
          "children": [
            {
              "tag": "h3",
              "part": "title",
              "bindings": {
                "aria-label": "prop:label"
              },
              "children": [
                {
                  "tag": "slot",
                  "name": "title"
                }
              ]
            },
            {
              "tag": "p",
              "part": "description",
              "children": [
                {
                  "tag": "slot",
                  "name": "description"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "part": "controls",
          "children": [
            {
              "tag": "button",
              "part": "skip",
              "attrs": {
                "type": "button"
              },
              "bindings": {
                "aria-label": "message:skipTour"
              },
              "events": {
                "click": "prop:onSkip"
              },
              "content": "message:skip"
            },
            {
              "tag": "button",
              "part": "prev",
              "attrs": {
                "type": "button"
              },
              "bindings": {
                "aria-label": "message:previousStep",
                "disabled": "prop:previousDisabled"
              },
              "events": {
                "click": "prop:onPrevious"
              },
              "content": "message:previous"
            },
            {
              "tag": "div",
              "part": "dots",
              "children": [
                {
                  "tag": "button",
                  "part": "dot",
                  "iterate": {
                    "source": "prop:steps",
                    "kind": "array",
                    "itemType": "WalkthroughStepSpec"
                  },
                  "attrs": {
                    "type": "button"
                  },
                  "bindings": {
                    "aria-label": "iter:item.title",
                    "data-step-index": "iter:index"
                  },
                  "events": {
                    "click": "channel:step.onChange(iter:index)"
                  }
                }
              ]
            },
            {
              "tag": "span",
              "part": "counter",
              "bindings": {},
              "content": "prop:progressLabel"
            },
            {
              "tag": "button",
              "part": "next",
              "attrs": {
                "type": "button"
              },
              "bindings": {
                "aria-label": "prop:nextLabel"
              },
              "events": {
                "click": "prop:onNext"
              },
              "content": "prop:nextLabel"
            }
          ]
        }
      ]
    }
  },
  "messages": {
    "tourLabel": {
      "defaultMessage": "Feature tour",
      "description": "Accessible name of the tour region when the consumer supplies none."
    },
    "skip": {
      "defaultMessage": "Skip",
      "description": "Text of the button that ends the tour."
    },
    "skipTour": {
      "defaultMessage": "Skip tour",
      "description": "Accessible name of the button that ends the tour."
    },
    "previous": {
      "defaultMessage": "Previous",
      "description": "Text of the button that returns to the previous step."
    },
    "previousStep": {
      "defaultMessage": "Previous step",
      "description": "Accessible name of the button that returns to the previous step."
    },
    "next": {
      "defaultMessage": "Next",
      "description": "Text and accessible name of the next-step button when the consumer supplies none."
    }
  },
  "props": {
    "styled": {
      "description": "Props for the <Walkthrough> component.",
      "members": [
        {
          "name": "steps",
          "propType": {
            "kind": "array",
            "items": {
              "kind": "ref",
              "to": "WalkthroughStepSpec"
            }
          },
          "description": "Array of step definitions, each specifying an anchor target and content.",
          "default": [
            {
              "anchor": "#step-1",
              "title": "Welcome to the tour"
            },
            {
              "anchor": "#step-2",
              "title": "Browse your dashboard"
            },
            {
              "anchor": "#step-3",
              "title": "Configure preferences"
            }
          ]
        },
        {
          "name": "index",
          "type": "number",
          "description": "Controlled active step index."
        },
        {
          "name": "defaultIndex",
          "type": "number",
          "description": "Uncontrolled initial step index.",
          "default": 0
        },
        {
          "name": "onStepChange",
          "type": "(index: number) => void",
          "description": "Called when the active step changes."
        },
        {
          "name": "onComplete",
          "type": "() => void",
          "description": "Called when the user advances past the last step."
        },
        {
          "name": "onSkip",
          "type": "() => void",
          "description": "Called when the user skips the tour."
        },
        {
          "name": "label",
          "type": "string",
          "description": "Accessible label for the walkthrough region.",
          "defaultMessage": "tourLabel"
        },
        {
          "name": "storageKey",
          "type": "string",
          "description": "localStorage key to persist tour completion state across sessions."
        },
        {
          "name": "autoStart",
          "type": "boolean",
          "description": "Automatically begin the tour on mount.",
          "default": false
        },
        {
          "name": "closeOnOutsideClick",
          "type": "boolean",
          "description": "Close/skip the tour when the user clicks outside the panel.",
          "default": false
        },
        {
          "name": "placement",
          "type": "WalkthroughPlacement",
          "description": "Preferred placement of the walkthrough panel relative to its anchor.",
          "default": "auto"
        },
        {
          "name": "onPrevious",
          "type": "() => void",
          "description": "Requests the previous step. The consumer controls step boundaries and updates index."
        },
        {
          "name": "onNext",
          "type": "() => void",
          "description": "Requests the next step or completion. The consumer updates index or closes the tour."
        },
        {
          "name": "previousDisabled",
          "type": "boolean",
          "default": false,
          "description": "Disables previous-step navigation at a consumer-defined boundary."
        },
        {
          "name": "nextLabel",
          "type": "string",
          "defaultMessage": "next",
          "description": "Visible label for the next-step action, such as Finish on the final step."
        },
        {
          "name": "progressLabel",
          "type": "string",
          "description": "Visible progress text supplied by the consumer, such as 1 of 3."
        }
      ]
    }
  },
  "channels": {
    "step": {
      "description": "Active step index.",
      "value": "index",
      "defaultValue": "defaultIndex",
      "onChange": "onStepChange",
      "valueType": "number"
    }
  },
  "types": {
    "WalkthroughPlacement": {
      "kind": "union",
      "values": [
        "top",
        "bottom",
        "left",
        "right",
        "auto"
      ]
    },
    "WalkthroughStepSpec": {
      "kind": "alias",
      "alias": "{ anchor: string; title: string; description?: string }"
    }
  },
  "variants": {
    "placement": [
      "top",
      "bottom",
      "left",
      "right",
      "auto"
    ]
  },
  "states": {
    "dimensions": {
      "pointer": {
        "category": "interaction",
        "values": [
          "default",
          "hover"
        ],
        "initial": "default",
        "exclusive": true
      },
      "availability": {
        "category": "availability",
        "effect": "restyle",
        "values": [
          "enabled",
          "disabled"
        ],
        "initial": "enabled",
        "exclusive": true,
        "suppresses": {
          "categories": [
            "interaction"
          ]
        }
      }
    }
  },
  "motion": {
    "reducedMotion": "respect",
    "transitions": [
      {
        "name": "open",
        "trigger": "openness=hidden\u2192visible",
        "phase": "enter",
        "properties": [
          "opacity",
          "transform"
        ],
        "duration": "core.motion.duration.short",
        "easing": "core.motion.easing.emphasized-in"
      },
      {
        "name": "close",
        "trigger": "openness=visible\u2192hidden",
        "phase": "exit",
        "properties": [
          "opacity"
        ],
        "duration": "core.motion.duration.short",
        "easing": "core.motion.easing.emphasized-out"
      }
    ]
  },
  "focus": {
    "strategy": "none",
    "description": "Walkthrough panels are non-blocking. Focus remains on the anchored element while the panel is visible."
  },
  "surface": {
    "kind": "coachmark",
    "presence": "persistent",
    "modality": "non-blocking",
    "anchor": {
      "selector": {
        "prop": "steps",
        "path": "anchor",
        "indexChannel": "step"
      }
    },
    "positioning": {
      "strategy": "anchored",
      "placementProp": "placement",
      "collision": "flip-shift"
    },
    "dismissal": [
      "escape",
      "outside-click"
    ]
  },
  "portal": {
    "enabled": true,
    "defaultTarget": "body",
    "positioning": "anchored",
    "layering": "popover",
    "collision": "flip-shift"
  },
  "dismissal": {
    "triggers": [
      {
        "event": "escape"
      },
      {
        "event": "outsideClick",
        "enabledBy": "closeOnOutsideClick"
      }
    ]
  },
  "slots": {
    "root": {
      "required": true,
      "selector": "[data-slot=\"walkthrough\"]"
    },
    "title": {
      "required": false,
      "selector": "[data-slot=\"walkthrough-title\"]"
    },
    "description": {
      "required": false,
      "selector": "[data-slot=\"walkthrough-description\"]"
    },
    "controls": {
      "required": false,
      "selector": "[data-slot=\"walkthrough-controls\"]"
    },
    "skip": {
      "required": false,
      "selector": "[data-slot=\"walkthrough-skip\"]"
    },
    "prev": {
      "required": false,
      "selector": "[data-slot=\"walkthrough-prev\"]"
    },
    "next": {
      "required": false,
      "selector": "[data-slot=\"walkthrough-next\"]"
    },
    "progress": {
      "required": false,
      "selector": "[data-slot=\"walkthrough-progress\"]"
    },
    "dot": {
      "required": false,
      "selector": "[data-slot=\"walkthrough-dot\"]"
    },
    "counter": {
      "required": false,
      "selector": "[data-slot=\"walkthrough-counter\"]"
    }
  },
  "ssr": {
    "hydrateOn": "interaction"
  },
  "rtl": {
    "flipIcon": false
  },
  "relationships": [
    {
      "from": "content",
      "to": "title",
      "attribute": "aria-labelledby",
      "description": "Walkthrough content region takes its accessible name from its title element."
    },
    {
      "from": "content",
      "to": "description",
      "attribute": "aria-describedby",
      "description": "Walkthrough content region is described by its description element."
    }
  ],
  "a11y": {
    "role": "status",
    "apgPattern": "status",
    "labeling": [
      "aria-label"
    ],
    "keyboard": [
      {
        "key": "ArrowRight",
        "action": "Advance to the next step.",
        "when": "active"
      },
      {
        "key": "ArrowLeft",
        "action": "Go to the previous step.",
        "when": "active"
      },
      {
        "key": "Escape",
        "action": "Close/skip the walkthrough tour.",
        "when": "active"
      },
      {
        "key": "Enter|Space",
        "action": "Activate the focused control (skip, prev, next, or dot).",
        "when": "active"
      }
    ]
  },
  "a2ui": {
    "category": "overlay",
    "usageHints": [
      "Supply real anchor selectors for each step",
      "Control index and update title and description slots for the active step",
      "Handle onPrevious, onNext and onSkip to manage step boundaries and visibility",
      "Use previousDisabled, nextLabel and progressLabel to describe progression",
      "The walkthrough is non-blocking and does not trap focus"
    ],
    "children": {
      "allowed": true,
      "slot": "children",
      "accepts": [
        "WalkthroughStep",
        "WalkthroughAnchor"
      ]
    }
  }
}
