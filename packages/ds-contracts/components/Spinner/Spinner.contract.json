{
  "$schema": "../../component.contract.schema.json",
  "name": "Spinner",
  "description": "Rotating indicator for indeterminate loading states.",
  "layer": "primitive",
  "category": "feedback",
  "anatomy": {
    "parts": [
      "root",
      "visual"
    ],
    "details": {
      "root": {
        "tag": "div",
        "description": "Loading status wrapper that may expose a localized label when not decorative.",
        "role": "region",
        "aria": {
          "role": "status",
          "attributes": [
            "aria-label"
          ]
        }
      },
      "visual": {
        "tag": "span",
        "description": "Animated visual spinner mark; hidden from assistive technology.",
        "role": "decoration"
      }
    },
    "dom": {
      "tag": "div",
      "part": "root",
      "bindings": {
        "aria-label": "prop:label",
        "aria-hidden": "prop:ariaHidden"
      },
      "children": [
        {
          "tag": "span",
          "part": "visual",
          "attrs": {
            "aria-hidden": "true"
          }
        }
      ]
    }
  },
  "props": {
    "designed": {
      "members": [
        {
          "name": "size",
          "propType": {
            "kind": "ref",
            "to": "SpinnerSize"
          },
          "description": "Visual size token"
        },
        {
          "name": "thickness",
          "propType": {
            "kind": "ref",
            "to": "SpinnerThickness"
          },
          "description": "Stroke thickness token"
        },
        {
          "name": "ariaHidden",
          "propType": {
            "kind": "boolean"
          },
          "description": "If decorative only, set ariaHidden; else provide label"
        },
        {
          "name": "label",
          "propType": {
            "kind": "string"
          },
          "description": "Localized label for screen reader users; ignored if ariaHidden"
        },
        {
          "name": "inline",
          "propType": {
            "kind": "boolean"
          },
          "description": "Inline layout (align with baseline)"
        },
        {
          "name": "showAfterMs",
          "propType": {
            "kind": "number"
          },
          "description": "Delay before showing (ms) to avoid spinner flash"
        }
      ]
    }
  },
  "types": {
    "SpinnerSize": {
      "kind": "union",
      "values": [
        "xs",
        "sm",
        "md",
        "lg"
      ]
    },
    "SpinnerThickness": {
      "kind": "union",
      "values": [
        "hairline",
        "regular",
        "bold"
      ]
    }
  },
  "variants": {
    "size": [
      "xs",
      "sm",
      "md",
      "lg"
    ],
    "thickness": [
      "hairline",
      "regular",
      "bold"
    ]
  },
  "states": {
    "dimensions": {
      "pointer": {
        "category": "interaction",
        "values": [
          "default"
        ],
        "initial": "default",
        "exclusive": true
      }
    }
  },
  "slots": {
    "root": {
      "required": true,
      "selector": "[data-slot=\"spinner\"]"
    },
    "visual": {
      "required": true,
      "selector": "[data-slot=\"spinner-visual\"]"
    }
  },
  "ssr": {
    "hydrateOn": "interaction"
  },
  "rtl": {
    "flipIcon": false
  },
  "a11y": {
    "role": "status",
    "labeling": [
      "aria-label"
    ],
    "keyboard": []
  },
  "a2ui": {
    "category": "display",
    "usageHints": [
      "Add aria-label when the spinner is the only loading indicator visible",
      "Use size to match the spinner to its surrounding context",
      "Use thickness to adjust visual weight (hairline for subtle, bold for prominent)",
      "Prefer Skeleton for content areas; use Spinner for button or icon loading states"
    ],
    "children": {
      "allowed": false
    }
  },
  "motion": {
    "reducedMotion": "respect",
    "loops": [
      {
        "name": "spin",
        "target": {
          "part": "visual"
        },
        "driver": {
          "kind": "repeat"
        },
        "effect": {
          "kind": "rotation",
          "keyframes": [
            {
              "offset": 0,
              "value": 0
            },
            {
              "offset": 1,
              "value": 360
            }
          ]
        },
        "timing": {
          "duration": {
            "token": "spinner.anim.duration",
            "multiplier": 1
          },
          "easing": {
            "cubicBezier": [
              0,
              0,
              1,
              1
            ]
          }
        },
        "reducedMotion": {
          "value": 0
        }
      }
    ]
  }
}
