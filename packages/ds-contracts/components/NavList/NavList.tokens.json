{
  "box-model.gap": {
    "resolvesTo": "semantic.structure.size.gap",
    "fallback": "16px",
    "layer": "semantic"
  },
  "nav-list.color.foreground.default": {
    "resolvesTo": "semantic.color.foreground.secondary",
    "fallback": "#474647",
    "layer": "semantic"
  },
  "nav-list.color.foreground.hover": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "nav-list.color.foreground.current": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "nav-list.color.background.default": {
    "resolvesTo": "semantic.color.background.transparent",
    "fallback": "transparent",
    "layer": "semantic"
  },
  "nav-list.color.background.hover": {
    "resolvesTo": "semantic.color.background.subtle",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  },
  "nav-list.stateLayer.hover": {
    "resolvesTo": "semantic.interaction.stateLayer.hover",
    "fallback": "0.04",
    "layer": "semantic"
  },
  "nav-list.stateLayer.selected": {
    "resolvesTo": "semantic.interaction.stateLayer.selected",
    "fallback": "0.08",
    "layer": "semantic"
  },
  "nav-list.color.outline.focus": {
    "resolvesTo": "semantic.focus.ring.color",
    "fallback": "#0566fe",
    "layer": "semantic"
  },
  "nav-list.size.padding.block": {
    "resolvesTo": "core.spacing.size.02",
    "fallback": "2px",
    "layer": "core"
  },
  "nav-list.size.padding.inline": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "nav-list.size.radius": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  },
  "nav-list.size.gap.list": {
    "resolvesTo": "core.spacing.size.01",
    "fallback": "1px",
    "layer": "core"
  }
}
