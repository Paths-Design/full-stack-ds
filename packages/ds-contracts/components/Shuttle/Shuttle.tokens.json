{
  "box-model.gap": {
    "resolvesTo": "semantic.structure.size.gap",
    "fallback": "16px",
    "layer": "semantic"
  },
  "shuttle.color.background": {
    "resolvesTo": "semantic.color.background.secondary",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  },
  "shuttle.color.foreground.primary": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "shuttle.color.border": {
    "resolvesTo": "semantic.color.border.light",
    "fallback": "#b8b8b8",
    "layer": "semantic"
  },
  "shuttle.color.border.accent": {
    "resolvesTo": "semantic.color.border.accent",
    "fallback": "#d92d2e",
    "layer": "semantic"
  },
  "shuttle.color.list.background": {
    "resolvesTo": "semantic.color.background.primary",
    "fallback": "#ffffff",
    "layer": "semantic"
  },
  "shuttle.color.item.marked.background": {
    "resolvesTo": "semantic.color.background.accent",
    "fallback": "#d92d2e",
    "layer": "semantic"
  },
  "shuttle.color.item.marked.foreground": {
    "resolvesTo": "semantic.color.foreground.onColor",
    "fallback": "#ffffff",
    "layer": "semantic"
  },
  "shuttle.color.focus.ring": {
    "resolvesTo": "semantic.focus.ring.color",
    "fallback": "#0566fe",
    "layer": "semantic"
  },
  "shuttle.focus.ring.width": {
    "resolvesTo": "semantic.focus.ring.width",
    "fallback": "2px",
    "layer": "semantic"
  },
  "shuttle.size.padding": {
    "resolvesTo": "core.spacing.size.07",
    "fallback": "24px",
    "layer": "core"
  },
  "shuttle.size.radius": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  }
}
