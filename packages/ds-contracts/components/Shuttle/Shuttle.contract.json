{
  "$schema": "../../component.contract.schema.json",
  "name": "Shuttle",
  "description": "Dual-listbox transfer widget for moving items between two ordered collections.",
  "layer": "composer",
  "category": "structure",
  "anatomy": {
    "parts": [
      "root",
      "list",
      "item",
      "controls",
      "add",
      "remove"
    ],
    "details": {
      "root": {
        "tag": "div",
        "description": "Group holding the available list, the transfer buttons and the selected list.",
        "role": "group",
        "aria": {
          "role": "group",
          "attributes": [
            "aria-label"
          ]
        }
      },
      "list": {
        "tag": "ul",
        "description": "One side of the transfer: the available options, or the selected ones. Several options can be marked at once.",
        "role": "group",
        "subcomponent": false,
        "aria": {
          "role": "listbox",
          "attributes": [
            "aria-label",
            "aria-multiselectable"
          ]
        }
      },
      "item": {
        "tag": "li",
        "description": "An option; aria-selected reports whether it is marked for transfer.",
        "role": "item",
        "subcomponent": false,
        "multiple": true,
        "focusable": "roving",
        "aria": {
          "role": "option",
          "attributes": [
            "aria-selected"
          ]
        }
      },
      "controls": {
        "tag": "div",
        "description": "The transfer buttons between the two lists.",
        "role": "group"
      },
      "add": {
        "tag": "button",
        "description": "Moves the marked available options to the selected list.",
        "role": "trigger",
        "interactive": true,
        "focusable": true
      },
      "remove": {
        "tag": "button",
        "description": "Moves the marked selected options back to the available list.",
        "role": "trigger",
        "interactive": true,
        "focusable": true
      }
    },
    "dom": {
      "tag": "div",
      "part": "root",
      "attrs": {
        "role": "group"
      },
      "bindings": {
        "aria-label": "prop:ariaLabel"
      },
      "children": [
        {
          "tag": "ul",
          "part": "list",
          "attrs": {
            "role": "listbox",
            "aria-multiselectable": "true",
            "data-side": "available"
          },
          "bindings": {
            "aria-label": "message:availableLabel"
          },
          "events": {
            "keydown": "transfer:keydown"
          },
          "children": [
            {
              "tag": "li",
              "part": "item",
              "iterate": {
                "source": "transfer:available",
                "kind": "array",
                "itemType": "TransferListItem"
              },
              "attrs": {
                "role": "option"
              },
              "bindings": {
                "aria-selected": "iter:item.marked",
                "tabindex": "iter:item.tabIndex",
                "data-value": "iter:item.key"
              },
              "events": {
                "click": "transfer:toggle(iter:item)"
              },
              "children": [
                {
                  "tag": "span",
                  "content": "iter:item.label"
                }
              ]
            }
          ]
        },
        {
          "tag": "div",
          "part": "controls",
          "children": [
            {
              "tag": "button",
              "part": "add",
              "attrs": {
                "type": "button"
              },
              "bindings": {
                "disabled": "transfer:addDisabled"
              },
              "events": {
                "click": "transfer:add"
              },
              "content": "message:add"
            },
            {
              "tag": "button",
              "part": "remove",
              "attrs": {
                "type": "button"
              },
              "bindings": {
                "disabled": "transfer:removeDisabled"
              },
              "events": {
                "click": "transfer:remove"
              },
              "content": "message:remove"
            }
          ]
        },
        {
          "tag": "ul",
          "part": "list",
          "attrs": {
            "role": "listbox",
            "aria-multiselectable": "true",
            "data-side": "selected"
          },
          "bindings": {
            "aria-label": "message:selectedLabel"
          },
          "events": {
            "keydown": "transfer:keydown"
          },
          "children": [
            {
              "tag": "li",
              "part": "item",
              "iterate": {
                "source": "transfer:selected",
                "kind": "array",
                "itemType": "TransferListItem"
              },
              "attrs": {
                "role": "option"
              },
              "bindings": {
                "aria-selected": "iter:item.marked",
                "tabindex": "iter:item.tabIndex",
                "data-value": "iter:item.key"
              },
              "events": {
                "click": "transfer:toggle(iter:item)"
              },
              "children": [
                {
                  "tag": "span",
                  "content": "iter:item.label"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "props": {
    "designed": {
      "members": [
        {
          "name": "ariaLabel",
          "propType": { "kind": "string" },
          "description": "Accessible label for the shuttle widget"
        },
        {
          "name": "options",
          "propType": { "kind": "array", "items": { "kind": "string" } },
          "description": "Every candidate item id, in the order the available list shows them.",
          "default": ["alpha", "beta", "gamma", "delta", "epsilon"]
        },
        {
          "name": "value",
          "propType": { "kind": "array", "items": { "kind": "string" } },
          "description": "Controlled list of selected-item ids (items currently in the right-hand list), in the order they were moved there."
        },
        {
          "name": "defaultValue",
          "propType": { "kind": "array", "items": { "kind": "string" } },
          "description": "Uncontrolled initial selection: the ids that start in the selected list.",
          "default": []
        },
        {
          "name": "onValueChange",
          "propType": {
            "kind": "callback",
            "params": [{ "name": "value", "type": { "kind": "array", "items": { "kind": "string" } } }],
            "returns": { "kind": "void" }
          },
          "description": "Called when items move between the two lists; the new value reflects the right-hand list contents."
        }
      ]
    }
  },
  "channels": {
    "selection": {
      "value": "value",
      "defaultValue": "defaultValue",
      "onChange": "onValueChange",
      "valueType": "string[]",
      "description": "The set of item ids currently in the right-hand (selected) list. Changes as items are transferred between the two listboxes."
    }
  },
  "transfer": {
    "valueChannel": "selection",
    "optionsProp": "options"
  },
  "focus": {
    "strategy": "roving",
    "orientation": "vertical",
    "description": "Each list is one tab stop. Arrow keys, Home and End move focus within a list; Tab moves between the lists and the buttons."
  },
  "portal": {
    "enabled": false
  },
  "dismissal": {
    "triggers": []
  },
  "variants": {},
  "states": {
    "dimensions": {
      "pointer": {
        "category": "interaction",
        "values": [
          "default"
        ],
        "initial": "default",
        "exclusive": true
      },
      "mark": {
        "category": "selection",
        "effect": "restyle",
        "values": [
          "unmarked",
          "marked"
        ],
        "initial": "unmarked",
        "exclusive": true,
        "a11y": {
          "attribute": "aria-selected",
          "values": {
            "unmarked": "false",
            "marked": "true"
          }
        }
      }
    }
  },
  "slots": {},
  "ssr": {
    "hydrateOn": "interaction"
  },
  "rtl": {
    "flipIcon": false
  },
  "messages": {
    "availableLabel": {
      "defaultMessage": "Available",
      "description": "Accessible name of the list of items that can be added."
    },
    "selectedLabel": {
      "defaultMessage": "Selected",
      "description": "Accessible name of the list of items already added."
    },
    "add": {
      "defaultMessage": "Add",
      "description": "Button that moves the marked available items to the selected list."
    },
    "remove": {
      "defaultMessage": "Remove",
      "description": "Button that moves the marked selected items back to the available list."
    }
  },
  "a11y": {
    "role": "group",
    "apgPattern": "listbox",
    "labeling": [
      "aria-label",
      "aria-labelledby"
    ],
    "keyboard": [
      {
        "key": "ArrowUp|ArrowDown",
        "action": "Move focus to the previous or next item in the list",
        "when": "list"
      },
      {
        "key": "Home|End",
        "action": "Move focus to the first or last item in the list",
        "when": "list"
      },
      {
        "key": "Space",
        "action": "Mark or unmark the focused item for transfer",
        "when": "list"
      },
      {
        "key": "Enter",
        "action": "Move the marked items, or the focused item when none is marked, to the other list",
        "when": "list"
      }
    ]
  },
  "a2ui": {
    "category": "action",
    "usageHints": [
      "Use for permission assignment, column selection, or playlist management",
      "Support keyboard: arrow keys to move within a list, Space to mark, Enter or the buttons to transfer",
      "Pass every candidate id in options; the value is the selected list in the order items were added"
    ],
    "children": {
      "allowed": false
    }
  }
}
