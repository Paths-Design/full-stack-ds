{
  "box-model.padding-block-start": {
    "resolvesTo": "semantic.surface.size.padding-block",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-block-end": {
    "resolvesTo": "semantic.surface.size.padding-block",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-inline-start": {
    "resolvesTo": "semantic.surface.size.padding-inline",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-inline-end": {
    "resolvesTo": "semantic.surface.size.padding-inline",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.gap": {
    "resolvesTo": "semantic.surface.size.gap",
    "fallback": "8px",
    "layer": "semantic"
  },
  "box-model.min-width": {
    "resolvesTo": "semantic.surface.size.min-width",
    "fallback": "64px",
    "layer": "semantic"
  },
  "card.color.background.default": {
    "resolvesTo": "semantic.color.background.primary",
    "fallback": "#ffffff",
    "layer": "semantic"
  },
  "card.color.background.hover": {
    "resolvesTo": "semantic.color.background.hover",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  },
  "card.color.border": {
    "resolvesTo": "semantic.color.border.light",
    "fallback": "#b8b8b8",
    "layer": "semantic"
  },
  "card.color.foreground.primary": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "card.size.padding": {
    "resolvesTo": "core.spacing.size.06",
    "fallback": "16px",
    "layer": "core"
  },
  "card.size.padding.inset": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "card.size.radius": {
    "resolvesTo": "semantic.shape.radius.medium",
    "fallback": "8px",
    "layer": "semantic"
  },
  "card.size.gap": {
    "resolvesTo": "core.spacing.size.03",
    "fallback": "4px",
    "layer": "core"
  },
  "card.typography.lineHeight.heading": {
    "resolvesTo": "semantic.typography.line.height.heading",
    "fallback": "1",
    "layer": "semantic"
  },
  "card.typography.lineHeight.normal": {
    "resolvesTo": "semantic.typography.line.height.normal",
    "fallback": "1.5",
    "layer": "semantic"
  },
  "card.elevation.resting": {
    "resolvesTo": "semantic.elevation.surface.raised",
    "fallback": "0px 1px 2px #0000000f, 0px 1px 3px #0000001a",
    "layer": "semantic"
  },
  "card.elevation.raised": {
    "resolvesTo": "semantic.elevation.surface.floating",
    "fallback": "0px 2px 4px #0000000f, 0px 4px 8px #0000001a",
    "layer": "semantic"
  },
  "card.color.focus.ring": {
    "resolvesTo": "semantic.focus.ring.color",
    "fallback": "#0566fe",
    "layer": "semantic"
  },
  "card.focus.ring.width": {
    "resolvesTo": "semantic.focus.ring.width",
    "fallback": "2px",
    "layer": "semantic"
  },
  "card.focus.ring.offset": {
    "resolvesTo": "semantic.focus.ring.offset",
    "fallback": "2px",
    "layer": "semantic"
  }
}
