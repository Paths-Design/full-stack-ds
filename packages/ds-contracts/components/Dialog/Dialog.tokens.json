{
  "box-model.padding-block-start": {
    "resolvesTo": "semantic.surface.size.padding-block",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-block-end": {
    "resolvesTo": "semantic.surface.size.padding-block",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-inline-start": {
    "resolvesTo": "semantic.surface.size.padding-inline",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-inline-end": {
    "resolvesTo": "semantic.surface.size.padding-inline",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.gap": {
    "resolvesTo": "semantic.surface.size.gap",
    "fallback": "8px",
    "layer": "semantic"
  },
  "box-model.min-width": {
    "resolvesTo": "semantic.surface.size.min-width",
    "fallback": "64px",
    "layer": "semantic"
  },
  "dialog.color.background": {
    "resolvesTo": "semantic.color.background.primary",
    "fallback": "#ffffff",
    "layer": "semantic"
  },
  "dialog.color.foreground": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "dialog.color.border": {
    "resolvesTo": "semantic.color.border.subtle",
    "fallback": "#d0d0d0",
    "layer": "semantic"
  },
  "dialog.size.radius": {
    "resolvesTo": "semantic.shape.radius.large",
    "fallback": "16px",
    "layer": "semantic"
  },
  "dialog.size.sm.width": {
    "literal": "400px"
  },
  "dialog.size.sm.maxWidth": {
    "literal": "90vw"
  },
  "dialog.size.md.width": {
    "literal": "500px"
  },
  "dialog.size.md.maxWidth": {
    "literal": "90vw"
  },
  "dialog.size.lg.width": {
    "literal": "700px"
  },
  "dialog.size.lg.maxWidth": {
    "literal": "90vw"
  },
  "dialog.size.xl.width": {
    "literal": "900px"
  },
  "dialog.size.xl.maxWidth": {
    "literal": "95vw"
  },
  "dialog.size.full.width": {
    "literal": "100vw"
  },
  "dialog.size.full.height": {
    "literal": "100vh"
  },
  "dialog.size.closeButton.size": {
    "resolvesTo": "core.spacing.size.08",
    "fallback": "32px",
    "layer": "core"
  },
  "dialog.elevation": {
    "resolvesTo": "semantic.elevation.surface.dialog",
    "fallback": "0px 12px 16px #0000000f, 0px 25px 50px #00000026",
    "layer": "semantic"
  },
  "dialog.spacing.header.paddingTop": {
    "resolvesTo": "core.spacing.size.06",
    "fallback": "16px",
    "layer": "core"
  },
  "dialog.spacing.body.paddingRight": {
    "resolvesTo": "core.spacing.size.07",
    "fallback": "24px",
    "layer": "core"
  },
  "dialog.spacing.footer.gap": {
    "resolvesTo": "core.spacing.size.03",
    "fallback": "4px",
    "layer": "core"
  },
  "dialog.typography.title.fontSize": {
    "resolvesTo": "semantic.typography.heading.04",
    "fallback": "18px",
    "layer": "semantic"
  },
  "dialog.typography.title.fontWeight": {
    "resolvesTo": "semantic.typography.font.weight.bold",
    "fallback": "700",
    "layer": "semantic"
  },
  "dialog.typography.title.lineHeight": {
    "resolvesTo": "semantic.typography.line.height.heading",
    "fallback": "1",
    "layer": "semantic"
  }
}
