{
  "root": {
    "background-color": {
      "resolvesTo": "show-more.color.background",
      "fallback": "#f7f7f7",
      "design": {
        "property": "background.fill",
        "slot": "show-more.design.root.background.fill"
      }
    },
    "color": {
      "resolvesTo": "show-more.color.foreground.secondary",
      "fallback": "#474647",
      "design": {
        "property": "foreground.color",
        "slot": "show-more.design.root.foreground.color"
      }
    },
    "padding": {
      "resolvesTo": "show-more.size.padding",
      "fallback": "24px",
      "design": {
        "property": "spacing.padding",
        "slot": "show-more.design.root.spacing.padding"
      }
    },
    "border-radius": {
      "resolvesTo": "show-more.size.radius",
      "fallback": "6px",
      "design": {
        "property": "shape.radius",
        "slot": "show-more.design.root.shape.radius"
      }
    }
  },
  "content": {
    "overflow": {
      "literal": "hidden",
      "platforms": [
        "web"
      ]
    },
    "display": {
      "literal": "-webkit-box",
      "platforms": [
        "web"
      ]
    },
    "-webkit-box-orient": {
      "literal": "vertical",
      "platforms": [
        "web"
      ]
    },
    "-webkit-line-clamp": {
      "literal": "var(--fsds-show-more-content-max-lines, 3)",
      "platforms": [
        "web"
      ]
    },
    "line-clamp": {
      "literal": "var(--fsds-show-more-content-max-lines, 3)",
      "platforms": [
        "web"
      ]
    }
  },
  ".show-more--expanded .show-more__content": {
    "display": {
      "literal": "block",
      "platforms": [
        "web"
      ]
    },
    "-webkit-line-clamp": {
      "literal": "unset",
      "platforms": [
        "web"
      ]
    },
    "line-clamp": {
      "literal": "unset",
      "platforms": [
        "web"
      ]
    }
  },
  "trigger": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "color": {
      "resolvesTo": "show-more.color.foreground.primary",
      "fallback": "#141414",
      "design": {
        "property": "foreground.color",
        "slot": "show-more.design.trigger.foreground.color"
      }
    },
    "background": {
      "literal": "none",
      "platforms": [
        "web"
      ]
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ],
      "design": {
        "property": "border.style",
        "slot": "show-more.design.trigger.border.style"
      }
    },
    "border-width": {
      "literal": "1px",
      "platforms": [
        "web"
      ],
      "design": {
        "property": "border.width",
        "slot": "show-more.design.trigger.border.width"
      }
    },
    "border-color": {
      "resolvesTo": "show-more.color.border",
      "fallback": "#b8b8b8",
      "design": {
        "property": "border.color",
        "slot": "show-more.design.trigger.border.color"
      }
    },
    "padding": {
      "literal": "0",
      "platforms": [
        "web"
      ],
      "design": {
        "property": "spacing.padding",
        "slot": "show-more.design.trigger.spacing.padding"
      }
    },
    "cursor": {
      "literal": "pointer",
      "platforms": [
        "web"
      ]
    }
  }
}
