{
  "box-model.gap": {
    "resolvesTo": "semantic.display.size.gap",
    "fallback": "4px",
    "layer": "semantic"
  },
  "divider.color": {
    "resolvesTo": "semantic.color.border.light",
    "fallback": "#b8b8b8",
    "layer": "semantic"
  },
  "divider.size.thickness": {
    "resolvesTo": "semantic.shape.control.border.defaultWidth",
    "fallback": "1px",
    "layer": "semantic"
  },
  "divider.spacing.margin": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  }
}
