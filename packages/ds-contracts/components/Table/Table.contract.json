{
  "$schema": "../../component.contract.schema.json",
  "name": "Table",
  "description": "Data table with consumer-composed sections, rows, headers, and cells.",
  "layer": "compound",
  "category": "structure",
  "anatomy": {
    "parts": [
      "root",
      "container",
      "caption",
      "head",
      "body",
      "footer",
      "row",
      "headerCell",
      "cell"
    ],
    "details": {
      "root": {
        "tag": "div",
        "description": "Responsive wrapper around the table element."
      },
      "container": {
        "tag": "table",
        "description": "The native <table> element; carries the table's accessible label."
      },
      "caption": {
        "tag": "caption",
        "description": "Accessible caption rendered above the table body."
      },
      "head": {
        "tag": "thead",
        "description": "Group of header rows."
      },
      "body": {
        "tag": "tbody",
        "description": "Group of data rows."
      },
      "footer": {
        "tag": "tfoot",
        "description": "Group of footer/summary rows."
      },
      "row": {
        "tag": "tr",
        "multiple": true,
        "description": "Table row."
      },
      "headerCell": {
        "tag": "th",
        "multiple": true,
        "description": "Column or row header cell. scope is consumer-controlled; default header semantics infer from <thead>."
      },
      "cell": {
        "tag": "td",
        "multiple": true,
        "description": "Data cell."
      }
    },
    "dom": {
      "tag": "div",
      "part": "root",
      "attrs": {
        "role": "region"
      },
      "bindings": {
        "data-responsive": "conditional:prop:responsive|literal:true|literal:false",
        "tabindex": "conditional:prop:responsive|literal:0|literal:-1",
        "aria-label": "prop:contentLabel"
      },
      "children": [
        {
          "tag": "table",
          "part": "container",
          "bindings": {
            "aria-label": "prop:ariaLabel"
          },
          "children": [
            {
              "tag": "children"
            }
          ]
        }
      ]
    }
  },
  "messages": {
    "content": {
      "defaultMessage": "Table content",
      "description": "Accessible name of the region containing the table, including its scrollable viewport on the web."
    }
  },
  "props": {
    "styled": {
      "description": "Props for the <Table> component.",
      "members": [
        {
          "name": "responsive",
          "type": "boolean",
          "default": true,
          "description": "Enable a keyboard-focusable horizontal scrolling viewport on the web. Defaults to true; false allows content to overflow without a scrolling viewport."
        },
        {
          "name": "contentLabel",
          "type": "string",
          "defaultMessage": "content",
          "description": "Accessible name of the surrounding table content region. Defaults to the localized Table content message."
        },
        {
          "name": "ariaLabel",
          "type": "string",
          "description": "Accessible label for the table"
        }
      ]
    }
  },
  "variants": {},
  "states": {
    "dimensions": {
      "pointer": {
        "category": "interaction",
        "values": [
          "default",
          "hover"
        ],
        "initial": "default",
        "exclusive": true
      },
      "focus": {
        "category": "interaction",
        "values": [
          "unfocused",
          "focus"
        ],
        "initial": "unfocused",
        "exclusive": true
      },
      "selection": {
        "category": "selection",
        "effect": "restyle",
        "values": [
          "unselected",
          "selected"
        ],
        "initial": "unselected",
        "exclusive": true,
        "a11y": {
          "attribute": "aria-selected",
          "values": {
            "unselected": "false",
            "selected": "true"
          }
        }
      }
    }
  },
  "focus": {
    "strategy": "none",
    "description": "The table does not manage cell focus. Its responsive web viewport is in the standard tab order for native horizontal arrow-key scrolling. Interactive cells remain in the standard tab order."
  },
  "portal": {
    "enabled": false
  },
  "slots": {
    "body": {
      "required": false,
      "selector": "[data-slot=\"table-body\"]"
    },
    "caption": {
      "required": false,
      "selector": "[data-slot=\"table-caption\"]"
    },
    "cell": {
      "required": false,
      "selector": "[data-slot=\"table-cell\"]"
    },
    "container": {
      "required": false,
      "selector": "[data-slot=\"table-container\"]"
    },
    "element": {
      "required": false
    },
    "footer": {
      "required": false,
      "selector": "[data-slot=\"table-footer\"]"
    },
    "head": {
      "required": false,
      "selector": "[data-slot=\"table-head\"]"
    },
    "headerCell": {
      "required": false,
      "selector": "[data-slot=\"table-header-cell\"]"
    },
    "root": {
      "required": true,
      "selector": "[data-slot=\"table\"]"
    },
    "row": {
      "required": false,
      "selector": "[data-slot=\"table-row\"]"
    }
  },
  "ssr": {
    "hydrateOn": "interaction"
  },
  "rtl": {
    "flipIcon": false
  },
  "relationships": [
    {
      "from": "container",
      "to": "caption",
      "attribute": "aria-labelledby",
      "description": "When a caption is present, the table's accessible name is composed from the caption text by the user agent. Authors who supply ariaLabel override caption-derived naming."
    },
    {
      "from": "headerCell",
      "to": "cell",
      "attribute": "aria-sort",
      "description": "Authors supply aria-sort on the sorted column header. Cells use native scope and optional headers/id associations for complex headers."
    }
  ],
  "a11y": {
    "labeling": [
      "aria-sort",
      "aria-label",
      "aria-labelledby"
    ],
    "keyboard": [
      {
        "key": "Tab",
        "action": "Move focus between interactive column headers and rows"
      },
      {
        "key": "Space|Enter",
        "action": "Activate sort on focused column header"
      },
      {
        "key": "ArrowUp|ArrowDown",
        "action": "Navigate between rows",
        "when": "interactive row is focused"
      }
    ]
  },
  "a2ui": {
    "category": "display",
    "usageHints": [
      "Use for structured data that benefits from sorting or comparison across rows",
      "Enable row selection for bulk actions; pair with a toolbar for the action bar",
      "Keep column count to 6–8 max; use column visibility controls for wider datasets"
    ],
    "children": {
      "allowed": true,
      "slot": "children",
      "accepts": [
        "node-ref"
      ]
    }
  }
}
