{
  "box-model.gap": {
    "resolvesTo": "semantic.structure.size.gap",
    "fallback": "16px",
    "layer": "semantic"
  },
  "table.color.text": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "table.color.border": {
    "resolvesTo": "semantic.surface.border.subtle",
    "fallback": "#d0d0d0",
    "layer": "semantic"
  },
  "table.color.background.footer": {
    "resolvesTo": "semantic.color.background.secondary",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  },
  "table.border.width": {
    "resolvesTo": "semantic.shape.control.border.defaultWidth",
    "fallback": "1px",
    "layer": "semantic"
  },
  "table.spacing.cellX": {
    "resolvesTo": "core.spacing.size.03",
    "fallback": "4px",
    "layer": "core"
  },
  "table.spacing.cellY": {
    "resolvesTo": "core.spacing.size.02",
    "fallback": "2px",
    "layer": "core"
  },
  "table.spacing.caption": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "table.size.radius": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  },
  "table.text.size": {
    "resolvesTo": "semantic.typography.body.03",
    "fallback": "14px",
    "layer": "semantic"
  },
  "table.text.lineHeight": {
    "resolvesTo": "semantic.typography.line.height.normal",
    "fallback": "1.5",
    "layer": "semantic"
  },
  "table.text.sizeCaption": {
    "resolvesTo": "semantic.typography.body.04",
    "fallback": "12px",
    "layer": "semantic"
  },
  "table.text.weightHead": {
    "resolvesTo": "semantic.typography.font.weight.bold",
    "fallback": "700",
    "layer": "semantic"
  },
  "table.text.weightFooter": {
    "resolvesTo": "semantic.typography.font.weight.medium",
    "fallback": "500",
    "layer": "semantic"
  },
  "table.color.background.hover": {
    "resolvesTo": "semantic.interaction.background.hover",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  },
  "table.color.background.selected": {
    "resolvesTo": "semantic.color.background.accentSubtle",
    "fallback": "#95dafb",
    "layer": "semantic"
  }
}
