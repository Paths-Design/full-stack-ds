{
  "box-model.gap": {
    "resolvesTo": "semantic.structure.size.gap",
    "fallback": "16px",
    "layer": "semantic"
  },
  "breadcrumbs.color.foreground.primary": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "breadcrumbs.color.background.elevated": {
    "resolvesTo": "semantic.color.background.elevated",
    "fallback": "#ffffff",
    "layer": "semantic"
  },
  "breadcrumbs.color.border.subtle": {
    "resolvesTo": "semantic.color.border.subtle",
    "fallback": "#d0d0d0",
    "layer": "semantic"
  },
  "breadcrumbs.typography.lineHeight.collapse": {
    "resolvesTo": "semantic.typography.line.height.collapse",
    "fallback": "1",
    "layer": "semantic"
  },
  "breadcrumbs.shape.radius.medium": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  },
  "breadcrumbs.spacing.gap": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "breadcrumbs.spacing.padding": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "breadcrumbs.color.focus": {
    "resolvesTo": "semantic.focus.ring.color",
    "fallback": "#0566fe",
    "layer": "semantic"
  }
}
