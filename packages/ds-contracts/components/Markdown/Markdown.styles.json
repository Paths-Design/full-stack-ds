{
  "root": {
    "color": {
      "resolvesTo": "markdown.color.foreground",
      "fallback": "#141414",
      "design": {
        "property": "foreground.color",
        "slot": "markdown.design.root.foreground.color"
      }
    },
    "font-size": {
      "resolvesTo": "markdown.typography.fontSize",
      "fallback": "0.875rem",
      "design": {
        "property": "typography.size",
        "slot": "markdown.design.root.typography.size"
      }
    },
    "line-height": {
      "resolvesTo": "markdown.typography.lineHeight",
      "fallback": "1.5",
      "design": {
        "property": "typography.line-height",
        "slot": "markdown.design.root.typography.line-height"
      }
    }
  },
  "codeBlock": {
    "white-space": {
      "literal": "pre",
      "platforms": [
        "web"
      ]
    }
  }
}
