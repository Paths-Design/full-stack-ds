{
  "box-model.padding-block-start": {
    "literal": "0"
  },
  "box-model.padding-block-end": {
    "literal": "0"
  },
  "box-model.padding-inline-start": {
    "literal": "0"
  },
  "box-model.padding-inline-end": {
    "literal": "0"
  },
  "box-model.gap": {
    "resolvesTo": "semantic.input.size.medium.gap",
    "fallback": "8px",
    "layer": "semantic"
  },
  "box-model.min-height": {
    "literal": "0"
  },
  "field.gap.y": {
    "resolvesTo": "semantic.spacing.density.compact.sm",
    "fallback": "8px",
    "layer": "semantic"
  },
  "field.gap.meta": {
    "resolvesTo": "core.spacing.size.03",
    "fallback": "4px",
    "layer": "core"
  },
  "field.color.fg": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "field.color.invalid-text": {
    "resolvesTo": "semantic.color.foreground.danger",
    "fallback": "#d92d2e",
    "layer": "semantic"
  },
  "field.label.fontSize": {
    "resolvesTo": "semantic.typography.body.small.font.size",
    "fallback": "14px",
    "layer": "semantic"
  },
  "field.label.color": {
    "resolvesTo": "semantic.color.foreground.secondary",
    "fallback": "#474647",
    "layer": "semantic"
  }
}
