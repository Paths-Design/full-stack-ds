      }
    },
    "font-weight": {
      "resolvesTo": "status.text.weight",
      "fallback": "500",
      "design": {
        "property": "typography.weight",
        "slot": "status.design.root.typography.weight"
      }
    },
    "line-height": {
      "resolvesTo": "status.typography.lineHeight",
      "fallback": "1",
      "design": {
        "property": "typography.line-height",
        "slot": "status.design.root.typography.line-height"
      }
    }
