    "layer": "semantic"
  },
  "details.size.padding": {
    "resolvesTo": "core.spacing.size.06",
    "fallback": "16px",
    "layer": "core"
  },
  "details.size.radius": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  },
  "details.size.icon": {
