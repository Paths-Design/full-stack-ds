{
  "$schema": "../../component.contract.schema.json",
  "name": "Calendar",
  "description": "Interactive calendar grid for selecting a single date or a date range.",
  "layer": "composer",
  "category": "structure",
  "anatomy": {
    "parts": [
      "root",
      "header",
      "nav",
      "grid",
      "weekday",
      "cell",
      "day",
      "caption"
    ],
    "details": {
      "root": {
        "tag": "div",
        "description": "Interactive calendar surface that owns month navigation and date selection.",
        "role": "root",
        "aria": {
          "role": "application"
        }
      },
      "header": {
        "tag": "div",
        "description": "Header row containing month navigation controls and the current month caption.",
        "role": "group"
      },
      "nav": {
        "tag": "button",
        "description": "Previous/next month control.",
        "role": "trigger",
        "multiple": true,
        "interactive": true,
        "focusable": true,
        "aria": {
          "attributes": [
            "aria-label"
          ]
        }
      },
      "grid": {
        "tag": "table",
        "description": "Calendar date grid labeled for assistive technology.",
        "role": "group",
        "aria": {
          "role": "grid",
          "attributes": [
            "aria-label"
          ]
        }
      },
      "weekday": {
        "tag": "th",
        "description": "Column header naming one day of the week in the locale's order.",
        "role": "label",
        "multiple": true,
        "aria": {
          "role": "columnheader",
          "attributes": [
            "aria-label"
          ]
        }
      },
      "cell": {
        "tag": "td",
        "description": "Grid cell for one visible calendar day slot.",
        "role": "item",
        "multiple": true,
        "aria": {
          "role": "gridcell"
        }
      },
      "day": {
        "tag": "button",
        "description": "Selectable day button inside a calendar grid cell.",
        "role": "trigger",
        "multiple": true,
        "interactive": true,
        "focusable": true
      },
      "caption": {
        "tag": "span",
        "description": "Visible label for the currently displayed month or range.",
        "role": "label"
      }
    },
    "dom": {
      "tag": "div",
      "part": "root",
      "attrs": {
        "role": "application"
      },
      "children": [
        {
          "tag": "div",
          "part": "header",
          "children": [
            {
              "tag": "button",
              "part": "nav",
              "attrs": {
                "type": "button",
                "data-calendar-nav": "previous"
              },
              "bindings": {
                "aria-label": "message:previousMonth",
                "aria-disabled": "dateGrid:previousDisabled"
              },
              "events": {
                "click": "dateGrid:previous"
              },
              "children": [
                {
                  "tag": "span",
                  "attrs": {
                    "aria-hidden": "true"
                  },
                  "content": "literal:‹"
                }
              ]
            },
            {
              "tag": "span",
              "part": "caption",
              "attrs": {
                "aria-live": "polite"
              },
              "content": "dateGrid:caption"
            },
            {
              "tag": "button",
              "part": "nav",
              "attrs": {
                "type": "button",
                "data-calendar-nav": "next"
              },
              "bindings": {
                "aria-label": "message:nextMonth",
                "aria-disabled": "dateGrid:nextDisabled"
              },
              "events": {
                "click": "dateGrid:next"
              },
              "children": [
                {
                  "tag": "span",
                  "attrs": {
                    "aria-hidden": "true"
                  },
                  "content": "literal:›"
                }
              ]
            }
          ]
        },
        {
          "tag": "table",
          "part": "grid",
          "attrs": {
            "role": "grid"
          },
          "bindings": {
            "aria-label": "dateGrid:caption"
          },
          "events": {
            "keydown": "dateGrid:keydown"
          },
          "children": [
            {
              "tag": "thead",
              "children": [
                {
                  "tag": "tr",
                  "attrs": {
                    "role": "row"
                  },
                  "children": [
                    {
                      "tag": "th",
                      "part": "weekday",
                      "iterate": {
                        "source": "dateGrid:weekdays",
                        "kind": "array",
                        "itemType": "DateGridWeekday"
                      },
                      "attrs": {
                        "role": "columnheader",
                        "scope": "col"
                      },
                      "bindings": {
                        "aria-label": "iter:item.long"
                      },
                      "children": [
                        {
                          "tag": "span",
                          "content": "iter:item.short"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tag": "tbody",
              "children": [
                {
                  "tag": "tr",
                  "iterate": {
                    "source": "dateGrid:weeks",
                    "kind": "array",
                    "itemType": "DateGridWeek",
                    "itemVar": "week",
                    "indexVar": "row"
                  },
                  "attrs": {
                    "role": "row"
                  },
                  "children": [
                    {
                      "tag": "td",
                      "part": "cell",
                      "iterate": {
                        "source": "iter:item.days",
                        "kind": "array",
                        "itemType": "DateGridDay",
                        "itemVar": "day",
                        "indexVar": "column"
                      },
                      "attrs": {
                        "role": "gridcell"
                      },
                      "bindings": {
                        "aria-selected": "iter:item.selected",
                        "aria-current": "iter:item.current",
                        "data-outside-month": "iter:item.outsideMonth"
                      },
                      "children": [
                        {
                          "tag": "button",
                          "part": "day",
                          "attrs": {
                            "type": "button"
                          },
                          "bindings": {
                            "tabindex": "iter:item.tabIndex",
                            "aria-label": "iter:item.fullLabel",
                            "aria-disabled": "iter:item.disabled",
                            "data-date": "iter:item.key"
                          },
                          "events": {
                            "click": "dateGrid:select(iter:item)"
                          },
                          "content": "iter:item.label"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "dateGrid": {
    "valueChannel": "value",
    "monthChannel": "month",
    "modeProp": "mode",
    "localeProp": "locale",
    "minProp": "minDate",
    "maxProp": "maxDate",
    "disabledProp": "disabled",
    "captionProp": "caption"
  },
  "messages": {
    "previousMonth": {
      "defaultMessage": "Previous month",
      "description": "Accessible name of the button that shows the previous month."
    },
    "nextMonth": {
      "defaultMessage": "Next month",
      "description": "Accessible name of the button that shows the next month."
    }
  },
  "props": {
    "designed": {
      "members": [
        {
          "name": "caption",
          "propType": { "kind": "string" },
          "description": "Caption rendered above the day grid and naming it. Absent, the visible month and year are formatted in the locale."
        },
        {
          "name": "month",
          "propType": { "kind": "ref", "to": "Date" },
          "description": "Controlled visible month: any date inside the month the grid shows."
        },
        {
          "name": "defaultMonth",
          "propType": { "kind": "ref", "to": "Date" },
          "description": "Uncontrolled initial visible month. Absent, the grid shows the selected date's month, else the current month."
        },
        {
          "name": "onMonthChange",
          "propType": {
            "kind": "callback",
            "params": [
              { "name": "month", "type": { "kind": "ref", "to": "Date" } }
            ],
            "returns": { "kind": "void" }
          },
          "description": "Called with the first day of the newly visible month when the month controls, a keyboard move or an adjacent-month day change it."
        },
        {
          "name": "value",
          "propType": {
            "kind": "union",
            "of": [
              { "kind": "ref", "to": "Date" },
              { "kind": "array", "items": { "kind": "ref", "to": "Date" } },
              { "kind": "literal", "value": null }
            ]
          },
          "description": "Controlled selected date or range."
        },
        {
          "name": "defaultValue",
          "propType": {
            "kind": "union",
            "of": [
              { "kind": "ref", "to": "Date" },
              { "kind": "array", "items": { "kind": "ref", "to": "Date" } },
              { "kind": "literal", "value": null }
            ]
          },
          "description": "Uncontrolled initial selected date or range."
        },
        {
          "name": "onChange",
          "propType": {
            "kind": "callback",
            "params": [
              {
                "name": "value",
                "type": {
                  "kind": "union",
                  "of": [
                    { "kind": "ref", "to": "Date" },
                    { "kind": "array", "items": { "kind": "ref", "to": "Date" } },
                    { "kind": "literal", "value": null }
                  ]
                }
              }
            ],
            "returns": { "kind": "void" }
          },
          "description": "Called when the selected date changes."
        },
        {
          "name": "mode",
          "propType": { "kind": "ref", "to": "CalendarMode" },
          "description": "Selection mode: single date or date range.",
          "default": "single"
        },
        {
          "name": "disabled",
          "propType": { "kind": "boolean" },
          "description": "Disables all interaction."
        },
        {
          "name": "minDate",
          "propType": { "kind": "ref", "to": "Date" },
          "description": "Earliest selectable date."
        },
        {
          "name": "maxDate",
          "propType": { "kind": "ref", "to": "Date" },
          "description": "Latest selectable date."
        },
        {
          "name": "locale",
          "translatable": false,
          "propType": { "kind": "string" },
          "description": "BCP 47 locale tag for date formatting.",
          "default": "en-US"
        },
        {
          "name": "shouldCloseOnSelect",
          "propType": { "kind": "boolean" },
          "description": "When true, selecting a date closes the popup. Wired to behavior.dismissalTriggers.select.enabledBy.",
          "default": true
        }
      ]
    }
  },
  "channels": {
    "value": {
      "description": "Selected date (single mode) or [start, end] range (range mode).",
      "value": "value",
      "defaultValue": "defaultValue",
      "onChange": "onChange",
      "valueType": "Date | Date[] | null"
    },
    "month": {
      "description": "Visible month. The date-grid runtime derives the six-week grid from it.",
      "value": "month",
      "defaultValue": "defaultMonth",
      "onChange": "onMonthChange",
      "valueType": "Date"
    }
  },
  "types": {
    "CalendarMode": {
      "kind": "union",
      "values": [
        "single",
        "range"
      ]
    }
  },
  "variants": {
    "mode": [
      "single",
      "range"
    ]
  },
  "states": {
    "dimensions": {
      "pointer": {
        "category": "interaction",
        "values": [
          "default",
          "hover"
        ],
        "initial": "default",
        "exclusive": true
      },
      "focus": {
        "category": "interaction",
        "values": [
          "unfocused",
          "focus"
        ],
        "initial": "unfocused",
        "exclusive": true
      },
      "availability": {
        "category": "availability",
        "effect": "restyle",
        "values": [
          "enabled",
          "disabled"
        ],
        "initial": "enabled",
        "exclusive": true,
        "suppresses": {
          "categories": [
            "interaction"
          ]
        }
      },
      "selection": {
        "category": "selection",
        "effect": "restyle",
        "values": [
          "unselected",
          "selected"
        ],
        "initial": "unselected",
        "exclusive": true,
        "a11y": {
          "attribute": "aria-selected",
          "values": {
            "unselected": "false",
            "selected": "true"
          }
        }
      },
      "today": {
        "category": "presentation",
        "effect": "overlay",
        "values": [
          "other",
          "today"
        ],
        "initial": "other",
        "exclusive": true
      },
      "month": {
        "category": "presentation",
        "effect": "restyle",
        "values": [
          "inMonth",
          "outsideMonth"
        ],
        "initial": "inMonth",
        "exclusive": true
      }
    }
  },
  "form": {
    "participates": true,
    "inputType": "date",
    "name": {
      "prop": "name"
    },
    "serialization": {
      "valueType": "string",
      "valueSource": "channel:selection",
      "omitWhen": "empty"
    },
    "validity": {
      "model": "props",
      "ariaAttributes": [
        "aria-invalid",
        "aria-required"
      ]
    },
    "labeling": {
      "strategy": "associated-label",
      "required": true,
      "via": [
        "aria-labelledby",
        "aria-label",
        "wrapping:FormField"
      ]
    }
  },
  "motion": {
    "reducedMotion": "respect",
    "transitions": [
      {
        "name": "open",
        "trigger": "openness=collapsed→expanded",
        "phase": "enter",
        "properties": [
          "opacity",
          "transform"
        ],
        "duration": "calendar.motion.duration",
        "easing": "calendar.motion.easing"
      },
      {
        "name": "close",
        "trigger": "openness=expanded→collapsed",
        "phase": "exit",
        "properties": [
          "opacity",
          "transform"
        ],
        "duration": "calendar.motion.duration",
        "easing": "calendar.motion.easing"
      }
    ]
  },
  "focus": {
    "strategy": "roving",
    "orientation": "both",
    "initialFocus": "today",
    "wrap": false,
    "description": "Exactly one day is a tab stop: the focused day, else the selected day, else today, else the first enabled day of the visible month. Arrow keys, Home/End and PageUp/PageDown move it, changing the month at its edges; Tab moves to the month controls."
  },
  "dismissal": {
    "triggers": [
      {
        "event": "escape",
        "defaultEnabled": true,
        "description": "Closes the calendar popup and returns focus to the input."
      },
      {
        "event": "outsideClick",
        "defaultEnabled": true
      },
      {
        "event": "selection",
        "enabledBy": "shouldCloseOnSelect",
        "defaultEnabled": true,
        "description": "Selecting a date closes the popup (controlled by shouldCloseOnSelect)."
      }
    ]
  },
  "slots": {
    "root": {
      "required": true,
      "selector": "[data-slot=\"calendar\"]"
    }
  },
  "ssr": {
    "hydrateOn": "interaction"
  },
  "rtl": {
    "flipIcon": false
  },
  "relationships": [],
  "a11y": {
    "role": "application",
    "apgPattern": null,
    "labeling": [
      "aria-label",
      "aria-labelledby"
    ],
    "keyboard": [
      {
        "key": "ArrowLeft",
        "action": "Move focus to the previous day."
      },
      {
        "key": "ArrowRight",
        "action": "Move focus to the next day."
      },
      {
        "key": "ArrowUp",
        "action": "Move focus to the same day in the previous week."
      },
      {
        "key": "ArrowDown",
        "action": "Move focus to the same day in the next week."
      },
      {
        "key": "PageUp",
        "action": "Move focus to the same day in the previous month (with Shift, the previous year)."
      },
      {
        "key": "PageDown",
        "action": "Move focus to the same day in the next month (with Shift, the next year)."
      },
      {
        "key": "Home",
        "action": "Move focus to the first day of the current week."
      },
      {
        "key": "End",
        "action": "Move focus to the last day of the current week."
      },
      {
        "key": "Enter|Space",
        "action": "Select the focused date."
      }
    ]
  },
  "a2ui": {
    "category": "form-field",
    "usageHints": [
      "Use for explicit date picking; combine with a text input for manual entry",
      "For date ranges, configure mode=\"range\" and supply an array value",
      "Pair with a DatePicker trigger for inline-vs-popup flexibility"
    ],
    "children": {
      "allowed": false
    }
  }
}
