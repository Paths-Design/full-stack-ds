{
  "$schema": "../../component.contract.schema.json",
  "name": "OTP",
  "description": "One-time password input composed of individual single-character digit fields.",
  "layer": "composer",
  "category": "input",
  "anatomy": {
    "parts": [
      "root",
      "group",
      "field"
    ],
    "details": {
      "root": {
        "tag": "div",
        "description": "Labeled one-time-password input group that coordinates the assembled value.",
        "role": "group",
        "aria": {
          "role": "group",
          "attributes": [
            "aria-label",
            "aria-describedby"
          ]
        }
      },
      "group": {
        "tag": "div",
        "description": "Layout group containing the individual single-character input fields.",
        "role": "group"
      },
      "field": {
        "tag": "input",
        "description": "Single-character input cell for one position in the OTP value.",
        "role": "item",
        "multiple": true,
        "interactive": true,
        "focusable": true,
        "aria": {
          "attributes": [
            "aria-label",
            "aria-readonly"
          ]
        }
      }
    },
    "dom": {
      "tag": "div",
      "part": "root",
      "attrs": {
        "role": "group"
      },
      "bindings": {
        "aria-label": "prop:label",
        "aria-describedby": "prop:ariaDescribedby"
      },
      "children": [
        {
          "tag": "div",
          "part": "group",
          "children": [
            {
              "tag": "input",
              "part": "field",
              "iterate": {
                "source": "prop:length",
                "kind": "count"
              },
              "attrs": {
                "type": "text",
                "inputmode": "numeric",
                "autocomplete": "one-time-code",
                "maxlength": "1"
              },
              "bindings": {
                "disabled": "prop:disabled",
                "aria-label": "prop:fieldLabel",
                "aria-readonly": "prop:readOnly",
                "data-otp-index": "iter:index"
              }
            }
          ]
        }
      ]
    }
  },
  "compositeControl": {
    "part": "field",
    "channel": "value",
    "interactionModel": "segmented-text",
    "commit": "input",
    "update": "channel:value.onChange:setCharAt(iter:index)"
  },
  "messages": {
    "groupLabel": {
      "defaultMessage": "One-time password",
      "description": "Accessible name of the group of code fields."
    },
    "fieldLabel": {
      "defaultMessage": "One-time password digit",
      "description": "Accessible name of each code field."
    }
  },
  "props": {
    "designed": {
      "members": [
        {
          "name": "length",
          "propType": { "kind": "number" },
          "description": "Number of individual input fields to render.",
          "default": 6
        },
        {
          "name": "value",
          "propType": { "kind": "string" },
          "description": "Controlled OTP value string."
        },
        {
          "name": "defaultValue",
          "propType": { "kind": "string" },
          "description": "Uncontrolled initial OTP value."
        },
        {
          "name": "onChange",
          "propType": {
            "kind": "callback",
            "params": [{ "name": "value", "type": { "kind": "string" } }],
            "returns": { "kind": "void" }
          },
          "description": "Called when the OTP value changes."
        },
        {
          "name": "onComplete",
          "propType": {
            "kind": "callback",
            "params": [{ "name": "value", "type": { "kind": "string" } }],
            "returns": { "kind": "void" }
          },
          "description": "Called when all fields are filled."
        },
        {
          "name": "mode",
          "propType": { "kind": "ref", "to": "OTPMode" },
          "description": "Whether fields accept only digits or any alphanumeric character.",
          "default": "numeric"
        },
        {
          "name": "disabled",
          "propType": { "kind": "boolean" },
          "description": "Disables all input fields."
        },
        {
          "name": "readOnly",
          "propType": { "kind": "boolean" },
          "description": "Makes all fields read-only."
        },
        {
          "name": "label",
          "propType": { "kind": "string" },
          "description": "Accessible label for the OTP group.",
          "defaultMessage": "groupLabel"
        },
        {
          "name": "fieldLabel",
          "propType": { "kind": "string" },
          "description": "Accessible label applied to each one-character OTP field.",
          "defaultMessage": "fieldLabel"
        },
        {
          "name": "ariaDescribedby",
          "propType": { "kind": "string" },
          "description": "External description element id for the OTP group."
        }
      ]
    }
  },
  "channels": {
    "value": {
      "description": "The full OTP string assembled from individual digit inputs.",
      "value": "value",
      "defaultValue": "defaultValue",
      "onChange": "onChange",
      "valueType": "string"
    }
  },
  "types": {
    "OTPMode": {
      "kind": "union",
      "values": [
        "numeric",
        "alphanumeric"
      ]
    }
  },
  "variants": {
    "mode": [
      "numeric",
      "alphanumeric"
    ]
  },
  "states": {
    "dimensions": {
      "pointer": {
        "category": "interaction",
        "values": [
          "default"
        ],
        "initial": "default",
        "exclusive": true
      },
      "focus": {
        "category": "interaction",
        "values": [
          "unfocused",
          "focus"
        ],
        "initial": "unfocused",
        "exclusive": true
      },
      "availability": {
        "category": "availability",
        "effect": "restyle",
        "values": [
          "enabled",
          "disabled"
        ],
        "initial": "enabled",
        "exclusive": true,
        "suppresses": {
          "categories": [
            "interaction"
          ]
        }
      }
    }
  },
  "form": {
    "participates": true,
    "inputType": "text",
    "serialization": {
      "valueType": "string",
      "valueSource": "channel:value"
    },
    "validity": {
      "model": "native",
      "errorSurface": "aria-describedby"
    }
  },
  "focus": {
    "strategy": "manual",
    "orientation": "horizontal",
    "initialFocus": "field",
    "wrap": false,
    "description": "Focus moves automatically to the next OTPField after a digit is entered, and to the previous field on Backspace. Arrow keys can also navigate between fields."
  },
  "slots": {
    "root": {
      "required": true,
      "selector": "[data-slot=\"otp\"]"
    },
    "group": {
      "required": false,
      "selector": "[data-slot=\"otp-group\"]"
    },
    "field": {
      "required": true,
      "selector": "[data-slot=\"otp-field\"]"
    }
  },
  "ssr": {
    "hydrateOn": "interaction"
  },
  "rtl": {
    "flipIcon": false
  },
  "relationships": [],
  "a11y": {
    "role": "group",
    "apgPattern": "spinbutton",
    "labeling": [
      "aria-label",
      "aria-describedby",
      "aria-readonly"
    ],
    "keyboard": [
      {
        "key": "0-9",
        "action": "Enter a digit and advance focus to the next field.",
        "when": "field"
      },
      {
        "key": "Backspace",
        "action": "Clear the current field and move focus to the previous field.",
        "when": "field"
      },
      {
        "key": "ArrowLeft",
        "action": "Move focus to the previous OTP field.",
        "when": "field"
      },
      {
        "key": "ArrowRight",
        "action": "Move focus to the next OTP field.",
        "when": "field"
      }
    ]
  },
  "a2ui": {
    "category": "form-field",
    "usageHints": [
      "Set length to control the number of digit fields",
      "Focus advances automatically after each digit is entered",
      "Compose with OTPLabel for the field label and OTPError for validation feedback",
      "Use OTPSeparator between fields for visual grouping (e.g., 3+3 pattern)"
    ],
    "children": {
      "allowed": true,
      "slot": "children",
      "accepts": [
        "OTPInput",
        "OTPLabel",
        "OTPError",
        "OTPSeparator"
      ]
    }
  }
}
