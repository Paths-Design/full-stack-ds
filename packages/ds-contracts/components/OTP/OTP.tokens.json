{
  "box-model.padding-block-start": {
    "resolvesTo": "semantic.input.size.medium.padding-block",
    "fallback": "4px",
    "layer": "semantic"
  },
  "box-model.padding-block-end": {
    "resolvesTo": "semantic.input.size.medium.padding-block",
    "fallback": "4px",
    "layer": "semantic"
  },
  "box-model.padding-inline-start": {
    "resolvesTo": "semantic.input.size.medium.padding-inline",
    "fallback": "8px",
    "layer": "semantic"
  },
  "box-model.padding-inline-end": {
    "resolvesTo": "semantic.input.size.medium.padding-inline",
    "fallback": "8px",
    "layer": "semantic"
  },
  "box-model.gap": {
    "resolvesTo": "semantic.input.size.medium.gap",
    "fallback": "8px",
    "layer": "semantic"
  },
  "box-model.min-height": {
    "resolvesTo": "semantic.input.size.medium.min-height",
    "fallback": "32px",
    "layer": "semantic"
  },
  "otp.color.background": {
    "resolvesTo": "semantic.color.background.secondary",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  },
  "otp.color.foreground.primary": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "otp.color.border": {
    "resolvesTo": "semantic.color.border.light",
    "fallback": "#b8b8b8",
    "layer": "semantic"
  },
  "otp.size.radius": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  },
  "otp.color.border.accent": {
    "resolvesTo": "semantic.color.border.accent",
    "fallback": "#d92d2e",
    "layer": "semantic"
  },
  "otp.focus.ring.width": {
    "resolvesTo": "semantic.focus.ring.width",
    "fallback": "2px",
    "layer": "semantic"
  },
  "otp.focus.ring.color": {
    "resolvesTo": "semantic.focus.ring.color",
    "fallback": "#0566fe",
    "layer": "semantic"
  },
  "otp.focus.ring.style": {
    "resolvesTo": "semantic.focus.ring.style",
    "fallback": "solid",
    "layer": "semantic"
  },
  "otp.focus.ring.offset": {
    "resolvesTo": "semantic.focus.ring.offset",
    "fallback": "2px",
    "layer": "semantic"
  }
}
