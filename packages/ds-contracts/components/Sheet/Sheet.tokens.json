{
  "box-model.padding-block-start": {
    "resolvesTo": "semantic.surface.size.padding-block",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-block-end": {
    "resolvesTo": "semantic.surface.size.padding-block",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-inline-start": {
    "resolvesTo": "semantic.surface.size.padding-inline",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-inline-end": {
    "resolvesTo": "semantic.surface.size.padding-inline",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.gap": {
    "resolvesTo": "semantic.surface.size.gap",
    "fallback": "8px",
    "layer": "semantic"
  },
  "box-model.min-width": {
    "resolvesTo": "semantic.surface.size.min-width",
    "fallback": "64px",
    "layer": "semantic"
  },
  "sheet.color.overlay": {
    "resolvesTo": "semantic.overlay.scrim.medium",
    "fallback": "rgba(0,0,0,0.40)",
    "layer": "semantic"
  },
  "sheet.color.background": {
    "resolvesTo": "semantic.color.background.primary",
    "fallback": "#ffffff",
    "layer": "semantic"
  },
  "sheet.color.border": {
    "resolvesTo": "semantic.surface.border.subtle",
    "fallback": "#d0d0d0",
    "layer": "semantic"
  },
  "sheet.color.text": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "sheet.color.textTitle": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "sheet.color.textDescription": {
    "resolvesTo": "semantic.color.foreground.secondary",
    "fallback": "#474647",
    "layer": "semantic"
  },
  "sheet.border.width": {
    "resolvesTo": "semantic.shape.control.border.defaultWidth",
    "fallback": "1px",
    "layer": "semantic"
  },
  "sheet.border.radius": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  },
  "sheet.size.width": {
    "literal": "400px"
  },
  "sheet.size.height": {
    "literal": "300px"
  },
  "sheet.size.close": {
    "resolvesTo": "core.spacing.size.06",
    "fallback": "16px",
    "layer": "core"
  },
  "sheet.spacing.padding": {
    "resolvesTo": "core.spacing.size.06",
    "fallback": "16px",
    "layer": "core"
  },
  "sheet.spacing.gap": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "sheet.text.size": {
    "resolvesTo": "semantic.typography.body.02",
    "fallback": "16px",
    "layer": "semantic"
  },
  "sheet.text.sizeTitle": {
    "resolvesTo": "semantic.typography.heading.06",
    "fallback": "14px",
    "layer": "semantic"
  },
  "sheet.text.weightTitle": {
    "resolvesTo": "semantic.typography.font.weight.medium",
    "fallback": "500",
    "layer": "semantic"
  },
  "sheet.shadow": {
    "resolvesTo": "semantic.elevation.surface.floating",
    "fallback": "0px 2px 4px #0000000f, 0px 4px 8px #0000001a",
    "layer": "semantic"
  }
}
