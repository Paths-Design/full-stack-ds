{
  "root": {
    "position": {
      "literal": "relative",
      "platforms": [
        "web",
        "ios",
        "android"
      ]
    },
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web"
      ]
    }
  },
  "trigger": {
    "display": {
      "literal": "inline-flex",
      "platforms": [
        "web"
      ]
    },
    "align-items": {
      "literal": "center",
      "platforms": [
        "web"
      ]
    },
    "cursor": {
      "literal": "pointer",
      "platforms": [
        "web"
      ]
    }
  },
  "content": {
    "min-width": {
      "literal": "256px",
      "platforms": [
        "web"
      ]
    },
    "max-width": {
      "literal": "calc(100vw - 16px)",
      "platforms": [
        "web"
      ]
    },
    "contain": {
      "literal": "layout paint style",
      "platforms": [
        "web"
      ]
    },
    "animation": {
      "literal": "popover-enter var(--fsds-core-motion-duration-short, 150ms) var(--fsds-core-motion-easing-emphasized-out, cubic-bezier(0.4, 0, 0.2, 1)) forwards",
      "platforms": [
        "web"
      ]
    },
    "background-color": {
      "resolvesTo": "popover.color.background.content",
      "fallback": "#ffffff",
      "design": {
        "property": "background.fill",
        "slot": "popover.design.content.background.fill"
      }
    },
    "border-color": {
      "resolvesTo": "popover.color.border",
      "fallback": "#d0d0d0",
      "design": {
        "property": "border.color",
        "slot": "popover.design.content.border.color"
      }
    },
    "border-radius": {
      "resolvesTo": "popover.size.radius",
      "fallback": "6px",
      "design": {
        "property": "shape.radius",
        "slot": "popover.design.content.shape.radius"
      }
    },
    "padding": {
      "resolvesTo": "popover.size.padding",
      "fallback": "16px",
      "design": {
        "property": "spacing.padding",
        "slot": "popover.design.content.spacing.padding"
      }
    },
    "gap": {
      "resolvesTo": "popover.size.gap",
      "fallback": "8px",
      "design": {
        "property": "spacing.gap",
        "slot": "popover.design.content.spacing.gap"
      }
    },
    "box-shadow": {
      "resolvesTo": "popover.elevation",
      "fallback": "0px 8px 10px #0000000a, 0px 20px 25px #0000001a",
      "design": {
        "property": "elevation.shadow",
        "slot": "popover.design.content.elevation.shadow"
      }
    },
    "z-index": {
      "resolvesTo": "popover.layer.content",
      "fallback": "1000"
    },
    "display": {
      "literal": "inline-block",
      "platforms": [
        "web"
      ]
    },
    "border-style": {
      "literal": "solid",
      "platforms": [
        "web"
      ],
      "design": {
        "property": "border.style",
        "slot": "popover.design.content.border.style"
      }
    },
    "border-width": {
      "literal": "1px",
      "platforms": [
        "web"
      ],
      "design": {
        "property": "border.width",
        "slot": "popover.design.content.border.width"
      }
    }
  }
}
