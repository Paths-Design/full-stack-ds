{
  "box-model.padding-block-start": {
    "resolvesTo": "semantic.surface.size.padding-block",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-block-end": {
    "resolvesTo": "semantic.surface.size.padding-block",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-inline-start": {
    "resolvesTo": "semantic.surface.size.padding-inline",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.padding-inline-end": {
    "resolvesTo": "semantic.surface.size.padding-inline",
    "fallback": "16px",
    "layer": "semantic"
  },
  "box-model.gap": {
    "resolvesTo": "semantic.surface.size.gap",
    "fallback": "8px",
    "layer": "semantic"
  },
  "box-model.min-width": {
    "resolvesTo": "semantic.surface.size.min-width",
    "fallback": "64px",
    "layer": "semantic"
  },
  "popover.size.padding": {
    "resolvesTo": "core.spacing.size.06",
    "fallback": "16px",
    "layer": "core"
  },
  "popover.size.radius": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  },
  "popover.size.gap": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "popover.color.background.content": {
    "resolvesTo": "semantic.color.background.elevated",
    "fallback": "#ffffff",
    "layer": "semantic"
  },
  "popover.color.border": {
    "resolvesTo": "semantic.color.border.subtle",
    "fallback": "#d0d0d0",
    "layer": "semantic"
  },
  "popover.elevation": {
    "resolvesTo": "semantic.elevation.surface.popover",
    "fallback": "0px 8px 10px #0000000a, 0px 20px 25px #0000001a",
    "layer": "semantic"
  },
  "popover.layer.content": {
    "resolvesTo": "core.layer.dropdown",
    "fallback": "1000",
    "layer": "core"
  }
}
