{
  "avatar.size": {
    "resolvesTo": "core.spacing.size.06",
    "fallback": "16px",
    "layer": "core"
  },
  "avatar.size.small": {
    "resolvesTo": "core.spacing.size.06",
    "fallback": "16px",
    "layer": "core"
  },
  "avatar.size.medium": {
    "resolvesTo": "core.spacing.size.07",
    "fallback": "24px",
    "layer": "core"
  },
  "avatar.size.large": {
    "resolvesTo": "core.spacing.size.08",
    "fallback": "32px",
    "layer": "core"
  },
  "avatar.size.extra-large": {
    "resolvesTo": "core.spacing.size.09",
    "fallback": "48px",
    "layer": "core"
  },
  "avatar.size.radius": {
    "resolvesTo": "semantic.shape.control.radius.pill",
    "fallback": "9999px",
    "layer": "semantic"
  },
  "avatar.size.border": {
    "resolvesTo": "semantic.shape.control.border.defaultWidth",
    "fallback": "1px",
    "layer": "semantic"
  },
  "avatar.color.background": {
    "resolvesTo": "semantic.color.background.secondary",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  },
  "avatar.color.foreground.primary": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "avatar.color.border": {
    "resolvesTo": "semantic.color.border.light",
    "fallback": "#b8b8b8",
    "layer": "semantic"
  },
  "avatar.typography.fontWeight.medium": {
    "resolvesTo": "core.typography.weight.medium",
    "fallback": "500",
    "layer": "core"
  },
  "avatar.typography.fontFamily.sans": {
    "resolvesTo": "core.typography.font.family.sans",
    "fallback": "\"Inter\", sans-serif",
    "layer": "core"
  }
}
