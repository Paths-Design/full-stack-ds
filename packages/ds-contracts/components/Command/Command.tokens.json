{
  "box-model.gap": {
    "resolvesTo": "semantic.structure.size.gap",
    "fallback": "16px",
    "layer": "semantic"
  },
  "command.color.overlay": {
    "resolvesTo": "semantic.overlay.scrim.strong",
    "fallback": "rgba(0,0,0,0.64)",
    "layer": "semantic"
  },
  "command.color.background": {
    "resolvesTo": "semantic.color.background.primary",
    "fallback": "#ffffff",
    "layer": "semantic"
  },
  "command.color.border": {
    "resolvesTo": "semantic.surface.border.subtle",
    "fallback": "#d0d0d0",
    "layer": "semantic"
  },
  "command.color.borderLight": {
    "resolvesTo": "semantic.color.border.subtle",
    "fallback": "#d0d0d0",
    "layer": "semantic"
  },
  "command.color.text": {
    "resolvesTo": "semantic.color.foreground.primary",
    "fallback": "#141414",
    "layer": "semantic"
  },
  "command.color.textMuted": {
    "resolvesTo": "semantic.color.foreground.tertiary",
    "fallback": "#727272",
    "layer": "semantic"
  },
  "command.border.width": {
    "resolvesTo": "semantic.shape.control.border.defaultWidth",
    "fallback": "1px",
    "layer": "semantic"
  },
  "command.border.radius": {
    "resolvesTo": "semantic.shape.control.radius.default",
    "fallback": "6px",
    "layer": "semantic"
  },
  "command.size.maxWidth": {
    "literal": "640px"
  },
  "command.size.maxHeight": {
    "literal": "400px"
  },
  "command.size.topOffset": {
    "literal": "10vh"
  },
  "command.size.icon": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "command.spacing.dialogPadding": {
    "resolvesTo": "core.spacing.size.04",
    "fallback": "8px",
    "layer": "core"
  },
  "command.text.size": {
    "resolvesTo": "semantic.typography.body.02",
    "fallback": "16px",
    "layer": "semantic"
  },
  "command.text.sizeSmall": {
    "resolvesTo": "semantic.typography.body.04",
    "fallback": "12px",
    "layer": "semantic"
  },
  "command.shadow": {
    "resolvesTo": "semantic.elevation.surface.floating",
    "fallback": "0px 2px 4px #0000000f, 0px 4px 8px #0000001a",
    "layer": "semantic"
  },
  "command.opacity.disabled": {
    "resolvesTo": "semantic.interaction.disabled.opacity",
    "fallback": "0.5",
    "layer": "semantic"
  },
  "command.color.backgroundHover": {
    "resolvesTo": "semantic.interaction.background.hover",
    "fallback": "#f7f7f7",
    "layer": "semantic"
  }
}
