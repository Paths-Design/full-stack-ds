{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.full-stack-ds.local/document-model/0.3.0/visual-node.schema.json",
  "title": "Shared document candidate visual node",
  "description": "Draft 0.3.0 paper representation; not an editor runtime admission contract.",
  "$ref": "#/$defs/node",
  "$defs": {
    "node": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "frame"
                },
                "layout": {
                  "$ref": "appearance.schema.json#/$defs/layout"
                },
                "clipContent": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "layout",
                "clipContent"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "group"
                },
                "layout": {
                  "$ref": "appearance.schema.json#/$defs/layout"
                }
              },
              "required": [
                "kind",
                "layout"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "shape"
                },
                "geometry": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "rectangle"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              "required": [
                "kind",
                "geometry"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "text"
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "content"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "component-instance"
                },
                "definitionRef": {
                  "$ref": "common.schema.json#/$defs/definitionRef"
                },
                "parameterBindings": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9._-]*$"
                  },
                  "additionalProperties": {
                    "$ref": "common.schema.json#/$defs/binding"
                  }
                },
                "children": {
                  "type": "array",
                  "maxItems": 0
                },
                "partOverrides": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "partId": {
                        "allOf": [
                          {
                            "$ref": "common.schema.json#/$defs/id"
                          },
                          {
                            "not": {
                              "const": "root"
                            }
                          }
                        ]
                      },
                      "properties": {
                        "$ref": "common.schema.json#/$defs/properties"
                      }
                    },
                    "required": [
                      "partId",
                      "properties"
                    ]
                  },
                  "minItems": 0
                },
                "slotBindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "slotId": {
                        "$ref": "common.schema.json#/$defs/id"
                      },
                      "nodeIds": {
                        "type": "array",
                        "items": {
                          "$ref": "common.schema.json#/$defs/id"
                        },
                        "minItems": 0
                      }
                    },
                    "required": [
                      "slotId",
                      "nodeIds"
                    ]
                  },
                  "minItems": 0
                }
              },
              "required": [
                "kind",
                "definitionRef",
                "parameterBindings",
                "partOverrides",
                "slotBindings"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "definition-placement"
                },
                "definitionRef": {
                  "$ref": "common.schema.json#/$defs/definitionRef"
                },
                "children": {
                  "type": "array",
                  "maxItems": 0
                }
              },
              "required": [
                "kind",
                "definitionRef",
                "children"
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false,
      "type": "object"
    },
    "nodeBase": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "defaultProfileRef": {
          "$ref": "common.schema.json#/$defs/profileRef"
        },
        "properties": {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/properties"
            },
            {
              "type": "object",
              "properties": {
                "sizing.width": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/binding"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "valueType": {
                          "const": "dimension"
                        }
                      },
                      "required": [
                        "valueType"
                      ]
                    },
                    {
                      "type": "object",
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "literal"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "sizing.height": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/binding"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "valueType": {
                          "const": "dimension"
                        }
                      },
                      "required": [
                        "valueType"
                      ]
                    },
                    {
                      "type": "object",
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "literal"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "transform.translation.x": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/binding"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "valueType": {
                          "const": "dimension"
                        }
                      },
                      "required": [
                        "valueType"
                      ]
                    }
                  ]
                },
                "transform.translation.y": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/binding"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "valueType": {
                          "const": "dimension"
                        }
                      },
                      "required": [
                        "valueType"
                      ]
                    }
                  ]
                },
                "typography.fontSize": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/binding"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "valueType": {
                          "const": "dimension"
                        }
                      },
                      "required": [
                        "valueType"
                      ]
                    }
                  ]
                },
                "typography.lineHeight": {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/binding"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "valueType": {
                          "const": "dimension"
                        }
                      },
                      "required": [
                        "valueType"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nodeId": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "$ref": "common.schema.json#/$defs/id"
              }
            },
            "required": [
              "nodeId"
            ]
          },
          "minItems": 0
        },
        "fills": {
          "$ref": "appearance.schema.json#/$defs/fills"
        },
        "corners": {
          "$ref": "appearance.schema.json#/$defs/corners"
        },
        "layoutItem": {
          "$ref": "appearance.schema.json#/$defs/layoutItem"
        },
        "textStyle": {
          "$ref": "appearance.schema.json#/$defs/textStyle"
        }
      },
      "required": [
        "id",
        "label",
        "defaultProfileRef",
        "properties",
        "children"
      ]
    }
  }
}
