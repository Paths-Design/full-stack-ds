{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.full-stack-ds.local/document-model/0.3.0/document.schema.json",
  "title": "Shared document candidate document",
  "description": "Draft 0.3.0 paper representation; not an editor runtime admission contract.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "projectId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "pageId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "visual-node.schema.json"
      },
      "minItems": 0
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "durationTicks": {
            "type": "integer",
            "minimum": 1
          },
          "compositionId": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "required": [
          "id",
          "label",
          "compositionId",
          "durationTicks"
        ]
      },
      "minItems": 0
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "motion.schema.json#/$defs/track"
      },
      "minItems": 0
    },
    "sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "sceneId": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "atTicks": {
                  "$ref": "common.schema.json#/$defs/ticks"
                },
                "sourceInTicks": {
                  "$ref": "common.schema.json#/$defs/ticks"
                },
                "sourceOutTicks": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "sceneId",
                "atTicks",
                "sourceInTicks",
                "sourceOutTicks"
              ]
            },
            "minItems": 0
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "kind": {
                  "const": "cut"
                },
                "fromOccurrenceId": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "toOccurrenceId": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "required": [
                "id",
                "kind",
                "fromOccurrenceId",
                "toOccurrenceId"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "label",
          "occurrences",
          "transitions"
        ]
      },
      "minItems": 0
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "page",
                  "node",
                  "scene",
                  "sequence"
                ]
              },
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              }
            },
            "required": [
              "kind",
              "id"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "target",
          "text"
        ]
      },
      "minItems": 0
    },
    "compositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string"
          },
          "rootNodeId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "nodeIds": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "label",
          "rootNodeId",
          "nodeIds"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "pageId",
    "revision",
    "compositions",
    "nodes",
    "scenes",
    "tracks",
    "sequences",
    "annotations"
  ]
}
