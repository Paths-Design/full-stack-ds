{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.full-stack-ds.local/document-model/0.3.0/definition-source.schema.json",
  "title": "Candidate selected definition source",
  "description": "One owned source of visual definitions; no loader or runtime proof.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "definitions": {
      "type": "array",
      "items": {
        "$ref": "definition.schema.json"
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "definitions"
  ]
}
