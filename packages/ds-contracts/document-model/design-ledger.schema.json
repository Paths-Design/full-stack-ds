{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.full-stack-ds.local/document-model/0.3.0/design-ledger.schema.json",
  "title": "Shared document candidate design-ledger",
  "description": "Draft 0.3.0 paper representation; not an editor runtime admission contract.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "requirement": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "designCoverage": {
            "enum": [
              "specified",
              "partial",
              "open",
              "deferred"
            ]
          },
          "schemaCoverage": {
            "enum": [
              "represented",
              "partial",
              "absent"
            ]
          },
          "runtimeStatus": {
            "enum": [
              "not-implemented",
              "implemented-unverified",
              "bounded-evidence"
            ]
          },
          "relationships": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "minItems": 1
          },
          "decisionRefs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/path"
            },
            "minItems": 1
          },
          "remainingDesign": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "minItems": 0
          },
          "proofObligations": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "minItems": 1
          },
          "runtimeRefs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "requirement",
          "designCoverage",
          "schemaCoverage",
          "runtimeStatus",
          "relationships",
          "decisionRefs",
          "remainingDesign",
          "proofObligations",
          "runtimeRefs"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "runtimeStatus": {
                  "enum": [
                    "implemented-unverified",
                    "bounded-evidence"
                  ]
                }
              },
              "required": [
                "runtimeStatus"
              ]
            },
            "then": {
              "properties": {
                "runtimeRefs": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "designCoverage": {
                  "enum": [
                    "partial",
                    "open",
                    "deferred"
                  ]
                }
              },
              "required": [
                "designCoverage"
              ]
            },
            "then": {
              "properties": {
                "remainingDesign": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "requirementId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "from": {
            "oneOf": [
              {
                "enum": [
                  "specified",
                  "partial",
                  "open",
                  "deferred"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "enum": [
              "specified",
              "partial",
              "open",
              "deferred"
            ]
          },
          "rationale": {
            "$ref": "common.schema.json#/$defs/text"
          }
        },
        "required": [
          "date",
          "requirementId",
          "from",
          "to",
          "rationale"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "updated",
    "records",
    "changes"
  ]
}
