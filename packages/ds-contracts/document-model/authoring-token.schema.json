{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.full-stack-ds.local/document-model/0.3.0/authoring-token.schema.json",
  "title": "Bounded authored token source",
  "description": "Draft paper shape; not an executor, persistence or conformance result.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "tokens": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/token"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "tokens"
  ],
  "$defs": {
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "fill",
              "foreground",
              "border",
              "corner-radius"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "nodeKinds": {
          "type": "array",
          "items": {
            "enum": [
              "frame",
              "group",
              "shape",
              "text"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "roles",
        "nodeKinds"
      ]
    },
    "token": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "$type": {
              "const": "dimension"
            },
            "$value": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "enum": [
                    "px",
                    "rem"
                  ]
                }
              },
              "required": [
                "value",
                "unit"
              ]
            },
            "$extensions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "org.full-stack-ds.editor": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "eligibility": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "roles": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "fill",
                              "foreground",
                              "border",
                              "corner-radius"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "nodeKinds": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "frame",
                              "group",
                              "shape",
                              "text"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "roles",
                        "nodeKinds"
                      ]
                    }
                  },
                  "required": [
                    "eligibility"
                  ]
                }
              },
              "required": [
                "org.full-stack-ds.editor"
              ]
            }
          },
          "required": [
            "$type",
            "$value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "$type": {
              "const": "color"
            },
            "$value": {
              "$ref": "common.schema.json#/$defs/color"
            },
            "$extensions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "org.full-stack-ds.editor": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "eligibility": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "roles": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "fill",
                              "foreground",
                              "border",
                              "corner-radius"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "nodeKinds": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "frame",
                              "group",
                              "shape",
                              "text"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "roles",
                        "nodeKinds"
                      ]
                    }
                  },
                  "required": [
                    "eligibility"
                  ]
                }
              },
              "required": [
                "org.full-stack-ds.editor"
              ]
            }
          },
          "required": [
            "$type",
            "$value"
          ]
        }
      ]
    }
  }
}
