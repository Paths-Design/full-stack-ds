{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.full-stack-ds.local/document-model/0.2.0/page-record.schema.json",
  "title": "Shared document candidate page-record",
  "description": "Draft 0.2.0 paper representation; not an editor runtime admission contract.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "header"
        },
        "schemaVersion": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "projectId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "pageId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "initialRevision": {
          "const": 0
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "projectId",
        "pageId",
        "initialRevision"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "transaction"
        },
        "transactionId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "human",
                "agent"
              ]
            },
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "initialize"
            },
            "document": {
              "$ref": "document.schema.json"
            }
          },
          "required": [
            "kind",
            "document"
          ]
        }
      },
      "required": [
        "kind",
        "transactionId",
        "expectedRevision",
        "revision",
        "actor",
        "action"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "transaction"
        },
        "transactionId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "human",
                "agent"
              ]
            },
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "edit"
            },
            "operations": {
              "type": "array",
              "items": {
                "$ref": "edit-operation.schema.json"
              },
              "minItems": 1
            },
            "history": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "edit"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "undo"
                    },
                    "ofTransactionId": {
                      "$ref": "common.schema.json#/$defs/id"
                    }
                  },
                  "required": [
                    "kind",
                    "ofTransactionId"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "redo"
                    },
                    "ofTransactionId": {
                      "$ref": "common.schema.json#/$defs/id"
                    }
                  },
                  "required": [
                    "kind",
                    "ofTransactionId"
                  ]
                }
              ]
            }
          },
          "required": [
            "kind",
            "operations",
            "history"
          ],
          "allOf": [
            {
              "if": {
                "type": "object",
                "properties": {
                  "operations": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "const": "remove-inserted-node"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    }
                  }
                }
              },
              "then": {
                "type": "object",
                "properties": {
                  "history": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "undo"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "kind",
        "transactionId",
        "expectedRevision",
        "revision",
        "actor",
        "action"
      ]
    }
  ]
}
