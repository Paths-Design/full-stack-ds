{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.full-stack-ds.local/document-model/0.3.0/edit-operation.schema.json",
  "title": "Candidate composition-owned edit operation",
  "description": "Paper operation shape only; admission, atomic effects and inverse execution remain unimplemented.",
  "type": "object",
  "unevaluatedProperties": false,
  "allOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "composition"
            },
            "compositionId": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "compositionId"
          ]
        }
      },
      "required": [
        "id",
        "owner"
      ]
    },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "insert-node"
            },
            "node": {
              "$ref": "visual-node.schema.json"
            },
            "destination": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "parentNodeId": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "slotId": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "index": {
                  "$ref": "common.schema.json#/$defs/ticks"
                }
              },
              "required": [
                "parentNodeId",
                "index"
              ]
            }
          },
          "required": [
            "kind",
            "node",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "supply-slot"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "slotId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "nodeIds": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "minItems": 0
            }
          },
          "required": [
            "kind",
            "nodeId",
            "slotId",
            "nodeIds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reset-slot"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "slotId": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "slotId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "set-binding"
            },
            "address": {
              "$ref": "#/$defs/address"
            },
            "binding": {
              "$ref": "common.schema.json#/$defs/binding"
            }
          },
          "required": [
            "kind",
            "address",
            "binding"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reset-binding"
            },
            "address": {
              "$ref": "#/$defs/address"
            }
          },
          "required": [
            "kind",
            "address"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "add-track"
            },
            "track": {
              "$ref": "motion.schema.json#/$defs/track"
            }
          },
          "required": [
            "kind",
            "track"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "remove-track"
            },
            "sceneId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "trackId": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "sceneId",
            "trackId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "add-keyframe"
            },
            "sceneId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "trackId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "keyframe": {
              "$ref": "motion.schema.json#/$defs/keyframe"
            }
          },
          "required": [
            "kind",
            "sceneId",
            "trackId",
            "keyframe"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "edit-keyframe"
            },
            "sceneId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "trackId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "keyframe": {
              "$ref": "motion.schema.json#/$defs/keyframe"
            }
          },
          "required": [
            "kind",
            "sceneId",
            "trackId",
            "keyframe"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "remove-keyframe"
            },
            "sceneId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "trackId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "keyframeId": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "sceneId",
            "trackId",
            "keyframeId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "remove-inserted-node"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "insertTransactionId": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "insertTransactionId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rename-node"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "label"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "replace-text"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "set-layout"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "layout": {
              "$ref": "appearance.schema.json#/$defs/layout"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "layout"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "set-paint"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "paint": {
              "$ref": "appearance.schema.json#/$defs/paint"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "paint"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "set-corners"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "corners": {
              "$ref": "appearance.schema.json#/$defs/corners"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "corners"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "create-composition"
            },
            "composition": {
              "$ref": "document.schema.json#/properties/compositions/items"
            },
            "root": {
              "$ref": "visual-node.schema.json"
            }
          },
          "required": [
            "kind",
            "composition",
            "root"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "insert-instance"
            },
            "node": {
              "allOf": [
                {
                  "$ref": "visual-node.schema.json"
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "component-instance"
                    }
                  }
                }
              ]
            },
            "destination": {
              "$ref": "edit-operation.schema.json#/$defs/destination"
            }
          },
          "required": [
            "kind",
            "node",
            "destination"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "extract-definition"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "definitionRef": {
              "$ref": "common.schema.json#/$defs/definitionRef"
            },
            "correspondenceId": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "definitionRef",
            "correspondenceId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "restore-extracted-subtree"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "extractionProjectChangeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "correspondenceId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "definitionRef": {
              "$ref": "common.schema.json#/$defs/definitionRef"
            },
            "beforeRevision": {
              "type": "integer",
              "minimum": 0
            },
            "subtree": {
              "$ref": "definition.schema.json#/properties/body"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "extractionProjectChangeId",
            "correspondenceId",
            "definitionRef",
            "beforeRevision",
            "subtree"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "remove-created-composition"
            },
            "compositionId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "createTransactionId": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "compositionId",
            "createTransactionId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reset-node-field"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "field": {
              "enum": [
                "fills",
                "corners",
                "layout"
              ]
            }
          },
          "required": [
            "kind",
            "nodeId",
            "field"
          ]
        }
      ]
    }
  ],
  "$defs": {
    "address": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "parameter"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "parameterId": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "parameterId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "property"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "partId": {
              "allOf": [
                {
                  "$ref": "common.schema.json#/$defs/id"
                },
                {
                  "not": {
                    "const": "root"
                  }
                }
              ]
            },
            "property": {
              "$ref": "common.schema.json#/$defs/property"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "property"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "paint"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "paintId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "property": {
              "const": "color"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "paintId",
            "property"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "corner"
            },
            "nodeId": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "property": {
              "const": "radius"
            }
          },
          "required": [
            "kind",
            "nodeId",
            "property"
          ]
        }
      ]
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentNodeId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "slotId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "index": {
          "$ref": "common.schema.json#/$defs/ticks"
        }
      },
      "required": [
        "parentNodeId",
        "index"
      ]
    }
  }
}
