{
  "name": "@full-stack-ds/tokens",
  "version": "1.0.0",
  "type": "module",
  "description": "Design tokens as cascade-layered CSS with brand and density variants, plus resolved DTCG JSON.",
  "exports": {
    "./tokens.css": {
      "types": "./types/styles-css.d.ts",
      "default": "./generated/tokens.css"
    },
    "./generated/resolved.tokens.json": "./generated/resolved.tokens.json"
  },
  "files": [
    "generated/tokens.css",
    "generated/resolved.tokens.json",
    "types",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsx build/build.ts --prefix=fsds",
    "validate": "tsx build/build.ts --prefix=fsds --validate-only",
    "check-contrast": "tsx build/runners/check-contrast.ts",
    "check-usage": "tsx build/runners/usage.ts",
    "check-usage:gate": "tsx build/runners/usage.ts --check-baseline",
    "write-usage-baseline": "tsx build/runners/usage.ts --write-baseline",
    "check-brand-refs": "tsx build/runners/check-brand-refs.ts",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "glob": "^10.5.0",
    "@adobe/leonardo-contrast-colors": "^1.1.0",
    "@types/node": "^25.5.2",
    "tsx": "^4.7.0",
    "typescript": "^6.0.2"
  },
  "license": "MIT",
  "author": "DesignPaths, LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paths-Design/full-stack-ds.git",
    "directory": "packages/ds-tokens"
  },
  "homepage": "https://github.com/Paths-Design/full-stack-ds/tree/main/packages/ds-tokens#readme",
  "bugs": {
    "url": "https://github.com/Paths-Design/full-stack-ds/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
