{
  "name": "@full-stack-ds/vue",
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "description": "Vue 3 implementation of Full Stack DS (Stack primitive + generated components)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": {
      "types": "./dist/types/styles-css.d.ts",
      "default": "./dist/vue.css"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "build": "vite build && pnpm run build:types && node ../../scripts/emit-commonjs-facades.mjs .",
    "build:types": "vue-tsc -p tsconfig.build.json && node ../../scripts/normalize-package-declarations.mjs .",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^3.2.4",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "@full-stack-ds/iconography": "workspace:*"
  },
  "license": "MIT",
  "author": "DesignPaths, LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paths-Design/full-stack-ds.git",
    "directory": "packages/ds-vue"
  },
  "homepage": "https://github.com/Paths-Design/full-stack-ds/tree/main/packages/ds-vue#readme",
  "bugs": {
    "url": "https://github.com/Paths-Design/full-stack-ds/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
