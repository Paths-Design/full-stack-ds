/* Switch (.switch) */
.switch {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-action-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-action-size-medium-min-width, 32px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: var(--fsds-semantic-action-size-medium-min-height, 32px);
    --fsds-box-model-max-height: none;
    --fsds-switch-motion-duration: var(--fsds-semantic-motion-interaction-press-duration, 100ms);
    --fsds-switch-color-track-background: var(--fsds-semantic-color-background-tertiary, #d0d0d0);
    --fsds-switch-color-track-border: var(--fsds-semantic-color-border-subtle, #d0d0d0);
    --fsds-switch-color-thumb-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-switch-size-md-track-width: var(--fsds-core-spacing-size-09, 48px);
    --fsds-switch-size-md-track-height: var(--fsds-core-spacing-size-07, 24px);
    --fsds-switch-size-md-track-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-switch-size-md-track-padding: var(--fsds-core-spacing-size-01, 1px);
    --fsds-switch-size-md-thumb-size: var(--fsds-core-spacing-size-06, 16px);
    --fsds-switch-size-md-thumb-height: var(--fsds-core-spacing-size-06, 16px);
    --fsds-switch-size-sm-track-width: var(--fsds-core-spacing-size-08, 32px);
    --fsds-switch-size-sm-track-height: var(--fsds-core-spacing-size-06, 16px);
    --fsds-switch-size-sm-track-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-switch-size-sm-track-padding: var(--fsds-core-spacing-size-01, 1px);
    --fsds-switch-size-sm-thumb-size: var(--fsds-core-spacing-size-05, 12px);
    --fsds-switch-size-sm-thumb-height: var(--fsds-core-spacing-size-05, 12px);
    --fsds-switch-size-lg-track-width: var(--fsds-core-spacing-size-10, 64px);
    --fsds-switch-size-lg-track-height: var(--fsds-core-spacing-size-08, 32px);
    --fsds-switch-size-lg-track-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-switch-size-lg-track-padding: var(--fsds-core-spacing-size-01, 1px);
    --fsds-switch-size-lg-thumb-size: var(--fsds-core-spacing-size-07, 24px);
    --fsds-switch-size-lg-thumb-height: var(--fsds-core-spacing-size-07, 24px);
    --fsds-switch-size-sm-thumb-translate-off: 0;
    --fsds-switch-size-sm-thumb-translate-on: 16px;
    --fsds-switch-size-md-thumb-translate-off: 0;
    --fsds-switch-size-md-thumb-translate-on: 24px;
    --fsds-switch-size-lg-thumb-translate-off: 0;
    --fsds-switch-size-lg-thumb-translate-on: 36px;
    --fsds-switch-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-switch-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-switch-focus-ring-style: var(--fsds-semantic-focus-ring-style, solid);
    --fsds-switch-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
}

.switch {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 4px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 4px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 32px);
    min-height: var(--fsds-box-model-min-height, 32px);
}

.switch > .switch__children {
    --fsds-gap: var(--fsds-box-model-gap, 8px);
}

.switch {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
}

.switch > .switch__children {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.switch__track {
    transition-property: background-color;
    transition-duration: var(--fsds-switch-motion-duration);
    transition-timing-function: ease;
    background-color: var(--fsds-switch-color-track-background, #d0d0d0);
    border-color: var(--fsds-switch-color-track-border, #d0d0d0);
    width: var(--fsds-switch-size-md-track-width, 48px);
    height: var(--fsds-switch-size-md-track-height, 24px);
    border-radius: var(--fsds-switch-size-md-track-radius, 9999px);
    padding: var(--fsds-switch-size-md-track-padding, 1px);
    display: flex;
    flex-direction: column;
    position: relative;
    border-width: 1px;
}

.switch__thumb {
    transition-property: translate, background-color;
    transition-duration: 100ms, 100ms;
    transition-timing-function: ease, ease;
    background-color: var(--fsds-switch-color-thumb-background, #ffffff);
    width: var(--fsds-switch-size-md-thumb-size, 16px);
    height: var(--fsds-switch-size-md-thumb-height, 16px);
    top: 50%;
    left: var(--fsds-switch-size-md-track-padding, 1px);
    translate: 0 -50%;
    display: flex;
    flex-direction: column;
    position: absolute;
    border-radius: 50%;
}

.switch__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border-width: 0;
}

.switch.is-checked .switch__track {
    --fsds-switch-color-track-background: var(--fsds-semantic-color-foreground-accent, #d92d2e);
}

.switch.is-checked .switch__thumb {
    translate: 24px -50%;
    --fsds-switch-color-thumb-background: var(--fsds-semantic-color-foreground-on-brand, #ffffff);
}

.switch:disabled .switch__track {
    --fsds-switch-color-track-background: var(--fsds-semantic-color-background-disabled, #d0d0d0);
}

.switch.switch--sm {
    --fsds-box-model-padding-block-start: var(--fsds-semantic-action-size-small-padding-block, 2px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-action-size-small-padding-block, 2px);
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-action-size-small-padding-inline, 4px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-action-size-small-padding-inline, 4px);
    --fsds-box-model-gap: var(--fsds-semantic-action-size-small-gap, 4px);
    --fsds-box-model-min-height: var(--fsds-semantic-action-size-small-min-height, 24px);
    --fsds-box-model-min-width: var(--fsds-semantic-action-size-small-min-width, 24px);
}

.switch.switch--md {
    --fsds-box-model-padding-block-start: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-action-size-medium-gap, 8px);
    --fsds-box-model-min-height: var(--fsds-semantic-action-size-medium-min-height, 32px);
    --fsds-box-model-min-width: var(--fsds-semantic-action-size-medium-min-width, 32px);
}

.switch.switch--lg {
    --fsds-box-model-padding-block-start: var(--fsds-semantic-action-size-large-padding-block, 8px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-action-size-large-padding-block, 8px);
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-action-size-large-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-action-size-large-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-action-size-large-gap, 12px);
    --fsds-box-model-min-height: var(--fsds-semantic-action-size-large-min-height, 48px);
    --fsds-box-model-min-width: var(--fsds-semantic-action-size-large-min-width, 48px);
}

.switch--sm .switch__track {
    width: var(--fsds-switch-size-sm-track-width, 32px);
    height: var(--fsds-switch-size-sm-track-height, 16px);
    border-radius: var(--fsds-switch-size-sm-track-radius, 9999px);
    padding: var(--fsds-switch-size-sm-track-padding, 1px);
}

.switch--sm .switch__thumb {
    width: var(--fsds-switch-size-sm-thumb-size, 12px);
    height: var(--fsds-switch-size-sm-thumb-height, 12px);
    left: var(--fsds-switch-size-sm-track-padding, 1px);
    translate: 0 -50%;
}

.switch--sm.is-checked .switch__thumb {
    translate: 16px -50%;
}

.switch--lg .switch__track {
    width: var(--fsds-switch-size-lg-track-width, 64px);
    height: var(--fsds-switch-size-lg-track-height, 32px);
    border-radius: var(--fsds-switch-size-lg-track-radius, 9999px);
    padding: var(--fsds-switch-size-lg-track-padding, 1px);
}

.switch--lg .switch__thumb {
    width: var(--fsds-switch-size-lg-thumb-size, 24px);
    height: var(--fsds-switch-size-lg-thumb-height, 24px);
    left: var(--fsds-switch-size-lg-track-padding, 1px);
    translate: 0 -50%;
}

.switch--lg.is-checked .switch__thumb {
    translate: 36px -50%;
}

.switch.is-focus .switch__track {
    border-width: var(--fsds-switch-focus-ring-width, 2px);
    border-color: var(--fsds-switch-focus-ring-color, #0566fe);
}

/* Accordion (.accordion) */
.accordion {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-accordion-color-background-hover: var(--fsds-semantic-interaction-background-hover, #f7f7f7);
    --fsds-accordion-color-text: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-accordion-color-text-secondary: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-accordion-color-icon: var(--fsds-semantic-color-foreground-tertiary, #727272);
    --fsds-accordion-border-width: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-accordion-border-color: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-accordion-border-radius: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-accordion-spacing-gap: var(--fsds-core-spacing-size-07, 24px);
    --fsds-accordion-spacing-padding-y: var(--fsds-core-spacing-size-04, 8px);
    --fsds-accordion-text-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-accordion-text-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-accordion-text-line-height: var(--fsds-semantic-typography-line-height-normal, 1.5);
    --fsds-accordion-text-size-content: var(--fsds-semantic-typography-body-03, 14px);
    --fsds-accordion-text-line-height-content: var(--fsds-semantic-typography-line-height-loose, 1.8);
    --fsds-accordion-icon-size: var(--fsds-semantic-glyph-size-medium-extent, 16px);
    --fsds-accordion-focus-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-accordion-focus-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-accordion-focus-offset: var(--fsds-semantic-focus-ring-offset-inset, -2px);
    --fsds-accordion-opacity-disabled: var(--fsds-semantic-interaction-disabled-opacity, 0.5);
}

.accordion {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.accordion {
    display: flex;
    flex-direction: column;
    border-radius: var(--fsds-accordion-border-radius, 4px);
    --fsds-gap: var(--fsds-accordion-spacing-gap, 24px);
}

.accordion__item {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--fsds-accordion-border-color, #d0d0d0);
    border-width: 1px;
    border-radius: var(--fsds-accordion-border-radius, 4px);
    overflow: hidden;
}

.accordion__header {
    margin: 0;
}

.accordion__trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--fsds-accordion-spacing-padding-y, 8px);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: var(--fsds-accordion-text-size, 16px);
    color: var(--fsds-accordion-color-text, #141414);
}

.accordion__trigger > .accordion__children {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.accordion__trigger:hover {
    background-color: var(--fsds-accordion-color-background-hover, #f7f7f7);
}

.accordion__trigger:focus {
    border-width: var(--fsds-accordion-focus-width, 2px);
    border-color: var(--fsds-accordion-focus-color, #0566fe);
}

.accordion__chevron {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    width: var(--fsds-accordion-icon-size, 16px);
    height: var(--fsds-accordion-icon-size, 16px);
    align-items: center;
    justify-content: center;
    color: var(--fsds-accordion-color-icon, #727272);
}

.accordion__content {
    overflow: hidden;
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--fsds-semantic-motion-interaction-exit-duration, 167ms);
    transition-timing-function: ease;
}

.accordion__content.is-open {
    opacity: 1;
    transition-property: opacity;
    transition-duration: var(--fsds-semantic-motion-interaction-enter-duration, 250ms);
    transition-timing-function: ease;
}

.accordion__contentInner {
    min-height: 0;
    overflow: hidden;
    padding-left: var(--fsds-accordion-spacing-padding-y, 8px);
    padding-right: var(--fsds-accordion-spacing-padding-y, 8px);
    padding-bottom: 0;
    color: var(--fsds-accordion-color-text-secondary, #474647);
    font-size: var(--fsds-accordion-text-size-content, 14px);
}

.accordion__content.is-open .accordion__contentInner {
    padding-bottom: var(--fsds-accordion-spacing-padding-y, 8px);
}

.accordion:disabled {
    opacity: var(--fsds-accordion-opacity-disabled, 0.5);
}

/* Popover (.popover) */
.popover {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-popover-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-popover-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-popover-size-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-popover-color-background-content: var(--fsds-semantic-color-background-elevated, #ffffff);
    --fsds-popover-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-popover-layer-content: var(--fsds-core-layer-dropdown, 1000);
}

.popover {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.popover {
    position: relative;
    display: flex;
    flex-direction: column;
}

.popover__trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.popover__content {
    min-width: 256px;
    background-color: var(--fsds-popover-color-background-content, #ffffff);
    border-color: var(--fsds-popover-color-border, #d0d0d0);
    border-radius: var(--fsds-popover-size-radius, 6px);
    padding: var(--fsds-popover-size-padding, 16px);
    --fsds-gap: var(--fsds-popover-size-gap, 8px);
    display: flex;
    flex-direction: column;
    border-width: 1px;
}

.popover__content {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-popover-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-popover-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-popover-size-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-popover-color-background-content: var(--fsds-semantic-color-background-elevated, #ffffff);
    --fsds-popover-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-popover-layer-content: var(--fsds-core-layer-dropdown, 1000);
}

/* Tabs (.tabs) */
.tabs {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-tabs-spacing-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-tabs-spacing-padding: var(--fsds-core-spacing-size-04, 8px);
    --fsds-tabs-spacing-panel-gap: var(--fsds-core-spacing-size-06, 16px);
    --fsds-tabs-color-fg: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-tabs-color-disabled-fg: var(--fsds-semantic-color-foreground-disabled, #727272);
    --fsds-tabs-color-indicator: var(--fsds-semantic-color-border-accent, #d92d2e);
    --fsds-tabs-shape-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-tabs-motion-indicator: var(--fsds-core-motion-duration-short, 150ms);
    --fsds-tabs-color-hover-bg: var(--fsds-semantic-color-background-hover, #f7f7f7);
    --fsds-tabs-color-hover-fg: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-tabs-color-active-fg: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-tabs-color-active-bg: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-tabs-color-underline-active: var(--fsds-semantic-color-border-accent, #d92d2e);
    --fsds-tabs-size-indicator-thickness: 2px;
}

.tabs {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.tabs {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-tabs-spacing-panel-gap, 16px);
    padding: var(--fsds-tabs-spacing-padding, 8px);
    border-radius: var(--fsds-tabs-shape-radius, 6px);
}

.tabs__list {
    display: flex;
    flex-direction: row;
    --fsds-gap: var(--fsds-tabs-spacing-gap, 8px);
    border-bottom-color: var(--fsds-tabs-color-indicator, #d92d2e);
    border-bottom-width: 1px;
    position: relative;
}

.tabs__list > .tabs__children {
    display: flex;
    flex-direction: row;
    --fsds-gap: var(--fsds-tabs-spacing-gap, 8px);
}

.tabs__tab {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: var(--fsds-tabs-spacing-padding, 8px);
    color: var(--fsds-tabs-color-fg, #141414);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    position: relative;
}

.tabs__tab:hover {
    color: var(--fsds-tabs-color-hover-fg, #141414);
    background-color: var(--fsds-tabs-color-hover-bg, #f7f7f7);
}

.tabs__tab:disabled {
    color: var(--fsds-tabs-color-disabled-fg, #727272);
}

.tabs__indicator {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--fsds-tabs-color-indicator, #d92d2e);
    transition-property: width;
    transition-duration: var(--fsds-tabs-motion-indicator);
    transition-timing-function: ease;
}

.tabs__panel {
    display: flex;
    flex-direction: column;
    padding: var(--fsds-tabs-spacing-padding, 8px);
}

.tabs--underline .tabs__list {
    border-bottom-color: var(--fsds-tabs-color-underline-active, #d92d2e);
    border-bottom-width: var(--fsds-tabs-size-indicator-thickness, 2px);
}

.tabs--underline .tabs__indicator {
    height: var(--fsds-tabs-size-indicator-thickness, 2px);
    bottom: -1px;
    left: 0;
    right: 0;
    background-color: var(--fsds-tabs-color-underline-active, #d92d2e);
}

.tabs.tabs--vertical {
    flex-direction: row;
}

.tabs--vertical .tabs__list {
    flex-direction: column;
    border-bottom-width: 0;
    border-right-color: var(--fsds-tabs-color-indicator, #d92d2e);
    border-right-width: 1px;
    align-self: stretch;
}

.tabs--vertical .tabs__list > .tabs__children {
    flex-direction: column;
}

.tabs--vertical .tabs__indicator {
    top: 0;
    bottom: 0;
    right: -1px;
    left: auto;
    width: var(--fsds-tabs-size-indicator-thickness, 2px);
    height: auto;
    transition-property: height;
    transition-duration: var(--fsds-tabs-motion-indicator);
    transition-timing-function: ease;
}

.tabs--pills .tabs__list {
    border-bottom-width: 0;
    --fsds-gap: var(--fsds-tabs-spacing-gap, 8px);
}

.tabs--pills .tabs__list > .tabs__children {
    --fsds-gap: var(--fsds-tabs-spacing-gap, 8px);
}

.tabs--pills .tabs__tab {
    border-radius: var(--fsds-tabs-shape-radius, 6px);
    padding: 4px 10px;
}

.tabs--pills .tabs__indicator {
    display: none;
}

/* Text (.text) */
.text {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-text-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-text-typography-font-weight-light: var(--fsds-semantic-typography-font-weight-light, 300);
    --fsds-text-typography-font-weight-regular: var(--fsds-semantic-typography-font-weight-regular, 400);
    --fsds-text-typography-font-weight-medium: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-text-typography-font-weight-bold: var(--fsds-semantic-typography-font-weight-bold, 700);
    --fsds-text-typography-line-height-heading: var(--fsds-semantic-typography-line-height-heading, 1);
    --fsds-text-typography-line-height-body: var(--fsds-semantic-typography-line-height-body, 1.5);
    --fsds-text-typography-line-height-tight: var(--fsds-semantic-typography-line-height-tight, 1.2);
    --fsds-text-typography-letter-spacing-wide: var(--fsds-semantic-typography-letter-spacing-wide, 0.288px);
    --fsds-text-typography-letter-spacing-tight: var(--fsds-semantic-typography-letter-spacing-tight, -0.288px);
    --fsds-text-size-xs: var(--fsds-core-typography-ramp-2, 12px);
    --fsds-text-size-sm: var(--fsds-core-typography-ramp-3, 14px);
    --fsds-text-size-md: var(--fsds-core-typography-ramp-4, 16px);
    --fsds-text-size-lg: var(--fsds-core-typography-ramp-5, 18px);
    --fsds-text-size-xl: var(--fsds-core-typography-ramp-6, 20px);
    --fsds-text-size-2xl: var(--fsds-core-typography-ramp-7, 24px);
    --fsds-text-size-3xl: var(--fsds-core-typography-ramp-8, 32px);
}

.text {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.text {
    color: var(--fsds-text-color-foreground-primary, #141414);
    font-size: var(--fsds-text-size-md, 16px);
    margin: 0;
}

.text.text--display {
    --fsds-text-size-md: var(--fsds-core-typography-ramp-11, 60px);
    --fsds-text-typography-font-weight-bold: var(--fsds-semantic-typography-font-weight-bold, 700);
    font-size: var(--fsds-text-size-md, 16px);
    -unity-font-style: bold;
    letter-spacing: var(--fsds-text-typography-letter-spacing-tight, -0.288px);
}

.text.text--headline {
    --fsds-text-size-md: var(--fsds-core-typography-ramp-8, 32px);
    --fsds-text-typography-font-weight-bold: var(--fsds-semantic-typography-font-weight-bold, 700);
    font-size: var(--fsds-text-size-md, 16px);
    -unity-font-style: bold;
    letter-spacing: var(--fsds-text-typography-letter-spacing-tight, -0.288px);
}

.text.text--title {
    --fsds-text-size-md: var(--fsds-core-typography-ramp-6, 20px);
    --fsds-text-typography-font-weight-bold: var(--fsds-semantic-typography-font-weight-bold, 700);
    font-size: var(--fsds-text-size-md, 16px);
    -unity-font-style: bold;
}

.text.text--body {
    --fsds-text-size-md: var(--fsds-core-typography-ramp-4, 16px);
    --fsds-text-typography-font-weight-regular: var(--fsds-semantic-typography-font-weight-regular, 400);
    font-size: var(--fsds-text-size-md, 16px);
    -unity-font-style: normal;
}

.text.text--caption {
    --fsds-text-size-md: var(--fsds-core-typography-ramp-2, 12px);
    --fsds-text-typography-font-weight-regular: var(--fsds-semantic-typography-font-weight-regular, 400);
    font-size: var(--fsds-text-size-md, 16px);
    -unity-font-style: normal;
}

.text.text--overline {
    --fsds-text-size-md: var(--fsds-core-typography-ramp-2, 12px);
    --fsds-text-typography-font-weight-medium: var(--fsds-semantic-typography-font-weight-medium, 500);
    font-size: var(--fsds-text-size-md, 16px);
    letter-spacing: var(--fsds-text-typography-letter-spacing-wide, 0.288px);
}

.text.text--code {
    --fsds-text-size-md: var(--fsds-core-typography-ramp-3, 14px);
    font-size: var(--fsds-text-size-md, 16px);
}

.text.text--xs {
    --fsds-text-size-md: var(--fsds-text-size-xs, 12px);
    font-size: var(--fsds-text-size-md, 16px);
}

.text.text--sm {
    --fsds-text-size-md: var(--fsds-text-size-sm, 14px);
    font-size: var(--fsds-text-size-md, 16px);
}

.text.text--md {
    --fsds-text-size-md: var(--fsds-core-typography-ramp-4, 16px);
    font-size: var(--fsds-text-size-md, 16px);
}

.text.text--lg {
    --fsds-text-size-md: var(--fsds-text-size-lg, 18px);
    font-size: var(--fsds-text-size-md, 16px);
}

.text.text--xl {
    --fsds-text-size-md: var(--fsds-text-size-xl, 20px);
    font-size: var(--fsds-text-size-md, 16px);
}

.text.text--2xl {
    --fsds-text-size-md: var(--fsds-text-size-2xl, 24px);
    font-size: var(--fsds-text-size-md, 16px);
}

.text.text--3xl {
    --fsds-text-size-md: var(--fsds-text-size-3xl, 32px);
    font-size: var(--fsds-text-size-md, 16px);
}

.text.text--light {
    --fsds-text-typography-font-weight-light: var(--fsds-semantic-typography-font-weight-light, 300);
}

.text.text--normal {
    --fsds-text-typography-font-weight-regular: var(--fsds-semantic-typography-font-weight-regular, 400);
    -unity-font-style: normal;
}

.text.text--medium {
    --fsds-text-typography-font-weight-medium: var(--fsds-semantic-typography-font-weight-medium, 500);
}

.text.text--semibold {
    --fsds-text-typography-font-weight-medium: var(--fsds-semantic-typography-font-weight-semibold, 600);
}

.text.text--bold {
    --fsds-text-typography-font-weight-bold: var(--fsds-semantic-typography-font-weight-bold, 700);
    -unity-font-style: bold;
}

/* Divider (.divider) */
.divider {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-divider-color: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-divider-size-thickness: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-divider-spacing-margin: var(--fsds-core-spacing-size-04, 8px);
}

.divider {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.divider {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-color: var(--fsds-divider-color, #d0d0d0);
    border-top-width: var(--fsds-divider-size-thickness, 1px);
    margin-top: var(--fsds-divider-spacing-margin, 8px);
    margin-bottom: var(--fsds-divider-spacing-margin, 8px);
}

.divider.divider--vertical {
    width: 1px;
    height: auto;
    align-self: stretch;
    border-top-width: 0;
    border-left-color: var(--fsds-divider-color, #d0d0d0);
    border-left-width: var(--fsds-divider-size-thickness, 1px);
    margin-top: 0;
    margin-bottom: 0;
    margin-left: var(--fsds-divider-spacing-margin, 8px);
    margin-right: var(--fsds-divider-spacing-margin, 8px);
}

/* Icon (.icon) */
.icon {
    --fsds-box-model-width: var(--fsds-semantic-glyph-size-medium-extent, 16px);
    --fsds-box-model-height: var(--fsds-semantic-glyph-size-medium-extent, 16px);
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-icon-size-sm: var(--fsds-core-icon-size-sm, 16px);
    --fsds-icon-size-md: var(--fsds-core-icon-size-md, 20px);
    --fsds-icon-size-lg: var(--fsds-core-icon-size-lg, 24px);
    --fsds-icon-size-xl: var(--fsds-core-icon-size-xl, 32px);
}

.icon {
    width: var(--fsds-box-model-width, 16px);
    height: var(--fsds-box-model-height, 16px);
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.icon.icon--sm {
    width: var(--fsds-icon-size-sm, 16px);
    height: var(--fsds-icon-size-sm, 16px);
}

.icon.icon--md {
    width: var(--fsds-icon-size-md, 20px);
    height: var(--fsds-icon-size-md, 20px);
}

.icon.icon--lg {
    width: var(--fsds-icon-size-lg, 24px);
    height: var(--fsds-icon-size-lg, 24px);
}

.icon.icon--xl {
    width: var(--fsds-icon-size-xl, 32px);
    height: var(--fsds-icon-size-xl, 32px);
}

/* Button (.button) */
.button {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-action-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-action-size-medium-min-width, 32px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: var(--fsds-semantic-action-size-medium-min-height, 32px);
    --fsds-box-model-max-height: none;
    --fsds-button-color-background-default: var(--fsds-semantic-color-action-background-primary-default, #0566fe);
    --fsds-button-color-background-hover: var(--fsds-semantic-interaction-background-hover, #f7f7f7);
    --fsds-button-color-background-active: var(--fsds-semantic-interaction-background-active, #d0d0d0);
    --fsds-button-color-background-disabled: var(--fsds-semantic-color-action-background-primary-disabled, #b8b8b8);
    --fsds-button-color-foreground-default: var(--fsds-semantic-color-foreground-inverse, #fafafa);
    --fsds-button-color-foreground-disabled: var(--fsds-semantic-color-foreground-disabled, #727272);
    --fsds-button-color-border-default: var(--fsds-semantic-color-border-default, #a0a0a1);
    --fsds-button-color-border-hover: var(--fsds-semantic-interaction-border-hover, #888889);
    --fsds-button-color-border-focus: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-button-size-gap: var(--fsds-semantic-action-size-medium-gap, 8px);
    --fsds-button-size-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-button-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-button-text-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-button-motion-duration-fast: var(--fsds-core-motion-duration-short, 150ms);
    --fsds-button-size-font-size-medium: var(--fsds-semantic-typography-action-02, 16px);
}

.button {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 4px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 4px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 32px);
    min-height: var(--fsds-box-model-min-height, 32px);
}

.button {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    background-color: var(--fsds-button-color-background-default, #0566fe);
    color: var(--fsds-button-color-foreground-default, #fafafa);
    border-color: var(--fsds-button-color-border-default, #a0a0a1);
    --fsds-gap: var(--fsds-button-size-gap, 8px);
    border-radius: var(--fsds-button-size-radius, 9999px);
    border-width: var(--fsds-button-size-border, 1px);
    font-size: var(--fsds-button-size-font-size-medium, 16px);
}

.button.button--small {
    --fsds-box-model-padding-block-start: var(--fsds-core-spacing-size-03, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-core-spacing-size-03, 4px);
    --fsds-box-model-padding-inline-start: var(--fsds-core-spacing-size-04, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-core-spacing-size-04, 8px);
    --fsds-box-model-min-height: var(--fsds-core-dimension-action-min-height-small, 28px);
    --fsds-button-size-font-size-medium: var(--fsds-semantic-typography-action-03, 14px);
}

.button.button--medium {
    --fsds-box-model-padding-block-start: var(--fsds-core-spacing-size-04, 8px);
    --fsds-box-model-padding-block-end: var(--fsds-core-spacing-size-04, 8px);
    --fsds-box-model-padding-inline-start: var(--fsds-core-spacing-size-05, 12px);
    --fsds-box-model-padding-inline-end: var(--fsds-core-spacing-size-05, 12px);
    --fsds-box-model-min-height: var(--fsds-core-dimension-action-min-height, 36px);
    --fsds-button-size-font-size-medium: var(--fsds-semantic-typography-action-02, 16px);
}

.button.button--large {
    --fsds-box-model-padding-block-start: var(--fsds-core-spacing-size-05, 12px);
    --fsds-box-model-padding-block-end: var(--fsds-core-spacing-size-05, 12px);
    --fsds-box-model-padding-inline-start: var(--fsds-core-spacing-size-06, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-core-spacing-size-06, 16px);
    --fsds-box-model-min-height: var(--fsds-core-dimension-action-min-height-large, 48px);
    --fsds-button-size-font-size-medium: var(--fsds-semantic-typography-action-01, 18px);
}

.button.button--primary {
    --fsds-button-color-background-default: var(--fsds-semantic-color-action-background-primary-default, #0566fe);
    --fsds-button-color-background-hover: var(--fsds-semantic-color-action-background-primary-hover, #034fd6);
    --fsds-button-color-background-active: var(--fsds-semantic-color-action-background-primary-active, #013ab0);
    --fsds-button-color-background-disabled: var(--fsds-semantic-color-action-background-primary-disabled, #b8b8b8);
    --fsds-button-color-foreground-default: var(--fsds-semantic-color-foreground-inverse, #fafafa);
    --fsds-button-color-border-default: var(--fsds-semantic-color-action-background-primary-default, #0566fe);
    --fsds-button-color-border-hover: var(--fsds-semantic-color-action-background-primary-hover, #034fd6);
}

.button.button--secondary {
    --fsds-button-color-background-default: var(--fsds-semantic-color-action-background-secondary-default, #fafafa);
    --fsds-button-color-background-hover: var(--fsds-semantic-color-action-background-secondary-hover, #d0d0d0);
    --fsds-button-color-background-active: var(--fsds-semantic-color-action-background-secondary-active, #b8b8b8);
    --fsds-button-color-background-disabled: var(--fsds-semantic-color-action-background-secondary-disabled, #b8b8b8);
    --fsds-button-color-foreground-default: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-button-color-border-default: var(--fsds-semantic-color-border-default, #a0a0a1);
}

.button.button--tertiary {
    --fsds-button-color-background-default: rgba(0, 0, 0, 0);
    --fsds-button-color-foreground-default: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-button-color-border-default: rgba(0, 0, 0, 0);
}

.button.button--destructive {
    --fsds-button-color-background-default: rgba(0, 0, 0, 0);
    --fsds-button-color-background-hover: var(--fsds-semantic-color-background-danger-softer, #fee4e4);
    --fsds-button-color-background-active: var(--fsds-semantic-color-background-danger-subtle, #fac2c2);
    --fsds-button-color-background-disabled: var(--fsds-semantic-color-action-background-danger-disabled, #b8b8b8);
    --fsds-button-color-foreground-default: var(--fsds-semantic-color-foreground-on-danger-subtle, #900909);
    --fsds-button-color-border-default: var(--fsds-semantic-color-border-danger, #b31b1b);
    --fsds-button-color-border-hover: var(--fsds-semantic-color-border-danger, #b31b1b);
    --fsds-button-color-border-focus: var(--fsds-semantic-focus-ring-intent-danger, #b31b1b);
}

.button.button--ghost {
    --fsds-button-color-background-default: rgba(0, 0, 0, 0);
    --fsds-button-color-foreground-default: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-button-color-border-default: rgba(0, 0, 0, 0);
}

.button.button--outline {
    --fsds-button-color-background-default: rgba(0, 0, 0, 0);
    --fsds-button-color-foreground-default: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-button-color-border-default: var(--fsds-semantic-color-border-default, #a0a0a1);
}

.button:hover {
    background-color: var(--fsds-button-color-background-hover, #f7f7f7);
    border-color: var(--fsds-button-color-border-hover, #888889);
}

.button:active {
    background-color: var(--fsds-button-color-background-active, #d0d0d0);
}

.button:focus {
    border-color: var(--fsds-button-color-border-focus, #0566fe);
}

.button:disabled {
    background-color: var(--fsds-button-color-background-disabled, #b8b8b8);
    color: var(--fsds-button-color-foreground-disabled, #727272);
}

.button__spinner {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.button__loadingText {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* Checkbox (.checkbox) */
.checkbox {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-input-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: var(--fsds-semantic-input-size-medium-min-height, 32px);
    --fsds-box-model-max-height: none;
    --fsds-checkbox-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-checkbox-color-border: var(--fsds-semantic-color-border-default, #a0a0a1);
    --fsds-checkbox-border-width: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-checkbox-border-radius: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-checkbox-transition-duration: var(--fsds-core-motion-duration-short, 150ms);
    --fsds-checkbox-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-checkbox-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-checkbox-focus-ring-style: var(--fsds-semantic-focus-ring-style, solid);
    --fsds-checkbox-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
    --fsds-checkbox-color-mark: var(--fsds-semantic-color-foreground-on-brand, #ffffff);
}

.checkbox {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 4px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 4px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 32px);
}

.checkbox {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.checkbox:hover .checkbox__indicator {
    --fsds-checkbox-color-border: var(--fsds-semantic-color-border-hover, #888889);
}

.checkbox__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border-width: 0;
}

.checkbox__indicator {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 16px;
    height: 16px;
    border-radius: var(--fsds-checkbox-border-radius, 4px);
    border-color: var(--fsds-checkbox-color-border, #a0a0a1);
    background-color: var(--fsds-checkbox-color-background, #ffffff);
    border-width: var(--fsds-checkbox-border-width, 1px);
}

.checkbox.is-checked .checkbox__indicator {
    --fsds-checkbox-color-background: var(--fsds-semantic-color-action-background-primary-default, #0566fe);
}

.checkbox.is-focus .checkbox__indicator {
    border-width: var(--fsds-checkbox-focus-ring-width, 2px);
    border-color: var(--fsds-checkbox-focus-ring-color, #0566fe);
}

.checkbox:disabled .checkbox__indicator {
    --fsds-checkbox-color-background: var(--fsds-semantic-color-background-disabled, #d0d0d0);
    --fsds-checkbox-color-mark: var(--fsds-semantic-color-foreground-disabled, #727272);
}

/* ToggleSwitch (.toggle-switch) */
.toggle-switch {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-action-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-action-size-medium-min-width, 32px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: var(--fsds-semantic-action-size-medium-min-height, 32px);
    --fsds-box-model-max-height: none;
    --fsds-toggle-switch-color-background-default: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-toggle-switch-color-foreground: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-toggle-switch-color-border: var(--fsds-semantic-color-border-default, #a0a0a1);
    --fsds-toggle-switch-border-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-toggle-switch-motion-duration-fast: var(--fsds-core-motion-duration-short, 150ms);
    --fsds-toggle-switch-color-background-hover: var(--fsds-semantic-interaction-background-hover, #f7f7f7);
    --fsds-toggle-switch-color-background-checked: var(--fsds-semantic-color-action-background-primary-default, #0566fe);
    --fsds-toggle-switch-color-background-disabled: var(--fsds-semantic-color-background-disabled, #d0d0d0);
    --fsds-toggle-switch-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-toggle-switch-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-toggle-switch-focus-ring-style: var(--fsds-semantic-focus-ring-style, solid);
    --fsds-toggle-switch-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
}

.toggle-switch {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 4px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 4px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 32px);
    min-height: var(--fsds-box-model-min-height, 32px);
}

.toggle-switch {
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: var(--fsds-toggle-switch-color-background-default, #f7f7f7);
    color: var(--fsds-toggle-switch-color-foreground, #141414);
    border-color: var(--fsds-toggle-switch-color-border, #a0a0a1);
    border-radius: var(--fsds-toggle-switch-border-radius, 9999px);
    border-width: 1px;
}

.toggle-switch:hover {
    background-color: var(--fsds-toggle-switch-color-background-hover, #f7f7f7);
}

.toggle-switch.is-checked {
    background-color: var(--fsds-toggle-switch-color-background-checked, #0566fe);
}

.toggle-switch:disabled {
    background-color: var(--fsds-toggle-switch-color-background-disabled, #d0d0d0);
}

.toggle-switch:focus {
    border-width: var(--fsds-toggle-switch-focus-ring-width, 2px);
    border-color: var(--fsds-toggle-switch-focus-ring-color, #0566fe);
}

/* Blockquote (.blockquote) */
.blockquote {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-blockquote-color-foreground-primary: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-blockquote-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-blockquote-color-border: var(--fsds-semantic-color-border-accent, #d92d2e);
    --fsds-blockquote-typography-font-style: var(--fsds-semantic-typography-font-style-italic, italic);
    --fsds-blockquote-typography-font-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-blockquote-size-padding: var(--fsds-core-spacing-size-05, 12px);
    --fsds-blockquote-size-padding-sm: var(--fsds-core-spacing-size-04, 8px);
    --fsds-blockquote-size-padding-lg: var(--fsds-core-spacing-size-07, 24px);
    --fsds-blockquote-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-blockquote-size-border-accent: var(--fsds-core-spacing-size-03, 4px);
    --fsds-blockquote-size-font-size-sm: var(--fsds-core-typography-ramp-3, 14px);
    --fsds-blockquote-size-font-size-md: var(--fsds-core-typography-ramp-4, 16px);
    --fsds-blockquote-size-font-size-lg: var(--fsds-core-typography-ramp-5, 18px);
}

.blockquote {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.blockquote {
    color: var(--fsds-blockquote-color-foreground-primary, #474647);
    background-color: var(--fsds-blockquote-color-background, #f7f7f7);
    border-color: var(--fsds-blockquote-color-border, #d92d2e);
    border-width: 0;
    border-radius: var(--fsds-blockquote-size-radius, 6px);
    padding: var(--fsds-blockquote-size-padding, 12px);
    font-size: var(--fsds-blockquote-size-font-size-md, 16px);
    margin: 0;
}

.blockquote.blockquote--default {
    --fsds-blockquote-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    border-width: 0;
}

.blockquote.blockquote--bordered {
    --fsds-blockquote-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-blockquote-size-padding: var(--fsds-core-spacing-size-05, 12px);
    border-left-width: var(--fsds-blockquote-size-border-accent, 4px);
    border-left-color: var(--fsds-blockquote-color-border, #d92d2e);
    padding-left: var(--fsds-blockquote-size-padding, 12px);
}

.blockquote.blockquote--highlighted {
    --fsds-blockquote-color-background: var(--fsds-semantic-color-background-accent-subtle, #95dafb);
    --fsds-blockquote-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
}

.blockquote.blockquote--sm {
    --fsds-blockquote-size-padding: var(--fsds-blockquote-size-padding-sm, 8px);
    --fsds-blockquote-size-font-size-md: var(--fsds-blockquote-size-font-size-sm, 14px);
    font-size: var(--fsds-blockquote-size-font-size-md, 16px);
    padding: var(--fsds-blockquote-size-padding, 12px);
}

.blockquote.blockquote--md {
    --fsds-blockquote-size-padding: var(--fsds-core-spacing-size-05, 12px);
    --fsds-blockquote-size-font-size-md: var(--fsds-core-typography-ramp-4, 16px);
    font-size: var(--fsds-blockquote-size-font-size-md, 16px);
    padding: var(--fsds-blockquote-size-padding, 12px);
}

.blockquote.blockquote--lg {
    --fsds-blockquote-size-padding: var(--fsds-blockquote-size-padding-lg, 24px);
    --fsds-blockquote-size-font-size-md: var(--fsds-blockquote-size-font-size-lg, 18px);
    font-size: var(--fsds-blockquote-size-font-size-md, 16px);
    padding: var(--fsds-blockquote-size-padding, 12px);
}

/* Stat (.stat) */
.stat {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-stat-color-foreground-value: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-stat-color-foreground-trend-up: var(--fsds-semantic-color-feedback-foreground-success-default, #497f21);
    --fsds-stat-color-foreground-trend-down: var(--fsds-semantic-color-feedback-foreground-danger-default, #d92d2e);
    --fsds-stat-color-foreground-trend-neutral: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-stat-size-value-sm: var(--fsds-semantic-typography-heading-04, 18px);
    --fsds-stat-size-value-md: var(--fsds-semantic-typography-heading-02, 24px);
    --fsds-stat-size-value-lg: var(--fsds-semantic-typography-heading-01, 32px);
    --fsds-stat-typography-line-height-value: 1.1;
    --fsds-stat-typography-weight-value: var(--fsds-semantic-typography-font-weight-bold, 700);
}

.stat {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.stat {
    display: flex;
    flex-direction: column;
    color: var(--fsds-stat-color-foreground-value, #141414);
    font-size: var(--fsds-stat-size-value-md, 24px);
    -unity-font-style: bold;
}

.stat.stat--up {
    color: var(--fsds-stat-color-foreground-trend-up, #497f21);
}

.stat.stat--down {
    color: var(--fsds-stat-color-foreground-trend-down, #d92d2e);
}

.stat.stat--neutral {
    color: var(--fsds-stat-color-foreground-trend-neutral, #474647);
}

.stat.stat--sm {
    font-size: var(--fsds-stat-size-value-sm, 18px);
}

.stat.stat--lg {
    font-size: var(--fsds-stat-size-value-lg, 32px);
}

/* ProfileFlag (.profile-flag) */
.profile-flag {
    --fsds-box-model-padding-block-start: 2px;
    --fsds-box-model-padding-block-end: 2px;
    --fsds-box-model-padding-inline-start: 4px;
    --fsds-box-model-padding-inline-end: 4px;
    --fsds-box-model-min-height: var(--fsds-semantic-glyph-size-medium-extent, 16px);
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-max-height: none;
    --fsds-profile-flag-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-profile-flag-color-border-default: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-profile-flag-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-profile-flag-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-profile-flag-spacing-gap: var(--fsds-core-spacing-size-03, 4px);
    --fsds-profile-flag-spacing-padding-right: var(--fsds-core-spacing-size-06, 16px);
    --fsds-profile-flag-color-border-hover: var(--fsds-semantic-color-border-bold, #888889);
}

.profile-flag {
    padding-top: var(--fsds-box-model-padding-block-start, 2px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 2px);
    padding-left: var(--fsds-box-model-padding-inline-start, 4px);
    padding-right: var(--fsds-box-model-padding-inline-end, 4px);
    min-height: var(--fsds-box-model-min-height, 16px);
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
}

.profile-flag {
    background-color: var(--fsds-profile-flag-color-background, #ffffff);
    border-color: var(--fsds-profile-flag-color-border-default, #d0d0d0);
    color: var(--fsds-profile-flag-color-foreground-primary, #141414);
    border-radius: var(--fsds-profile-flag-size-radius, 6px);
    --fsds-gap: var(--fsds-profile-flag-spacing-gap, 4px);
    padding: var(--fsds-profile-flag-spacing-padding-right, 16px);
}

.profile-flag:hover {
    border-color: var(--fsds-profile-flag-color-border-hover, #888889);
}

/* Badge (.badge) */
.badge {
    --fsds-box-model-padding-block-start: 2px;
    --fsds-box-model-padding-block-end: 2px;
    --fsds-box-model-padding-inline-start: 8px;
    --fsds-box-model-padding-inline-end: 8px;
    --fsds-box-model-min-height: var(--fsds-semantic-glyph-size-medium-extent, 16px);
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-max-height: none;
    --fsds-badge-color-background-default: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-badge-color-background-hover: var(--fsds-semantic-interaction-background-hover, #f7f7f7);
    --fsds-badge-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-badge-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-badge-spacing-gap: var(--fsds-semantic-glyph-badge-size-md-gap, 4px);
    --fsds-badge-size-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-badge-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-badge-size-padding-x: var(--fsds-semantic-glyph-badge-size-md-padding-x, 8px);
    --fsds-badge-size-padding-y: var(--fsds-semantic-glyph-badge-size-md-padding-y, 2px);
    --fsds-badge-size-font-size: var(--fsds-semantic-glyph-badge-size-md-font-size, 12px);
    --fsds-badge-size-min-height: var(--fsds-semantic-glyph-badge-size-md-min-height, 24px);
    --fsds-badge-text-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
}

.badge {
    padding-top: var(--fsds-box-model-padding-block-start, 2px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 2px);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    min-height: var(--fsds-box-model-min-height, 16px);
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
}

.badge {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    background-color: var(--fsds-badge-color-background-default, #f7f7f7);
    color: var(--fsds-badge-color-foreground-primary, #141414);
    border-color: var(--fsds-badge-color-border, #d0d0d0);
    border-width: var(--fsds-badge-size-border, 1px);
    border-radius: var(--fsds-badge-size-radius, 9999px);
    --fsds-gap: var(--fsds-badge-spacing-gap, 4px);
    padding-top: var(--fsds-badge-size-padding-y, 2px);
    padding-bottom: var(--fsds-badge-size-padding-y, 2px);
    padding-left: var(--fsds-badge-size-padding-x, 8px);
    padding-right: var(--fsds-badge-size-padding-x, 8px);
    min-height: var(--fsds-badge-size-min-height, 24px);
    font-size: var(--fsds-badge-size-font-size, 12px);
}

.badge__icon {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.badge__content {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
}

.badge:hover {
    background-color: var(--fsds-badge-color-background-hover, #f7f7f7);
}

.badge.badge--sm {
    --fsds-badge-size-padding-x: var(--fsds-semantic-glyph-badge-size-sm-padding-x, 4px);
    --fsds-badge-size-padding-y: var(--fsds-semantic-glyph-badge-size-sm-padding-y, 2px);
    --fsds-badge-size-font-size: var(--fsds-semantic-glyph-badge-size-sm-font-size, 10px);
    --fsds-badge-size-min-height: var(--fsds-semantic-glyph-badge-size-sm-min-height, 16px);
    --fsds-badge-spacing-gap: var(--fsds-semantic-glyph-badge-size-sm-gap, 2px);
}

.badge.badge--md {
    --fsds-badge-size-padding-x: var(--fsds-semantic-glyph-badge-size-md-padding-x, 8px);
    --fsds-badge-size-padding-y: var(--fsds-semantic-glyph-badge-size-md-padding-y, 2px);
    --fsds-badge-size-font-size: var(--fsds-semantic-glyph-badge-size-md-font-size, 12px);
    --fsds-badge-size-min-height: var(--fsds-semantic-glyph-badge-size-md-min-height, 24px);
    --fsds-badge-spacing-gap: var(--fsds-semantic-glyph-badge-size-md-gap, 4px);
}

.badge.badge--lg {
    --fsds-badge-size-padding-x: var(--fsds-semantic-glyph-badge-size-lg-padding-x, 12px);
    --fsds-badge-size-padding-y: var(--fsds-semantic-glyph-badge-size-lg-padding-y, 4px);
    --fsds-badge-size-font-size: var(--fsds-semantic-glyph-badge-size-lg-font-size, 14px);
    --fsds-badge-size-min-height: var(--fsds-semantic-glyph-badge-size-lg-min-height, 32px);
    --fsds-badge-spacing-gap: var(--fsds-semantic-glyph-badge-size-lg-gap, 4px);
}

.badge.badge--info {
    --fsds-badge-color-background-default: var(--fsds-semantic-color-background-info-subtle, #95dafb);
    --fsds-badge-color-background-hover: var(--fsds-semantic-color-background-info-subtle, #95dafb);
    --fsds-badge-color-foreground-primary: var(--fsds-semantic-color-foreground-on-info-subtle, #013ab0);
    --fsds-badge-color-border: var(--fsds-semantic-color-border-info, #034fd6);
}

.badge.badge--success {
    --fsds-badge-color-background-default: var(--fsds-semantic-color-background-success-subtle, #b3dba7);
    --fsds-badge-color-background-hover: var(--fsds-semantic-color-background-success-subtle, #b3dba7);
    --fsds-badge-color-foreground-primary: var(--fsds-semantic-color-foreground-on-success-subtle, #2c4f09);
    --fsds-badge-color-border: var(--fsds-semantic-color-border-success, #3a6614);
}

.badge.badge--warning {
    --fsds-badge-color-background-default: var(--fsds-semantic-color-background-warning-subtle, #fdc67f);
    --fsds-badge-color-background-hover: var(--fsds-semantic-color-background-warning-subtle, #fdc67f);
    --fsds-badge-color-foreground-primary: var(--fsds-semantic-color-foreground-on-warning-subtle, #6c3a00);
    --fsds-badge-color-border: var(--fsds-semantic-color-border-warning, #8b4b00);
}

.badge.badge--danger {
    --fsds-badge-color-background-default: var(--fsds-semantic-color-background-danger-subtle, #fac2c2);
    --fsds-badge-color-background-hover: var(--fsds-semantic-color-background-danger-subtle, #fac2c2);
    --fsds-badge-color-foreground-primary: var(--fsds-semantic-color-foreground-on-danger-subtle, #900909);
    --fsds-badge-color-border: var(--fsds-semantic-color-border-danger, #b31b1b);
}

.badge.badge--counter {
    --fsds-badge-color-background-default: var(--fsds-semantic-color-background-danger-strong, #b31b1b);
    --fsds-badge-color-foreground-primary: var(--fsds-semantic-color-foreground-inverse, #fafafa);
    --fsds-badge-color-border: var(--fsds-semantic-color-background-danger-strong, #b31b1b);
}

.badge.badge--tag {
    --fsds-badge-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
}

/* List (.list) */
.list {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-list-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-list-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-list-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-list-size-sm: var(--fsds-semantic-typography-body-03, 14px);
    --fsds-list-size-md: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-list-size-lg: var(--fsds-semantic-typography-body-01, 18px);
    --fsds-list-spacing-none: var(--fsds-core-spacing-size-00, 0px);
    --fsds-list-spacing-sm: var(--fsds-core-spacing-size-04, 8px);
    --fsds-list-spacing-md: var(--fsds-core-spacing-size-05, 12px);
    --fsds-list-spacing-lg: var(--fsds-core-spacing-size-07, 24px);
}

.list {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.list {
    color: var(--fsds-list-color-foreground-primary, #141414);
    border-color: var(--fsds-list-color-border, #d0d0d0);
    padding: var(--fsds-list-size-padding, 16px);
}

.list.list--size-sm {
    font-size: var(--fsds-list-size-sm, 14px);
}

.list.list--size-md {
    font-size: var(--fsds-list-size-md, 16px);
}

.list.list--size-lg {
    font-size: var(--fsds-list-size-lg, 18px);
}

.list.list--variant-unstyled {
    padding: 0;
    margin: 0;
}

.list.list--variant-inline {
    display: flex;
    flex-direction: row;
    --fsds-gap: var(--fsds-list-spacing-md, 12px);
}
