    --fsds-semantic-color-foreground-on-brand: #ffffff;
    --fsds-semantic-color-foreground-primary: #fafafa;
    --fsds-semantic-color-foreground-secondary: #a0a0a1;
    --fsds-semantic-color-foreground-tertiary: #888889;
    --fsds-semantic-focus-ring-color: #1a94ba;
    --fsds-semantic-interaction-background-hover: #474647;
}

/* Brand monochrome */
.fsds-theme.fsds-brand-monochrome {
    --fsds-semantic-color-background-disabled: #d0d0d0;
    --fsds-semantic-color-background-elevated: #ffffff;
    --fsds-semantic-color-background-hover: #f7f7f7;
    --fsds-semantic-color-background-primary: #ffffff;
    --fsds-semantic-color-background-secondary: #f7f7f7;
    --fsds-semantic-color-background-tertiary: #d0d0d0;
    --fsds-semantic-color-border-accent: #474647;
    --fsds-semantic-color-border-subtle: #d0d0d0;
    --fsds-semantic-color-foreground-accent: #474647;
    --fsds-semantic-color-foreground-disabled: #727272;
    --fsds-semantic-color-foreground-on-brand: #ffffff;
    --fsds-semantic-color-foreground-primary: #141414;
    --fsds-semantic-color-foreground-secondary: #313131;
    --fsds-semantic-color-foreground-tertiary: #5c5b5c;
    --fsds-semantic-focus-ring-color: #727272;
    --fsds-semantic-focus-ring-offset: 2px;
    --fsds-semantic-focus-ring-style: solid;
    --fsds-semantic-focus-ring-width: 2px;
    --fsds-semantic-interaction-background-hover: #f7f7f7;
    --fsds-semantic-interaction-disabled-opacity: 0.24;
    --fsds-semantic-shape-control-border-default-width: 2px;
    --fsds-semantic-shape-control-radius-default: 0px;
    --fsds-semantic-shape-radius-small: 2px;
}

.fsds-theme.fsds-brand-monochrome.fsds-theme--dark {
