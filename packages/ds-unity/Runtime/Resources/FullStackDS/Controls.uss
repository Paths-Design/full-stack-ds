    flex-direction: column;
    border-radius: var(--fsds-breadcrumbs-shape-radius-medium, 6px);
    padding: var(--fsds-breadcrumbs-spacing-padding, 8px);
    color: var(--fsds-breadcrumbs-color-foreground-primary, #141414);
}

.breadcrumbs:focus {
    border-color: var(--fsds-breadcrumbs-color-focus, #0566fe);
}

.breadcrumbs__list {
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    --fsds-gap: var(--fsds-breadcrumbs-spacing-gap, 8px);
}

/* Tooltip (.tooltip) */
.tooltip {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
