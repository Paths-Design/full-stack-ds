/* Unity pilot theme authority. These defaults are not a projection of the
   complete Web token graph. Component selectors target the generated contract
   part classes (<prefix>__<part>), root modifiers (<prefix>--<value>)
   and behavior state classes (is-checked, is-open, is-selected). */
.fsds-theme {
    --fsds-text: #eef1f7;
    --fsds-muted-text: #b9c3d4;
    --fsds-background: #171d29;
    --fsds-surface: #222b3a;
    --fsds-hover: #303d51;
    --fsds-border: #53647d;
    --fsds-accent: #295bb5;
    --fsds-focus: #a9ceff;
}

/* Switch: label root > [input (native activation + focus ring), track > thumb, children]. */
.switch {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 6px 0;
}
.fsds-theme .switch__input {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    min-height: 0;
    padding: 0;
    background-color: transparent;
    border-color: transparent;
}
.fsds-theme .switch__input:hover { background-color: var(--fsds-surface); }
.fsds-theme .switch__input:focus { border-color: var(--fsds-focus); }
.switch__track {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--fsds-border);
    border-radius: 16px;
    padding: 3px;
    margin-left: 4px;
    margin-right: 12px;
}
.switch.is-checked .switch__track {
    background-color: var(--fsds-accent);
    justify-content: flex-end;
}
.switch__thumb { flex-shrink: 0; background-color: #ffffff; border-radius: 12px; }
.switch__children { flex-shrink: 1; flex-grow: 1; }

/* Accordion: item > [header > trigger > [children, chevron], content > contentInner]. */
.accordion__item { margin-bottom: 8px; min-width: 0; }
.fsds-theme .accordion__trigger { flex-direction: row; align-items: center; }
.fsds-theme .accordion__trigger.is-open { background-color: var(--fsds-surface); border-color: var(--fsds-focus); }
.accordion__children { flex-grow: 1; flex-shrink: 1; }
/* Placeholder for the Icon componentRef until the iconography catalog is ported. */
.accordion__chevron {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin-left: 16px;
    margin-right: 4px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--fsds-text);
    rotate: 45deg;
}
.accordion__trigger.is-open .accordion__chevron { rotate: 225deg; }
.accordion__contentInner { padding: 12px; }

/* Tabs: [list > [children > tab..., indicator], panel...]. Composed tabs live in the children host. */
.tabs__list { margin-bottom: 8px; }
.tabs__children { flex-direction: row; flex-wrap: wrap; }
.tabs__indicator { position: absolute; height: 0; }
.tabs--vertical { flex-direction: row; }
.tabs--vertical .tabs__list { margin-right: 8px; }
.tabs--vertical .tabs__children { flex-direction: column; flex-wrap: nowrap; }
.fsds-theme .tabs__tab { margin-right: 6px; margin-bottom: 6px; }
.fsds-theme .tabs__tab.is-selected { background-color: var(--fsds-accent); }
.fsds-theme .tabs--underline .tabs__tab.is-selected { border-bottom-width: 3px; }
.fsds-theme .tabs--pills .tabs__tab { border-radius: 20px; }
.tabs__panel { padding: 12px; flex-grow: 1; }

/* Popover content floats at the panel root while open. */
.popover__content {
    position: absolute;
    background-color: var(--fsds-surface);
    border-width: 1px;
    border-color: var(--fsds-border);
    border-radius: 8px;
    min-width: 0;
    width: 320px;
    overflow: hidden;
}
.popover__content .unity-scroll-view__content-container { padding: 16px; }
