    --fsds-tooltip-color-background: var(--fsds-semantic-color-background-inverse, #141414);
    --fsds-tooltip-color-foreground: var(--fsds-semantic-color-foreground-on-inverse, #fafafa);
    --fsds-tooltip-color-border: var(--fsds-semantic-color-border-subtle, #d0d0d0);
    --fsds-tooltip-size-padding-x: var(--fsds-core-spacing-size-04, 8px);
    --fsds-tooltip-size-radius: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-tooltip-size-max-width: 200px;
    --fsds-tooltip-typography-font-size: var(--fsds-semantic-typography-caption-01, 14px);
    --fsds-tooltip-layer-content: var(--fsds-core-layer-tooltip, 1800);
}

.tooltip {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.tooltip {
    display: flex;
    flex-direction: column;
}

.tooltip__trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.tooltip__content {
    background-color: var(--fsds-tooltip-color-background, #141414);
    color: var(--fsds-tooltip-color-foreground, #fafafa);
    border-color: var(--fsds-tooltip-color-border, #d0d0d0);
    border-radius: var(--fsds-tooltip-size-radius, 4px);
    padding: var(--fsds-tooltip-size-padding-x, 8px);
    max-width: var(--fsds-tooltip-size-max-width, 200px);
    font-size: var(--fsds-tooltip-typography-font-size, 14px);
    display: flex;
    flex-direction: column;
    border-width: 1px;
}

.tooltip__content {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-tooltip-color-background: var(--fsds-semantic-color-background-inverse, #141414);
    --fsds-tooltip-color-foreground: var(--fsds-semantic-color-foreground-on-inverse, #fafafa);
    --fsds-tooltip-color-border: var(--fsds-semantic-color-border-subtle, #d0d0d0);
    --fsds-tooltip-size-padding-x: var(--fsds-core-spacing-size-04, 8px);
    --fsds-tooltip-size-radius: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-tooltip-size-max-width: 200px;
    --fsds-tooltip-typography-font-size: var(--fsds-semantic-typography-caption-01, 14px);
    --fsds-tooltip-layer-content: var(--fsds-core-layer-tooltip, 1800);
}

/* Status (.status) */
.status {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-glyph-badge-size-md-padding-y, 2px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-glyph-badge-size-md-padding-y, 2px);
