/* Unity pilot theme authority. These defaults are not a projection of the
   complete Web token graph. Component selectors target the generated contract
   part classes (<prefix>__<part>), root modifiers (<prefix>--<value>)
   and behavior state classes (is-checked, is-open, is-selected). */
.fsds-theme {
    --fsds-text: #eef1f7;
    --fsds-muted-text: #b9c3d4;
    --fsds-background: #171d29;
    --fsds-surface: #222b3a;
    --fsds-hover: #303d51;
    --fsds-border: #53647d;
    --fsds-accent: #295bb5;
    --fsds-focus: #a9ceff;
    color: var(--fsds-text);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
    flex-shrink: 0;
    min-width: 0;
}
.fsds-theme .unity-text-element {
    color: var(--fsds-text);
    font-size: 16px;
    -unity-font-style: normal;
    white-space: normal;
    min-width: 0;
}
.fsds-theme .unity-label { margin: 0; padding: 0; }
.fsds-theme .unity-button {
    color: var(--fsds-text);
    background-color: var(--fsds-surface);
    background-image: none;
    font-size: 16px;
    min-height: 40px;
    flex-shrink: 0;
    margin: 0;
    padding: 8px 12px;
    border-width: 1px;
    border-color: var(--fsds-border);
    border-radius: 6px;
    -unity-text-align: middle-left;
    white-space: normal;
}
.fsds-theme .unity-button:hover { background-color: var(--fsds-hover); }
.fsds-theme .unity-button:active { background-color: var(--fsds-accent); }
.fsds-theme .unity-button:focus { border-width: 2px; border-color: var(--fsds-focus); }
.fsds-theme .unity-button:disabled { opacity: 0.5; }

/* Switch: label root > [input (native activation + focus ring), track > thumb, children]. */
.switch {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 6px 0;
}
.fsds-theme .switch__input {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    min-height: 0;
    padding: 0;
    background-color: transparent;
    border-color: transparent;
}
.fsds-theme .switch__input:hover { background-color: var(--fsds-surface); }
.fsds-theme .switch__input:focus { border-color: var(--fsds-focus); }
.switch__track {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--fsds-border);
    border-radius: 16px;
    padding: 3px;
    margin-left: 4px;
    margin-right: 12px;
}
.switch.is-checked .switch__track {
    background-color: var(--fsds-accent);
    justify-content: flex-end;
}
.switch__thumb { flex-shrink: 0; background-color: #ffffff; border-radius: 12px; }
.switch__children { flex-shrink: 1; flex-grow: 1; }

/* Accordion: item > [header > trigger > [children, chevron], content > contentInner]. */
.accordion__item { margin-bottom: 8px; min-width: 0; }
.fsds-theme .accordion__trigger { flex-direction: row; align-items: center; }
.fsds-theme .accordion__trigger.is-open { background-color: var(--fsds-surface); border-color: var(--fsds-focus); }
.accordion__children { flex-grow: 1; flex-shrink: 1; }
/* Placeholder for the Icon componentRef until the iconography catalog is ported. */
.accordion__chevron {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin-left: 16px;
    margin-right: 4px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: var(--fsds-text);
    rotate: 45deg;
}
.accordion__trigger.is-open .accordion__chevron { rotate: 225deg; }
.accordion__contentInner { padding: 12px; }

/* Tabs: [list > [indicator, tab...], panel...]. */
.tabs__list { flex-direction: row; margin-bottom: 8px; flex-wrap: wrap; }
.tabs__indicator { position: absolute; height: 0; }
.tabs--vertical { flex-direction: row; }
.tabs--vertical .tabs__list { flex-direction: column; margin-right: 8px; }
.fsds-theme .tabs__tab { margin-right: 6px; margin-bottom: 6px; }
.fsds-theme .tabs__tab.is-selected { background-color: var(--fsds-accent); }
.fsds-theme .tabs--underline .tabs__tab.is-selected { border-bottom-width: 3px; }
.fsds-theme .tabs--pills .tabs__tab { border-radius: 20px; }
.tabs__panel { padding: 12px; flex-grow: 1; }

/* Popover content floats at the panel root while open. */
.popover__content {
    position: absolute;
    background-color: var(--fsds-surface);
    border-width: 1px;
    border-color: var(--fsds-border);
    border-radius: 8px;
    min-width: 0;
    width: 320px;
    overflow: hidden;
}
.popover__content .unity-scroll-view__content-container { padding: 16px; }
.popover__content .unity-button { margin-top: 12px; }
.popover__content .unity-label { flex-shrink: 1; white-space: normal; }

.fsds-sample {
    height: 100%;
    flex-shrink: 1;
    background-color: var(--fsds-background);
    padding: 24px;
    flex-grow: 1;
    min-width: 0;
}
.fsds-sample-body { max-width: 640px; align-self: stretch; min-width: 0; }
.fsds-theme .fsds-sample-title { font-size: 24px; -unity-font-style: bold; margin-bottom: 8px; }
.fsds-theme .fsds-sample-description { color: var(--fsds-muted-text); margin-bottom: 24px; }
.fsds-sample-section { margin-top: 20px; }

.fsds-theme .unity-scroller { background-color: var(--fsds-background); }
.fsds-theme .unity-base-slider__tracker { background-color: var(--fsds-background); }
.fsds-theme .unity-base-slider__dragger { background-color: var(--fsds-border); border-width: 0; border-radius: 6px; }

.fsds-theme .unity-scroller__low-button, .fsds-theme .unity-scroller__high-button { background-color: var(--fsds-border); }
