    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.status {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    background-color: var(--fsds-status-color-background, #f7f7f7);
    color: var(--fsds-status-color-foreground-primary, #474647);
    border-color: var(--fsds-status-color-border, #d0d0d0);
    border-width: var(--fsds-status-size-border, 1px);
    border-radius: var(--fsds-status-size-radius, 9999px);
    min-height: var(--fsds-status-size-min-height, 24px);
    font-size: var(--fsds-status-size-font-size, 12px);
}

.status__icon {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.status__label {
    display: flex;
    flex-direction: column;
    color: var(--fsds-status-color-foreground-primary, #474647);
}

.status.status--info {
    --fsds-status-color-background: var(--fsds-semantic-color-background-info-subtle, #95dafb);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-info-subtle, #013ab0);
    --fsds-status-color-border: var(--fsds-semantic-color-border-info, #034fd6);
}

.status.status--success {
    --fsds-status-color-background: var(--fsds-semantic-color-background-success-subtle, #b3dba7);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-success-subtle, #2c4f09);
    --fsds-status-color-border: var(--fsds-semantic-color-border-success, #3a6614);
}

.status.status--warning {
    --fsds-status-color-background: var(--fsds-semantic-color-background-warning-subtle, #fdc67f);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-warning-subtle, #6c3a00);
    --fsds-status-color-border: var(--fsds-semantic-color-border-warning, #8b4b00);
}

.status.status--danger {
    --fsds-status-color-background: var(--fsds-semantic-color-background-danger-subtle, #fac2c2);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-danger-subtle, #900909);
    --fsds-status-color-border: var(--fsds-semantic-color-border-danger, #b31b1b);
}

.status.status--error {
    --fsds-status-color-background: var(--fsds-semantic-color-background-danger-subtle, #fac2c2);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-danger-subtle, #900909);
    --fsds-status-color-border: var(--fsds-semantic-color-border-danger, #b31b1b);
}

/* Card (.card) */
.card {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-card-color-background-default: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-card-color-background-hover: var(--fsds-semantic-color-background-hover, #f7f7f7);
    --fsds-card-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-card-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-card-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-card-size-padding-inset: var(--fsds-core-spacing-size-04, 8px);
    --fsds-card-size-radius: var(--fsds-semantic-shape-radius-medium, 8px);
    --fsds-card-size-gap: var(--fsds-core-spacing-size-03, 4px);
    --fsds-card-typography-line-height-heading: var(--fsds-semantic-typography-line-height-heading, 1);
    --fsds-card-typography-line-height-normal: var(--fsds-semantic-typography-line-height-normal, 1.5);
    --fsds-card-color-focus-ring: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-card-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-card-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
}

.card {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.card {
    background-color: var(--fsds-card-color-background-default, #ffffff);
    border-color: var(--fsds-card-color-border, #d0d0d0);
    color: var(--fsds-card-color-foreground-primary, #141414);
    padding: var(--fsds-card-size-padding, 16px);
    border-radius: var(--fsds-card-size-radius, 8px);
    --fsds-gap: var(--fsds-card-size-gap, 4px);
    display: flex;
    flex-direction: column;
    border-width: 1px;
}

.card:focus {
    border-width: var(--fsds-card-focus-ring-width, 2px);
    border-color: var(--fsds-card-color-focus-ring, #0566fe);
}

.card.card--inset {
    padding: var(--fsds-card-size-padding-inset, 8px);
}

.card__header {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    --fsds-gap: var(--fsds-card-size-gap, 4px);
    color: var(--fsds-card-color-foreground-primary, #141414);
}

.card__media {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border-radius: var(--fsds-card-size-radius, 8px);
}

.card__content {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-card-size-gap, 4px);
    flex: 1 1 auto;
    color: var(--fsds-card-color-foreground-primary, #141414);
}

.card__description {
    margin: 0;
    --fsds-card-color-foreground-primary: var(--fsds-semantic-color-foreground-secondary, #474647);
}

.card__footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    --fsds-gap: var(--fsds-card-size-gap, 4px);
    padding-top: var(--fsds-card-size-padding, 16px);
    margin-top: auto;
    border-top-color: var(--fsds-card-color-border, #d0d0d0);
    border-top-width: 1px;
}

.card__actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-card-size-gap, 4px);
}

.card__badge {
    display: flex;
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
}

.card__link {
    --fsds-card-color-foreground-primary: var(--fsds-semantic-color-foreground-link, #d92d2e);
}

.card__note {
    --fsds-card-color-foreground-primary: var(--fsds-semantic-color-foreground-secondary, #474647);
}

/* NavList (.nav-list) */
.nav-list {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-nav-list-color-foreground-default: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-nav-list-color-foreground-hover: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-nav-list-color-foreground-current: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-nav-list-color-background-default: var(--fsds-semantic-color-background-transparent, rgba(0, 0, 0, 0));
    --fsds-nav-list-color-background-hover: var(--fsds-semantic-color-background-subtle, #f7f7f7);
    --fsds-nav-list-state-layer-hover: var(--fsds-semantic-interaction-state-layer-hover, 0.04);
    --fsds-nav-list-state-layer-selected: var(--fsds-semantic-interaction-state-layer-selected, 0.08);
    --fsds-nav-list-color-outline-focus: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-nav-list-size-padding-block: var(--fsds-core-spacing-size-02, 2px);
    --fsds-nav-list-size-padding-inline: var(--fsds-core-spacing-size-04, 8px);
    --fsds-nav-list-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-nav-list-size-gap-list: var(--fsds-core-spacing-size-01, 1px);
}

.nav-list {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.nav-list {
    display: flex;
    flex-direction: column;
}

.nav-list__list {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-nav-list-size-gap-list, 1px);
    margin: 0;
    padding: 0;
}

.nav-list__item {
    display: flex;
    flex-direction: column;
    color: var(--fsds-nav-list-color-foreground-default, #474647);
    padding-top: var(--fsds-nav-list-size-padding-block, 2px);
    padding-bottom: var(--fsds-nav-list-size-padding-block, 2px);
    padding-left: var(--fsds-nav-list-size-padding-inline, 8px);
    padding-right: var(--fsds-nav-list-size-padding-inline, 8px);
    border-radius: var(--fsds-nav-list-size-radius, 6px);
}

.nav-list__item:hover {
    color: var(--fsds-nav-list-color-foreground-hover, #141414);
}

.nav-list__item:focus {
    border-width: var(--fsds-semantic-focus-ring-width, 2px);
    border-color: var(--fsds-nav-list-color-outline-focus, #0566fe);
}

/* Skeleton (.skeleton) */
.skeleton {
    --fsds-box-model-width: 100%;
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-max-height: none;
    --fsds-skeleton-color-base: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-skeleton-color-highlight: var(--fsds-semantic-color-background-highlight, #f5a2a1);
    --fsds-skeleton-radius-sm: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    --fsds-skeleton-gap-compact: var(--fsds-core-spacing-size-03, 4px);
    --fsds-skeleton-gap-md: var(--fsds-core-spacing-size-05, 12px);
    --fsds-skeleton-gap-spacious: var(--fsds-core-spacing-size-07, 24px);
    --fsds-skeleton-anim-duration: var(--fsds-core-motion-duration-long, 400ms);
    --fsds-skeleton-shape-height-text: var(--fsds-core-typography-ramp-4, 16px);
}

.skeleton {
    width: var(--fsds-box-model-width, 100%);
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    display: flex;
    flex-direction: column;
}

.skeleton {
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-skeleton-color-base, #f7f7f7);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton__shape {
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-skeleton-color-base, #f7f7f7);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton__stack {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-skeleton-gap-md, 12px);
}

.skeleton.skeleton--block {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton.skeleton--text {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-skeleton-shape-height-text: var(--fsds-core-typography-ramp-4, 16px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton.skeleton--avatar {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton.skeleton--media {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
    width: 100%;
}

.skeleton.skeleton--dataviz {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
    width: 100%;
}

.skeleton.skeleton--actions {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
    height: 36px;
    min-width: 80px;
}

.skeleton.skeleton--wipe {
    --fsds-skeleton-color-base: var(--fsds-semantic-color-background-tertiary, #d0d0d0);
    overflow: hidden;
    position: relative;
}

.skeleton.skeleton--compact {
    --fsds-skeleton-gap-md: var(--fsds-skeleton-gap-compact, 4px);
}

.skeleton.skeleton--regular {
    --fsds-skeleton-gap-md: var(--fsds-core-spacing-size-05, 12px);
}

.skeleton.skeleton--spacious {
    --fsds-skeleton-gap-md: var(--fsds-skeleton-gap-spacious, 24px);
}

/* Table (.table) */
.table {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-table-color-text: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-table-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-table-color-background-footer: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-table-border-width: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-table-spacing-cell-x: var(--fsds-core-spacing-size-03, 4px);
    --fsds-table-spacing-cell-y: var(--fsds-core-spacing-size-02, 2px);
    --fsds-table-spacing-caption: var(--fsds-core-spacing-size-04, 8px);
    --fsds-table-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-table-text-size: var(--fsds-semantic-typography-body-03, 14px);
    --fsds-table-text-line-height: var(--fsds-semantic-typography-line-height-normal, 1.5);
    --fsds-table-text-size-caption: var(--fsds-semantic-typography-body-04, 12px);
    --fsds-table-text-weight-head: var(--fsds-semantic-typography-font-weight-bold, 700);
    --fsds-table-text-weight-footer: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-table-color-background-hover: var(--fsds-semantic-interaction-background-hover, #f7f7f7);
    --fsds-table-color-background-selected: var(--fsds-semantic-color-background-accent-subtle, #95dafb);
}

.table {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.table {
    color: var(--fsds-table-color-text, #141414);
    font-size: var(--fsds-table-text-size, 14px);
    width: 100%;
}

.table__container {
    border-color: var(--fsds-table-color-border, #d0d0d0);
    border-width: var(--fsds-table-border-width, 1px);
    border-radius: var(--fsds-table-size-radius, 6px);
    width: 100%;
}

.table__caption {
    font-size: var(--fsds-table-text-size-caption, 12px);
    padding-bottom: var(--fsds-table-spacing-caption, 8px);
}

.table__head {
    background-color: var(--fsds-table-color-background-footer, #f7f7f7);
}

.table__footer {
    background-color: var(--fsds-table-color-background-footer, #f7f7f7);
}

.table__headerCell {
    -unity-font-style: bold;
    color: var(--fsds-table-color-text, #141414);
    padding-left: var(--fsds-table-spacing-cell-x, 4px);
    padding-right: var(--fsds-table-spacing-cell-x, 4px);
    padding-top: var(--fsds-table-spacing-cell-y, 2px);
    padding-bottom: var(--fsds-table-spacing-cell-y, 2px);
    border-bottom-width: var(--fsds-table-border-width, 1px);
    border-bottom-color: var(--fsds-table-color-border, #d0d0d0);
}

.table__cell {
    padding-left: var(--fsds-table-spacing-cell-x, 4px);
    padding-right: var(--fsds-table-spacing-cell-x, 4px);
    padding-top: var(--fsds-table-spacing-cell-y, 2px);
    padding-bottom: var(--fsds-table-spacing-cell-y, 2px);
    border-bottom-width: var(--fsds-table-border-width, 1px);
    border-bottom-color: var(--fsds-table-color-border, #d0d0d0);
}

.table:hover {
    background-color: var(--fsds-table-color-background-hover, #f7f7f7);
}

/* CodeBlock (.code-block) */
.code-block {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-code-block-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-code-block-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-code-block-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-code-block-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-code-block-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-code-block-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-code-block-size-font-size: var(--fsds-core-typography-ramp-3, 14px);
    --fsds-code-block-typography-line-height: var(--fsds-semantic-typography-line-height-body, 1.5);
    --fsds-code-block-token-color-plain: var(--fsds-semantic-color-foreground-syntax-plain, #141414);
    --fsds-code-block-token-color-comment: var(--fsds-semantic-color-foreground-syntax-comment-color, #474647);
    --fsds-code-block-token-color-keyword: var(--fsds-semantic-color-foreground-syntax-keyword, #013ab0);
    --fsds-code-block-token-color-definition: var(--fsds-semantic-color-foreground-syntax-definition, #900909);
    --fsds-code-block-token-color-punctuation: var(--fsds-semantic-color-foreground-syntax-punctuation, #013ab0);
    --fsds-code-block-token-color-property: var(--fsds-semantic-color-foreground-syntax-property, #6c3a00);
    --fsds-code-block-token-color-static: var(--fsds-semantic-color-foreground-syntax-static, #900909);
    --fsds-code-block-token-color-string: var(--fsds-semantic-color-foreground-syntax-string, #900909);
    --fsds-code-block-token-color-tag: var(--fsds-semantic-color-foreground-syntax-tag, #900909);
    --fsds-code-block-gutter-color-number: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-code-block-gutter-size-gap: var(--fsds-core-spacing-size-03, 4px);
}

.code-block {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.code-block {
    background-color: var(--fsds-code-block-color-background, #f7f7f7);
    border-color: var(--fsds-code-block-color-border, #d0d0d0);
    border-width: var(--fsds-code-block-size-border, 1px);
    border-radius: var(--fsds-code-block-size-radius, 6px);
    color: var(--fsds-code-block-color-foreground-primary, #141414);
    font-size: var(--fsds-code-block-size-font-size, 14px);
    margin: 0;
    padding: var(--fsds-code-block-size-padding, 16px);
}

.code-block__code {
    display: flex;
    flex-direction: column;
}

.code-block__code > .code-block__children {
    display: flex;
    flex-direction: column;
}

.code-block__gutter {
    display: none;
}

/* Details (.details) */
.details {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-details-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-details-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-details-size-icon: var(--fsds-core-spacing-size-05, 12px);
    --fsds-details-color-background-default: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-details-color-background-hover: var(--fsds-semantic-color-background-hover, #f7f7f7);
    --fsds-details-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-details-color-border-default: var(--fsds-semantic-color-border-primary, #a0a0a1);
    --fsds-details-color-border-hover: var(--fsds-semantic-color-border-bold, #888889);
    --fsds-details-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-details-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-details-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
    --fsds-details-spacing-gap: var(--fsds-core-spacing-size-02, 2px);
    --fsds-details-typography-line-height-body: var(--fsds-semantic-typography-line-height-body, 1.5);
    --fsds-details-typography-font-weight-medium: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-details-size-padding-compact: var(--fsds-core-spacing-size-04, 8px);
}

.details {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.details {
    padding: var(--fsds-details-size-padding, 16px);
    border-radius: var(--fsds-details-size-radius, 6px);
    background-color: var(--fsds-details-color-background-default, #ffffff);
    --fsds-gap: var(--fsds-details-spacing-gap, 2px);
    display: flex;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--fsds-details-color-border-default, #a0a0a1);
    color: var(--fsds-details-color-foreground-primary, #141414);
}

.details:hover {
    background-color: var(--fsds-details-color-background-hover, #f7f7f7);
    border-color: var(--fsds-details-color-border-hover, #888889);
}

.details__summary {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-details-spacing-gap, 2px);
    padding: var(--fsds-details-size-padding, 16px);
    color: var(--fsds-details-color-foreground-primary, #141414);
}

.details__summary:hover {
    --fsds-details-color-background-default: var(--fsds-semantic-color-background-hover, #f7f7f7);
}

.details__summary:focus {
    border-width: var(--fsds-details-focus-ring-width, 2px);
    border-color: var(--fsds-details-focus-ring-color, #0566fe);
}

.details__summaryContent {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-details-spacing-gap, 2px);
    flex: 1 1 auto;
}

.details__summaryText {
    flex: 1 1 auto;
    color: var(--fsds-details-color-foreground-primary, #141414);
}

.details__icon {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    width: var(--fsds-details-size-icon, 12px);
    height: var(--fsds-details-size-icon, 12px);
    align-items: center;
    justify-content: center;
}

.details__content {
    display: flex;
    flex-direction: column;
    padding: var(--fsds-details-size-padding, 16px);
    color: var(--fsds-details-color-foreground-primary, #141414);
}

.details.details--compact {
    --fsds-details-size-padding: var(--fsds-details-size-padding-compact, 8px);
    --fsds-details-typography-line-height-body: var(--fsds-core-spacing-size-06, 16px);
}

.details.details--inline {
    --fsds-details-size-padding: var(--fsds-core-spacing-size-07, 24px);
    --fsds-details-color-background-default: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-details-color-border-default: var(--fsds-semantic-color-border-subtle, #d0d0d0);
}

.details--none .details__icon {
    display: none;
}

.details--right .details__icon {
    margin-left: auto;
}

/* Progress (.progress) */
.progress {
    --fsds-box-model-width: 100%;
    --fsds-box-model-height: 8px;
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-progress-color-text: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-progress-spacing-gap: var(--fsds-core-spacing-size-02, 2px);
    --fsds-progress-motion-duration-indeterminate: var(--fsds-core-motion-duration-extra-long1, 1500ms);
    --fsds-progress-color-track-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-progress-color-fill-info: var(--fsds-semantic-color-status-info, #0566fe);
    --fsds-progress-color-fill-success: var(--fsds-semantic-color-status-success, #497f21);
    --fsds-progress-color-fill-warning: var(--fsds-semantic-color-status-warning, #ae5d00);
    --fsds-progress-color-fill-danger: var(--fsds-semantic-color-status-danger, #d92d2e);
}

.progress {
    width: var(--fsds-box-model-width, 100%);
    height: var(--fsds-box-model-height, 8px);
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
    display: flex;
    flex-direction: column;
}

.progress {
    color: var(--fsds-progress-color-text, #474647);
    --fsds-gap: var(--fsds-progress-spacing-gap, 2px);
}

.progress__track {
    background-color: var(--fsds-progress-color-track-background, #f7f7f7);
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.progress__fill {
    background-color: var(--fsds-progress-color-fill-info, #0566fe);
    display: flex;
    flex-direction: column;
    height: 100%;
}

.progress__value {
    display: flex;
    flex-direction: column;
    color: var(--fsds-progress-color-text, #474647);
    margin-left: var(--fsds-progress-spacing-gap, 2px);
}

.progress--info .progress__fill {
    background-color: var(--fsds-progress-color-fill-info, #0566fe);
}

.progress--success .progress__fill {
    background-color: var(--fsds-progress-color-fill-success, #497f21);
}

.progress--warning .progress__fill {
    background-color: var(--fsds-progress-color-fill-warning, #ae5d00);
}

.progress--danger .progress__fill {
    background-color: var(--fsds-progress-color-fill-danger, #d92d2e);
}

/* Chip (.chip) */
.chip {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-chip-color-background-default: var(--fsds-semantic-color-action-background-secondary-default, #fafafa);
    --fsds-chip-color-background-hover: var(--fsds-semantic-color-action-background-secondary-hover, #d0d0d0);
    --fsds-chip-color-foreground-default: var(--fsds-semantic-color-action-foreground-secondary-default, #141414);
    --fsds-chip-color-border-default: var(--fsds-semantic-color-action-border-secondary-default, #a0a0a1);
    --fsds-chip-size-padding-horizontal: var(--fsds-core-spacing-size-04, 8px);
    --fsds-chip-size-padding-vertical: var(--fsds-core-spacing-size-02, 2px);
    --fsds-chip-size-gap: var(--fsds-core-spacing-size-02, 2px);
    --fsds-chip-size-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-chip-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-chip-text-size: var(--fsds-semantic-typography-body-04, 12px);
    --fsds-chip-text-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-chip-motion-duration-fast: var(--fsds-core-motion-duration-short, 150ms);
    --fsds-chip-size-min-height: var(--fsds-core-dimension-action-min-height, 36px);
    --fsds-chip-color-background-selected: var(--fsds-semantic-color-background-info-subtle, #95dafb);
    --fsds-chip-color-foreground-selected: var(--fsds-semantic-color-foreground-on-info-subtle, #013ab0);
    --fsds-chip-color-border-selected: var(--fsds-semantic-color-border-info, #034fd6);
    --fsds-chip-dismiss-size: var(--fsds-core-spacing-size-05, 12px);
    --fsds-chip-dismiss-gap: var(--fsds-core-spacing-size-02, 2px);
}

.chip {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    white-space: nowrap;
    background-color: var(--fsds-chip-color-background-default, #fafafa);
    color: var(--fsds-chip-color-foreground-default, #141414);
    border-color: var(--fsds-chip-color-border-default, #a0a0a1);
    border-width: var(--fsds-chip-size-border, 1px);
    padding-top: var(--fsds-chip-size-padding-vertical, 2px);
    padding-bottom: var(--fsds-chip-size-padding-vertical, 2px);
    padding-left: var(--fsds-chip-size-padding-horizontal, 8px);
    padding-right: var(--fsds-chip-size-padding-horizontal, 8px);
    --fsds-gap: var(--fsds-chip-size-gap, 2px);
    border-radius: var(--fsds-chip-size-radius, 9999px);
    min-height: var(--fsds-chip-size-min-height, 36px);
    font-size: var(--fsds-chip-text-size, 12px);
}

.chip:hover {
    background-color: var(--fsds-chip-color-background-hover, #d0d0d0);
}

.chip__action {
    flex: 1 1 auto;
    min-width: 0;
}

.chip__dismiss {
    flex: 0 0 auto;
    margin-left: var(--fsds-chip-dismiss-gap, 2px);
}

.chip__icon {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 2px;
}

.chip__text {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    font-size: var(--fsds-chip-text-size, 12px);
}

.chip.chip--selected {
    --fsds-chip-color-background-default: var(--fsds-chip-color-background-selected, #95dafb);
    --fsds-chip-color-foreground-default: var(--fsds-chip-color-foreground-selected, #013ab0);
    --fsds-chip-color-border-default: var(--fsds-chip-color-border-selected, #034fd6);
}

.chip.chip--dismissible {
    --fsds-chip-size-padding-horizontal: var(--fsds-core-spacing-size-05, 12px);
}

.chip.chip--small {
    --fsds-chip-size-padding-vertical: var(--fsds-semantic-glyph-badge-size-sm-padding-y, 2px);
    --fsds-chip-size-padding-horizontal: var(--fsds-semantic-glyph-badge-size-sm-padding-x, 4px);
    --fsds-chip-text-size: var(--fsds-semantic-glyph-badge-size-sm-font-size, 10px);
    --fsds-chip-size-gap: var(--fsds-semantic-glyph-badge-size-sm-gap, 2px);
    --fsds-chip-size-min-height: var(--fsds-semantic-glyph-badge-size-sm-min-height, 16px);
}

.chip.chip--medium {
    --fsds-chip-size-padding-vertical: var(--fsds-semantic-glyph-badge-size-md-padding-y, 2px);
    --fsds-chip-size-padding-horizontal: var(--fsds-semantic-glyph-badge-size-md-padding-x, 8px);
    --fsds-chip-text-size: var(--fsds-semantic-glyph-badge-size-md-font-size, 12px);
    --fsds-chip-size-gap: var(--fsds-semantic-glyph-badge-size-md-gap, 4px);
    --fsds-chip-size-min-height: var(--fsds-semantic-glyph-badge-size-md-min-height, 24px);
}

.chip.chip--large {
    --fsds-chip-size-padding-vertical: var(--fsds-semantic-glyph-badge-size-lg-padding-y, 4px);
    --fsds-chip-size-padding-horizontal: var(--fsds-semantic-glyph-badge-size-lg-padding-x, 12px);
    --fsds-chip-text-size: var(--fsds-semantic-glyph-badge-size-lg-font-size, 14px);
    --fsds-chip-size-gap: var(--fsds-semantic-glyph-badge-size-lg-gap, 4px);
    --fsds-chip-size-min-height: var(--fsds-semantic-glyph-badge-size-lg-min-height, 32px);
}

/* CodeSnippet (.code-snippet) */
.code-snippet {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-code-snippet-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-code-snippet-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-code-snippet-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-code-snippet-size-padding-inline: var(--fsds-core-spacing-size-02, 2px);
    --fsds-code-snippet-size-padding-block: var(--fsds-core-spacing-size-01, 1px);
    --fsds-code-snippet-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-code-snippet-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-code-snippet-size-font-size: var(--fsds-core-typography-ramp-3, 14px);
    --fsds-code-snippet-typography-line-height: var(--fsds-semantic-typography-line-height-body, 1.5);
}

.code-snippet {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.code-snippet {
    background-color: var(--fsds-code-snippet-color-background, #f7f7f7);
    border-color: var(--fsds-code-snippet-color-border, #d0d0d0);
    border-width: var(--fsds-code-snippet-size-border, 1px);
    border-radius: var(--fsds-code-snippet-size-radius, 6px);
    color: var(--fsds-code-snippet-color-foreground-primary, #141414);
    font-size: var(--fsds-code-snippet-size-font-size, 14px);
    margin: 0;
    padding-top: var(--fsds-code-snippet-size-padding-block, 1px);
    padding-bottom: var(--fsds-code-snippet-size-padding-block, 1px);
    padding-left: var(--fsds-code-snippet-size-padding-inline, 2px);
    padding-right: var(--fsds-code-snippet-size-padding-inline, 2px);
    white-space: nowrap;
}

.code-snippet.code-snippet--samp {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

/* Dialog (.dialog) */
.dialog {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-dialog-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-dialog-color-foreground: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-dialog-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-dialog-size-radius: var(--fsds-semantic-shape-radius-large, 16px);
    --fsds-dialog-size-sm-width: 400px;
    --fsds-dialog-size-md-width: 500px;
    --fsds-dialog-size-lg-width: 700px;
    --fsds-dialog-size-xl-width: 900px;
    --fsds-dialog-size-close-button-size: var(--fsds-core-spacing-size-08, 32px);
    --fsds-dialog-spacing-header-padding-top: var(--fsds-core-spacing-size-06, 16px);
    --fsds-dialog-spacing-body-padding-right: var(--fsds-core-spacing-size-07, 24px);
    --fsds-dialog-spacing-footer-gap: var(--fsds-core-spacing-size-03, 4px);
    --fsds-dialog-typography-title-font-size: var(--fsds-semantic-typography-heading-04, 18px);
    --fsds-dialog-typography-title-font-weight: var(--fsds-semantic-typography-font-weight-bold, 700);
    --fsds-dialog-typography-title-line-height: var(--fsds-semantic-typography-line-height-heading, 1);
}

.dialog {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.dialog {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.dialog__backdrop {
    position: absolute;
    --fsds-dialog-color-background: var(--fsds-semantic-color-overlay-scrim, rgba(0, 0, 0, 0.4));
}

.dialog__modal {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-dialog-color-background, #ffffff);
    color: var(--fsds-dialog-color-foreground, #141414);
    border-color: var(--fsds-dialog-color-border, #d0d0d0);
    border-width: 1px;
    border-radius: var(--fsds-dialog-size-radius, 16px);
    width: var(--fsds-dialog-size-md-width, 500px);
    overflow: hidden;
    min-width: 0;
}

.dialog__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-top: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-right: var(--fsds-dialog-spacing-body-padding-right, 24px);
    padding-bottom: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-left: var(--fsds-dialog-spacing-body-padding-right, 24px);
    border-bottom-color: var(--fsds-dialog-color-border, #d0d0d0);
    border-bottom-width: 1px;
    flex-shrink: 0;
}

.dialog__title {
    margin: 0;
    font-size: var(--fsds-dialog-typography-title-font-size, 18px);
    -unity-font-style: bold;
    color: var(--fsds-dialog-color-foreground, #141414);
}

.dialog__body {
    flex: 1 1 auto;
    padding-top: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-right: var(--fsds-dialog-spacing-body-padding-right, 24px);
    padding-bottom: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-left: var(--fsds-dialog-spacing-body-padding-right, 24px);
    --fsds-dialog-color-foreground: var(--fsds-semantic-color-foreground-secondary, #474647);
    min-width: 0;
    min-height: 0;
}

.dialog__footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    --fsds-gap: var(--fsds-dialog-spacing-footer-gap, 4px);
    padding-top: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-right: var(--fsds-dialog-spacing-body-padding-right, 24px);
    padding-bottom: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-left: var(--fsds-dialog-spacing-body-padding-right, 24px);
    border-top-color: var(--fsds-dialog-color-border, #d0d0d0);
    border-top-width: 1px;
    flex-shrink: 0;
}

.dialog__closeButton {
    position: absolute;
    top: var(--fsds-dialog-spacing-header-padding-top, 16px);
    right: var(--fsds-dialog-spacing-body-padding-right, 24px);
    width: var(--fsds-dialog-size-close-button-size, 32px);
    height: var(--fsds-dialog-size-close-button-size, 32px);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 9999px;
    --fsds-dialog-color-foreground: var(--fsds-semantic-color-foreground-secondary, #474647);
}

.dialog__closeButton:hover {
    --fsds-dialog-color-background: var(--fsds-semantic-color-background-hover, #f7f7f7);
}

.dialog--sm .dialog__modal {
    width: var(--fsds-dialog-size-sm-width, 400px);
}

.dialog--lg .dialog__modal {
    width: var(--fsds-dialog-size-lg-width, 700px);
}

.dialog--xl .dialog__modal {
    width: var(--fsds-dialog-size-xl-width, 900px);
}

.dialog--full .dialog__modal {
    border-radius: 0;
}

/* Sheet (.sheet) */
.sheet {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-sheet-color-overlay: var(--fsds-semantic-overlay-scrim-medium, rgba(0, 0, 0, 0.40));
    --fsds-sheet-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-sheet-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-sheet-color-text: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-sheet-color-text-title: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-sheet-color-text-description: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-sheet-border-width: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-sheet-border-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-sheet-size-width: 400px;
    --fsds-sheet-size-height: 300px;
    --fsds-sheet-size-close: var(--fsds-core-spacing-size-06, 16px);
    --fsds-sheet-spacing-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-sheet-spacing-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-sheet-text-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-sheet-text-size-title: var(--fsds-semantic-typography-heading-06, 14px);
    --fsds-sheet-text-weight-title: var(--fsds-semantic-typography-font-weight-medium, 500);
}

.sheet {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.sheet {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.sheet__overlay {
    position: absolute;
    background-color: var(--fsds-sheet-color-overlay, rgba(0, 0, 0, 0.40));
}

.sheet__content {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-sheet-color-background, #ffffff);
    color: var(--fsds-sheet-color-text, #141414);
    border-color: var(--fsds-sheet-color-border, #d0d0d0);
    border-width: var(--fsds-sheet-border-width, 1px);
    width: var(--fsds-sheet-size-width, 400px);
    overflow: hidden;
}

.sheet__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: var(--fsds-sheet-spacing-padding, 16px);
    border-bottom-color: var(--fsds-sheet-color-border, #d0d0d0);
    border-bottom-width: 1px;
    --fsds-gap: var(--fsds-sheet-spacing-gap, 8px);
}

.sheet__title {
    margin: 0;
    font-size: var(--fsds-sheet-text-size-title, 14px);
    color: var(--fsds-sheet-color-text-title, #141414);
    flex: 1 1 auto;
}

.sheet__description {
    margin: 0;
    color: var(--fsds-sheet-color-text-description, #474647);
    font-size: var(--fsds-sheet-text-size, 16px);
}

.sheet__body {
    flex: 1 1 auto;
    padding: var(--fsds-sheet-spacing-padding, 16px);
    color: var(--fsds-sheet-color-text, #141414);
}

.sheet__footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    --fsds-gap: var(--fsds-sheet-spacing-gap, 8px);
    padding: var(--fsds-sheet-spacing-padding, 16px);
    border-top-color: var(--fsds-sheet-color-border, #d0d0d0);
    border-top-width: 1px;
}

.sheet__close {
    position: absolute;
    top: var(--fsds-sheet-spacing-padding, 16px);
    right: var(--fsds-sheet-spacing-padding, 16px);
    width: var(--fsds-sheet-size-close, 16px);
    height: var(--fsds-sheet-size-close, 16px);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 9999px;
    color: var(--fsds-sheet-color-text-description, #474647);
}

.sheet--right .sheet__content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--fsds-sheet-size-width, 400px);
    border-radius: var(--fsds-sheet-border-radius, 6px);
}

.sheet--left .sheet__content {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--fsds-sheet-size-width, 400px);
    border-radius: var(--fsds-sheet-border-radius, 6px);
}

.sheet--top .sheet__content {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-height: var(--fsds-sheet-size-height, 300px);
    border-radius: var(--fsds-sheet-border-radius, 6px);
}

.sheet--bottom .sheet__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-height: var(--fsds-sheet-size-height, 300px);
    border-radius: var(--fsds-sheet-border-radius, 6px);
}

/* Input (.input) */
.input {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-input-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: var(--fsds-semantic-input-size-medium-min-height, 32px);
    --fsds-box-model-max-height: none;
    --fsds-input-color-bg-default: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-input-color-bg-disabled: var(--fsds-semantic-interaction-background-disabled, #b8b8b8);
    --fsds-input-color-text-default: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-input-color-text-placeholder: var(--fsds-semantic-color-foreground-placeholder, #888889);
    --fsds-input-color-text-disabled: var(--fsds-semantic-color-foreground-disabled, #727272);
    --fsds-input-color-border-default: var(--fsds-semantic-color-border-default, #a0a0a1);
    --fsds-input-color-border-hover: var(--fsds-semantic-color-border-hover, #888889);
    --fsds-input-color-border-disabled: var(--fsds-semantic-color-border-disabled, #b8b8b8);
    --fsds-input-size-height: var(--fsds-semantic-input-size-medium-min-height, 32px);
    --fsds-input-size-padding-block: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-input-size-padding-inline: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-input-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-input-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-input-color-focus: var(--fsds-semantic-color-border-focus, #0566fe);
    --fsds-input-color-invalid: var(--fsds-semantic-color-border-danger, #b31b1b);
    --fsds-input-typography-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-input-typography-line-height: var(--fsds-semantic-typography-line-height-body, 1.5);
    --fsds-input-opacity-disabled: var(--fsds-semantic-interaction-disabled-opacity, 0.5);
    --fsds-input-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-input-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-input-focus-ring-style: var(--fsds-semantic-focus-ring-style, solid);
    --fsds-input-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
    --fsds-input-motion-duration-fast: var(--fsds-core-motion-duration-short, 150ms);
}

.input {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 4px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 4px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 32px);
}

.input {
    border-width: var(--fsds-input-size-border, 1px);
    background-color: var(--fsds-input-color-bg-default, #ffffff);
    color: var(--fsds-input-color-text-default, #141414);
    border-color: var(--fsds-input-color-border-default, #a0a0a1);
    min-height: var(--fsds-input-size-height, 32px);
    border-radius: var(--fsds-input-size-radius, 6px);
    font-size: var(--fsds-input-typography-size, 16px);
    padding-top: var(--fsds-input-size-padding-block, 4px);
    padding-bottom: var(--fsds-input-size-padding-block, 4px);
    padding-left: var(--fsds-input-size-padding-inline, 8px);
    padding-right: var(--fsds-input-size-padding-inline, 8px);
}

.input:hover {
    border-color: var(--fsds-input-color-border-hover, #888889);
}

.input:focus {
    border-color: var(--fsds-input-color-focus, #0566fe);
    border-width: var(--fsds-input-focus-ring-width, 2px);
    border-color: var(--fsds-input-focus-ring-color, #0566fe);
}

.input:disabled {
    background-color: var(--fsds-input-color-bg-disabled, #b8b8b8);
    border-color: var(--fsds-input-color-border-disabled, #b8b8b8);
    color: var(--fsds-input-color-text-disabled, #727272);
    opacity: var(--fsds-input-opacity-disabled, 0.5);
}

/* TextField (.text-field) */
.text-field {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-input-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: var(--fsds-semantic-input-size-medium-min-height, 32px);
    --fsds-box-model-max-height: none;
    --fsds-text-field-spacing-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-text-field-field-padding-block: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-text-field-field-padding-inline: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-text-field-field-min-height: var(--fsds-semantic-input-size-medium-min-height, 32px);
    --fsds-text-field-border-width: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-text-field-border-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-text-field-color-input-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-text-field-color-input-text: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-text-field-color-input-placeholder: var(--fsds-semantic-color-foreground-tertiary, #727272);
    --fsds-text-field-color-input-border: var(--fsds-semantic-color-border-default, #a0a0a1);
    --fsds-text-field-color-input-border-hover: var(--fsds-semantic-color-border-hover, #888889);
    --fsds-text-field-color-input-background-disabled: var(--fsds-semantic-interaction-background-disabled, #b8b8b8);
    --fsds-text-field-color-input-text-disabled: var(--fsds-semantic-color-foreground-disabled, #727272);
    --fsds-text-field-color-input-border-disabled: var(--fsds-semantic-color-border-disabled, #b8b8b8);
    --fsds-text-field-color-input-border-error: var(--fsds-semantic-color-status-danger, #d92d2e);
    --fsds-text-field-color-error: var(--fsds-semantic-color-foreground-danger, #d92d2e);
    --fsds-text-field-color-supporting-text: var(--fsds-semantic-color-foreground-tertiary, #727272);
    --fsds-text-field-typography-label-size: var(--fsds-semantic-typography-caption-01, 14px);
    --fsds-text-field-typography-label-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-text-field-typography-label-line-height: var(--fsds-semantic-typography-line-height-normal, 1.5);
    --fsds-text-field-typography-field-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-text-field-typography-field-line-height: var(--fsds-semantic-typography-line-height-body, 1.5);
    --fsds-text-field-typography-supporting-size: var(--fsds-semantic-typography-caption-01, 14px);
    --fsds-text-field-typography-supporting-line-height: var(--fsds-semantic-typography-line-height-normal, 1.5);
    --fsds-text-field-opacity-disabled: var(--fsds-semantic-interaction-disabled-opacity, 0.5);
    --fsds-text-field-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-text-field-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-text-field-focus-ring-style: var(--fsds-semantic-focus-ring-style, solid);
    --fsds-text-field-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
    --fsds-text-field-motion-duration-fast: var(--fsds-core-motion-duration-short, 150ms);
}

.text-field {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 4px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 4px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 32px);
}

.text-field {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-text-field-spacing-gap, 8px);
}

.text-field__label {
    display: flex;
    flex-direction: column;
    font-size: var(--fsds-text-field-typography-label-size, 14px);
    color: var(--fsds-text-field-color-input-text, #141414);
}

.text-field__field {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: var(--fsds-text-field-color-input-background, #ffffff);
    border-color: var(--fsds-text-field-color-input-border, #a0a0a1);
    border-width: var(--fsds-text-field-border-width, 1px);
    border-radius: var(--fsds-text-field-border-radius, 6px);
    color: var(--fsds-text-field-color-input-text, #141414);
    font-size: var(--fsds-text-field-typography-field-size, 16px);
    min-height: var(--fsds-text-field-field-min-height, 32px);
    padding-top: var(--fsds-text-field-field-padding-block, 4px);
    padding-bottom: var(--fsds-text-field-field-padding-block, 4px);
    padding-left: var(--fsds-text-field-field-padding-inline, 8px);
    padding-right: var(--fsds-text-field-field-padding-inline, 8px);
}

.text-field__description {
    display: flex;
    flex-direction: column;
    font-size: var(--fsds-text-field-typography-supporting-size, 14px);
    color: var(--fsds-text-field-color-supporting-text, #727272);
}

.text-field__error {
    display: flex;
    flex-direction: column;
    font-size: var(--fsds-text-field-typography-supporting-size, 14px);
    color: var(--fsds-text-field-color-error, #d92d2e);
}

.text-field__field:focus {
    border-color: var(--fsds-text-field-focus-ring-color, #0566fe);
    border-width: var(--fsds-text-field-focus-ring-width, 2px);
    border-color: var(--fsds-text-field-focus-ring-color, #0566fe);
}

.text-field__field:disabled {
    background-color: var(--fsds-text-field-color-input-background-disabled, #b8b8b8);
    border-color: var(--fsds-text-field-color-input-border-disabled, #b8b8b8);
    color: var(--fsds-text-field-color-input-text-disabled, #727272);
    opacity: var(--fsds-text-field-opacity-disabled, 0.5);
}

/* Toast (.toast) */
.toast {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-toast-surface-bg: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-toast-surface-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-toast-surface-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-toast-color: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-toast-spacing-padding: var(--fsds-core-spacing-size-05, 12px);
    --fsds-toast-spacing-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-toast-spacing-stack-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-toast-size-max-width: 400px;
    --fsds-toast-timing-auto-dismiss: var(--fsds-semantic-motion-dwell-notification, 6000ms);
    --fsds-toast-progress-color: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-toast-progress-height: var(--fsds-core-spacing-size-02, 2px);
}

.toast {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.toast {
    bottom: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-toast-spacing-stack-gap, 8px);
}

.toast__item {
    background-color: var(--fsds-toast-surface-bg, #f7f7f7);
    border-color: var(--fsds-toast-surface-border, #d0d0d0);
    border-width: 1px;
    border-radius: var(--fsds-toast-surface-radius, 6px);
    padding: var(--fsds-toast-spacing-padding, 12px);
    max-width: var(--fsds-toast-size-max-width, 400px);
    display: flex;
    flex-direction: column;
    position: relative;
}

.toast__row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    --fsds-gap: var(--fsds-toast-spacing-gap, 8px);
    flex: 1 1 auto;
}

.toast__title {
    margin: 0;
    -unity-font-style: bold;
    flex: 1 1 auto;
}

.toast__description {
    flex: 1 1 auto;
    color: var(--fsds-toast-color, #141414);
}

.toast__action {
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--fsds-toast-color, #141414);
}

.toast__close {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 9999px;
    color: var(--fsds-toast-color, #141414);
    flex-shrink: 0;
}

.toast.toast--info {
    --fsds-toast-surface-bg: var(--fsds-semantic-color-background-info-subtle, #95dafb);
    --fsds-toast-color: var(--fsds-semantic-color-foreground-on-info-subtle, #013ab0);
    --fsds-toast-surface-border: var(--fsds-semantic-color-border-info, #034fd6);
    --fsds-toast-progress-color: var(--fsds-semantic-color-foreground-on-info-subtle, #013ab0);
}

.toast.toast--success {
    --fsds-toast-surface-bg: var(--fsds-semantic-color-background-success-subtle, #b3dba7);
    --fsds-toast-color: var(--fsds-semantic-color-foreground-on-success-subtle, #2c4f09);
    --fsds-toast-surface-border: var(--fsds-semantic-color-border-success, #3a6614);
    --fsds-toast-progress-color: var(--fsds-semantic-color-foreground-on-success-subtle, #2c4f09);
}

.toast.toast--warning {
    --fsds-toast-surface-bg: var(--fsds-semantic-color-background-warning-subtle, #fdc67f);
    --fsds-toast-color: var(--fsds-semantic-color-foreground-on-warning-subtle, #6c3a00);
    --fsds-toast-surface-border: var(--fsds-semantic-color-border-warning, #8b4b00);
    --fsds-toast-progress-color: var(--fsds-semantic-color-foreground-on-warning-subtle, #6c3a00);
}

.toast.toast--error {
    --fsds-toast-surface-bg: var(--fsds-semantic-color-background-danger-subtle, #fac2c2);
    --fsds-toast-color: var(--fsds-semantic-color-foreground-on-danger-subtle, #900909);
    --fsds-toast-surface-border: var(--fsds-semantic-color-border-danger, #b31b1b);
    --fsds-toast-progress-color: var(--fsds-semantic-color-foreground-on-danger-subtle, #900909);
}

.toast__progress {
    position: absolute;
    bottom: 0;
    transform-origin: left center;
    height: var(--fsds-toast-progress-height, 2px);
    background-color: var(--fsds-toast-progress-color, #141414);
}

/* Field (.field) */
.field {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-input-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-field-gap-y: var(--fsds-semantic-spacing-density-compact-sm, 8px);
    --fsds-field-gap-meta: var(--fsds-core-spacing-size-03, 4px);
    --fsds-field-color-fg: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-field-color-invalid-text: var(--fsds-semantic-color-foreground-danger, #d92d2e);
    --fsds-field-label-font-size: var(--fsds-semantic-typography-body-small-font-size, 14px);
    --fsds-field-label-color: var(--fsds-semantic-color-foreground-secondary, #474647);
}

.field {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.field {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-field-gap-y, 8px);
}

.field__label {
    display: flex;
    flex-direction: column;
    font-size: var(--fsds-field-label-font-size, 14px);
    color: var(--fsds-field-label-color, #474647);
}

.field__header {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    --fsds-gap: var(--fsds-field-gap-meta, 4px);
}

.field__control {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.field__help {
    display: flex;
    flex-direction: column;
    color: var(--fsds-field-color-fg, #141414);
}

.field__error {
    display: flex;
    flex-direction: column;
    color: var(--fsds-field-color-invalid-text, #d92d2e);
}

.field__meta {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-field-gap-meta, 4px);
}

.field__validatingIndicator {
    display: flex;
    flex-direction: row;
    color: var(--fsds-field-color-fg, #141414);
}

.field.field--idle {
    --fsds-field-color-fg: var(--fsds-semantic-color-foreground-primary, #141414);
}

.field.field--validating {
    --fsds-field-color-fg: var(--fsds-semantic-color-foreground-secondary, #474647);
}

.field.field--valid {
    --fsds-field-color-fg: var(--fsds-semantic-color-foreground-success, #497f21);
}

.field.field--invalid {
    --fsds-field-color-fg: var(--fsds-semantic-color-foreground-danger, #d92d2e);
}

/* Walkthrough (.walkthrough) */
.walkthrough {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-walkthrough-surface-bg: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-walkthrough-surface-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-walkthrough-surface-radius: var(--fsds-semantic-shape-radius-large, 16px);
    --fsds-walkthrough-surface-padding: var(--fsds-core-spacing-size-08, 32px);
    --fsds-walkthrough-title-font-size: var(--fsds-semantic-typography-heading-03, 20px);
    --fsds-walkthrough-title-font-weight: var(--fsds-semantic-typography-font-weight-bold, 700);
    --fsds-walkthrough-title-color: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-walkthrough-description-font-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-walkthrough-description-color: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-walkthrough-description-margin-top: var(--fsds-core-spacing-size-04, 8px);
    --fsds-walkthrough-controls-gap: var(--fsds-core-spacing-size-05, 12px);
    --fsds-walkthrough-controls-margin-top: var(--fsds-core-spacing-size-06, 16px);
    --fsds-walkthrough-dots-size: var(--fsds-core-spacing-size-04, 8px);
    --fsds-walkthrough-dots-gap: var(--fsds-core-spacing-size-03, 4px);
    --fsds-walkthrough-dots-idle: var(--fsds-semantic-color-border-subtle, #d0d0d0);
    --fsds-walkthrough-button-primary-bg: var(--fsds-semantic-color-action-background-primary-default, #0566fe);
    --fsds-walkthrough-button-primary-color: var(--fsds-semantic-color-action-foreground-primary-default, #ffffff);
    --fsds-walkthrough-button-primary-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-walkthrough-button-secondary-bg: var(--fsds-core-color-mode-transparent, rgba(0, 0, 0, 0));
    --fsds-walkthrough-button-secondary-color: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-walkthrough-button-secondary-border: var(--fsds-semantic-color-border-subtle, #d0d0d0);
}

.walkthrough {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.walkthrough {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-walkthrough-surface-bg, #f7f7f7);
    border-color: var(--fsds-walkthrough-surface-border, #d0d0d0);
    border-width: 1px;
    border-radius: var(--fsds-walkthrough-surface-radius, 16px);
    padding: var(--fsds-walkthrough-surface-padding, 32px);
    --fsds-gap: var(--fsds-walkthrough-dots-gap, 4px);
    width: 360px;
}

.walkthrough__content {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-walkthrough-description-margin-top, 8px);
}

.walkthrough__title {
    margin: 0;
    font-size: var(--fsds-walkthrough-title-font-size, 20px);
    -unity-font-style: bold;
    color: var(--fsds-walkthrough-title-color, #141414);
}

.walkthrough__description {
    margin: 0;
    font-size: var(--fsds-walkthrough-description-font-size, 16px);
    color: var(--fsds-walkthrough-description-color, #474647);
}

.walkthrough__controls {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-walkthrough-controls-gap, 12px);
    margin-top: var(--fsds-walkthrough-controls-margin-top, 16px);
    border-top-color: var(--fsds-walkthrough-surface-border, #d0d0d0);
    border-top-width: 1px;
    padding-top: var(--fsds-walkthrough-controls-margin-top, 16px);
    flex-wrap: wrap;
}

.walkthrough__skip {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--fsds-walkthrough-button-secondary-color, #474647);
    padding: 0;
    margin-right: auto;
}

.walkthrough__prev {
    background-color: var(--fsds-walkthrough-button-secondary-bg, rgba(0, 0, 0, 0));
    border-color: var(--fsds-walkthrough-button-secondary-border, #d0d0d0);
    border-width: 1px;
    border-radius: var(--fsds-walkthrough-button-primary-radius, 6px);
    color: var(--fsds-walkthrough-button-secondary-color, #474647);
}

.walkthrough__next {
    background-color: var(--fsds-walkthrough-button-primary-bg, #0566fe);
    border-width: 0;
    border-radius: var(--fsds-walkthrough-button-primary-radius, 6px);
    color: var(--fsds-walkthrough-button-primary-color, #ffffff);
}

.walkthrough__dots {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    --fsds-gap: var(--fsds-walkthrough-dots-gap, 4px);
}

.walkthrough__dot {
    display: flex;
    flex-direction: column;
    width: var(--fsds-walkthrough-dots-size, 8px);
    height: var(--fsds-walkthrough-dots-size, 8px);
    border-radius: 50%;
    background-color: var(--fsds-walkthrough-dots-idle, #d0d0d0);
    border-width: 0;
    padding: 0;
}

.walkthrough__counter {
    color: var(--fsds-walkthrough-description-color, #474647);
    font-size: var(--fsds-walkthrough-description-font-size, 16px);
}

/* Links (.links) */
.links {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-links-color-foreground-default: var(--fsds-semantic-color-foreground-link, #d92d2e);
    --fsds-links-color-foreground-hover: var(--fsds-semantic-color-foreground-link-hover, #b31b1b);
    --fsds-links-color-foreground-visited: var(--fsds-semantic-color-foreground-link-visited, #e55b5a);
    --fsds-links-color-foreground-disabled: var(--fsds-semantic-color-foreground-disabled, #727272);
    --fsds-links-color-underline: var(--fsds-semantic-color-border-light, #b8b8b8);
    --fsds-links-spacing-gap: var(--fsds-core-spacing-size-02, 2px);
    --fsds-links-motion-duration-fast: var(--fsds-core-motion-duration-short, 150ms);
    --fsds-links-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-links-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-links-focus-ring-style: var(--fsds-semantic-focus-ring-style, solid);
    --fsds-links-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
    --fsds-links-focus-ring-radius: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-links-size-font-size-small: var(--fsds-core-typography-ramp-3, 14px);
    --fsds-links-size-font-size-medium: var(--fsds-core-typography-ramp-4, 16px);
    --fsds-links-size-font-size-large: var(--fsds-core-typography-ramp-5, 18px);
}

.links {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.links {
    color: var(--fsds-links-color-foreground-default, #d92d2e);
    font-size: var(--fsds-links-size-font-size-medium, 16px);
    --fsds-gap: var(--fsds-links-spacing-gap, 2px);
}

.links.links--small {
    --fsds-links-size-font-size-medium: var(--fsds-links-size-font-size-small, 14px);
    font-size: var(--fsds-links-size-font-size-medium, 16px);
}

.links.links--medium {
    --fsds-links-size-font-size-medium: var(--fsds-core-typography-ramp-4, 16px);
    font-size: var(--fsds-links-size-font-size-medium, 16px);
}

.links.links--large {
    --fsds-links-size-font-size-medium: var(--fsds-links-size-font-size-large, 18px);
    font-size: var(--fsds-links-size-font-size-medium, 16px);
}

.links:hover {
    color: var(--fsds-links-color-foreground-hover, #b31b1b);
}

.links:disabled {
    color: var(--fsds-links-color-foreground-disabled, #727272);
}

.links:focus {
    border-width: var(--fsds-links-focus-ring-width, 2px);
    border-color: var(--fsds-links-focus-ring-color, #0566fe);
    border-radius: var(--fsds-links-focus-ring-radius, 4px);
}

/* Image (.image) */
.image {
    --fsds-box-model-max-width: 100%;
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-image-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-image-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-image-size-xs: 24px;
    --fsds-image-size-sm: 32px;
    --fsds-image-size-md: 48px;
    --fsds-image-size-lg: 64px;
    --fsds-image-size-xl: 96px;
    --fsds-image-radius-none: var(--fsds-semantic-shape-radius-none, 0px);
    --fsds-image-radius-sm: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-image-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    --fsds-image-radius-lg: var(--fsds-semantic-shape-radius-large, 16px);
    --fsds-image-radius-full: var(--fsds-semantic-shape-radius-full, 9999px);
}

.image {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
    display: flex;
    flex-direction: column;
}

.image {
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-image-color-background, #f7f7f7);
    color: var(--fsds-image-color-foreground-primary, #141414);
}

.image.image--size-xs {
    width: var(--fsds-image-size-xs, 24px);
    height: var(--fsds-image-size-xs, 24px);
}

.image.image--size-sm {
    width: var(--fsds-image-size-sm, 32px);
    height: var(--fsds-image-size-sm, 32px);
}

.image.image--size-md {
    width: var(--fsds-image-size-md, 48px);
    height: var(--fsds-image-size-md, 48px);
}

.image.image--size-lg {
    width: var(--fsds-image-size-lg, 64px);
    height: var(--fsds-image-size-lg, 64px);
}

.image.image--size-xl {
    width: var(--fsds-image-size-xl, 96px);
    height: var(--fsds-image-size-xl, 96px);
}

.image.image--size-full {
    width: 100%;
    height: auto;
}

.image.image--radius-none {
    border-radius: var(--fsds-image-radius-none, 0px);
}

.image.image--radius-sm {
    border-radius: var(--fsds-image-radius-sm, 4px);
}

.image.image--radius-md {
    border-radius: var(--fsds-image-radius-md, 8px);
}

.image.image--radius-lg {
    border-radius: var(--fsds-image-radius-lg, 16px);
}

.image.image--radius-full {
    border-radius: var(--fsds-image-radius-full, 9999px);
}

/* Avatar (.avatar) */
.avatar {
    --fsds-box-model-width: var(--fsds-semantic-glyph-size-medium-extent, 16px);
    --fsds-box-model-height: var(--fsds-semantic-glyph-size-medium-extent, 16px);
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-avatar-size: var(--fsds-core-spacing-size-06, 16px);
    --fsds-avatar-size-small: var(--fsds-core-spacing-size-06, 16px);
    --fsds-avatar-size-medium: var(--fsds-core-spacing-size-07, 24px);
    --fsds-avatar-size-large: var(--fsds-core-spacing-size-08, 32px);
    --fsds-avatar-size-extra-large: var(--fsds-core-spacing-size-09, 48px);
    --fsds-avatar-size-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-avatar-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-avatar-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-avatar-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-avatar-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-avatar-typography-font-weight-medium: var(--fsds-core-typography-weight-medium, 500);
}

.avatar {
    width: var(--fsds-box-model-width, 16px);
    height: var(--fsds-box-model-height, 16px);
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.avatar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    border-radius: var(--fsds-avatar-size-radius, 9999px);
    background-color: var(--fsds-avatar-color-background, #f7f7f7);
    color: var(--fsds-avatar-color-foreground-primary, #141414);
    border-color: var(--fsds-avatar-color-border, #d0d0d0);
    border-width: var(--fsds-avatar-size-border, 1px);
    width: var(--fsds-avatar-size, 16px);
    height: var(--fsds-avatar-size, 16px);
}

.avatar__image {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.avatar.avatar--small {
    width: var(--fsds-avatar-size-small, 16px);
    height: var(--fsds-avatar-size-small, 16px);
}

.avatar.avatar--medium {
    width: var(--fsds-avatar-size-medium, 24px);
    height: var(--fsds-avatar-size-medium, 24px);
}

.avatar.avatar--large {
    width: var(--fsds-avatar-size-large, 32px);
    height: var(--fsds-avatar-size-large, 32px);
}

.avatar.avatar--extra-large {
    width: var(--fsds-avatar-size-extra-large, 48px);
    height: var(--fsds-avatar-size-extra-large, 48px);
}

/* NavTree (.nav-tree) */
.nav-tree {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-nav-tree-color-foreground-default: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-nav-tree-color-foreground-hover: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-nav-tree-color-foreground-current: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-nav-tree-color-foreground-heading: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-nav-tree-color-foreground-heading-hover: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-nav-tree-color-connector: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-nav-tree-color-outline-focus: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-nav-tree-size-indent: var(--fsds-core-spacing-size-06, 16px);
    --fsds-nav-tree-size-margin-group: var(--fsds-core-spacing-size-04, 8px);
    --fsds-nav-tree-size-padding-block: var(--fsds-core-spacing-size-02, 2px);
    --fsds-nav-tree-size-padding-inline: var(--fsds-core-spacing-size-04, 8px);
    --fsds-nav-tree-size-font-size-heading: var(--fsds-semantic-typography-caption-03, 10px);
    --fsds-nav-tree-size-font-size-item: var(--fsds-semantic-typography-body-03, 14px);
    --fsds-nav-tree-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-nav-tree-size-gap-heading: var(--fsds-core-spacing-size-03, 4px);
    --fsds-nav-tree-size-gap-item: var(--fsds-core-spacing-size-01, 1px);
    --fsds-nav-tree-state-layer-hover: var(--fsds-semantic-interaction-state-layer-hover, 0.04);
    --fsds-nav-tree-state-layer-selected: var(--fsds-semantic-interaction-state-layer-selected, 0.08);
}

.nav-tree {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.nav-tree {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--fsds-nav-tree-size-margin-group, 8px);
}

.nav-tree__heading {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-nav-tree-size-gap-heading, 4px);
    font-size: var(--fsds-nav-tree-size-font-size-heading, 10px);
    -unity-font-style: bold;
    color: var(--fsds-nav-tree-color-foreground-heading, #474647);
}

.nav-tree__icon {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
}

.nav-tree__headingLink {
    color: var(--fsds-nav-tree-color-foreground-heading, #474647);
    padding-top: var(--fsds-nav-tree-size-padding-block, 2px);
    padding-bottom: var(--fsds-nav-tree-size-padding-block, 2px);
    padding-left: var(--fsds-nav-tree-size-padding-inline, 8px);
    padding-right: var(--fsds-nav-tree-size-padding-inline, 8px);
    border-radius: var(--fsds-nav-tree-size-radius, 6px);
}

.nav-tree__headingLabel {
    padding-top: var(--fsds-nav-tree-size-padding-block, 2px);
    padding-bottom: var(--fsds-nav-tree-size-padding-block, 2px);
    padding-left: var(--fsds-nav-tree-size-padding-inline, 8px);
    padding-right: var(--fsds-nav-tree-size-padding-inline, 8px);
    border-radius: var(--fsds-nav-tree-size-radius, 6px);
}

.nav-tree__list {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-nav-tree-size-gap-item, 1px);
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: var(--fsds-nav-tree-size-indent, 16px);
    padding-right: 0;
}

.nav-tree__item {
    position: relative;
    display: flex;
    flex-direction: column;
    color: var(--fsds-nav-tree-color-foreground-default, #474647);
    font-size: var(--fsds-nav-tree-size-font-size-item, 14px);
}

.nav-tree__headingLink:hover {
    color: var(--fsds-nav-tree-color-foreground-heading-hover, #141414);
}

.nav-tree__headingLink:focus {
    border-color: var(--fsds-nav-tree-color-outline-focus, #0566fe);
    border-width: var(--fsds-semantic-focus-ring-width, 2px);
}

/* Postcard (.postcard) */
.postcard {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-postcard-color-background-default: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-postcard-color-background-hover: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-postcard-color-border-default: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-postcard-color-border-hover: var(--fsds-semantic-color-border-bold, #888889);
    --fsds-postcard-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-postcard-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-postcard-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-postcard-size-gap: var(--fsds-core-spacing-size-05, 12px);
    --fsds-postcard-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-postcard-typography-display-name-font-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-postcard-typography-display-name-font-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-postcard-typography-handle-font-size: var(--fsds-semantic-typography-body-03, 14px);
    --fsds-postcard-typography-content-font-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-postcard-typography-content-line-height: var(--fsds-semantic-typography-line-height-body, 1.5);
    --fsds-postcard-typography-footer-font-size: var(--fsds-semantic-typography-body-03, 14px);
}

.postcard {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.postcard {
    background-color: var(--fsds-postcard-color-background-default, #ffffff);
    padding: var(--fsds-postcard-size-padding, 16px);
    border-radius: var(--fsds-postcard-size-radius, 6px);
    --fsds-gap: var(--fsds-postcard-size-gap, 12px);
    display: flex;
    flex-direction: column;
    border-width: var(--fsds-postcard-size-border, 1px);
    border-color: var(--fsds-postcard-color-border-default, #d0d0d0);
    color: var(--fsds-postcard-color-foreground-primary, #141414);
}

.postcard:hover {
    background-color: var(--fsds-postcard-color-background-hover, #f7f7f7);
    border-color: var(--fsds-postcard-color-border-hover, #888889);
}

.postcard__content {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-postcard-size-gap, 12px);
    color: var(--fsds-postcard-color-foreground-primary, #141414);
    font-size: var(--fsds-postcard-typography-content-font-size, 16px);
}

.postcard__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    --fsds-gap: var(--fsds-postcard-size-gap, 12px);
}

.postcard__userInfo {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 1 1 auto;
    --fsds-postcard-size-gap: var(--fsds-core-spacing-size-03, 4px);
}

.postcard__displayName {
    font-size: var(--fsds-postcard-typography-display-name-font-size, 16px);
    color: var(--fsds-postcard-color-foreground-primary, #141414);
}

.postcard__handle {
    font-size: var(--fsds-postcard-typography-handle-font-size, 14px);
    --fsds-postcard-color-foreground-primary: var(--fsds-semantic-color-foreground-secondary, #474647);
}

.postcard__timestamp {
    font-size: var(--fsds-postcard-typography-footer-font-size, 14px);
    flex-shrink: 0;
    --fsds-postcard-color-foreground-primary: var(--fsds-semantic-color-foreground-secondary, #474647);
}

.postcard__footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-postcard-size-gap, 12px);
    padding-top: var(--fsds-postcard-size-padding, 16px);
    border-top-color: var(--fsds-postcard-color-border-default, #d0d0d0);
    border-top-width: var(--fsds-postcard-size-border, 1px);
    font-size: var(--fsds-postcard-typography-footer-font-size, 14px);
}

.postcard__stats {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-postcard-size-gap, 12px);
}

.postcard__stat {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: var(--fsds-postcard-typography-footer-font-size, 14px);
    --fsds-postcard-size-gap: var(--fsds-core-spacing-size-03, 4px);
    --fsds-postcard-color-foreground-primary: var(--fsds-semantic-color-foreground-secondary, #474647);
}

/* Pagination (.pagination) */
.pagination {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-pagination-color-foreground: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-pagination-color-track: var(--fsds-semantic-color-border-subtle, #d0d0d0);
    --fsds-pagination-spacing-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-pagination-size-dot-size: var(--fsds-core-spacing-size-04, 8px);
    --fsds-pagination-size-active-size: var(--fsds-core-spacing-size-08, 32px);
    --fsds-pagination-size-radius: var(--fsds-core-shape-radius-full, 9999px);
    --fsds-pagination-color-on-current: var(--fsds-semantic-color-foreground-inverse, #fafafa);
    --fsds-pagination-color-current: var(--fsds-semantic-color-action-background-primary-default, #0566fe);
}

.pagination {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.pagination {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-pagination-spacing-gap, 8px);
    color: var(--fsds-pagination-color-foreground, #141414);
}

.pagination__item {
    position: relative;
    padding: 0;
    border-width: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background-color: rgba(0, 0, 0, 0);
}

.pagination__marker {
    width: var(--fsds-pagination-size-dot-size, 8px);
    height: var(--fsds-pagination-size-dot-size, 8px);
    border-radius: var(--fsds-pagination-size-radius, 9999px);
    overflow: hidden;
    background-color: var(--fsds-pagination-color-track, #d0d0d0);
    display: flex;
    flex-direction: column;
    position: relative;
}

.pagination__fill {
    position: absolute;
    background-color: var(--fsds-pagination-color-foreground, #141414);
    transform-origin: left center;
    display: none;
}

.pagination__label {
    display: none;
}

.pagination--pages .pagination__marker {
    display: none;
}

.pagination--elapsed .pagination__fill {
    display: flex;
    flex-direction: column;
}

.pagination--pages .pagination__item {
    width: auto;
    min-width: 24px;
    padding: 4px 8px;
    border-radius: 4px;
}

/* OTP (.otp) */
.otp {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-input-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: var(--fsds-semantic-input-size-medium-min-height, 32px);
    --fsds-box-model-max-height: none;
    --fsds-otp-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-otp-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-otp-color-border: var(--fsds-semantic-color-border-default, #a0a0a1);
    --fsds-otp-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-otp-color-border-accent: var(--fsds-semantic-color-border-accent, #d92d2e);
    --fsds-otp-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-otp-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-otp-focus-ring-style: var(--fsds-semantic-focus-ring-style, solid);
    --fsds-otp-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
}

.otp {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 4px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 4px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 32px);
}

.otp {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.otp__group {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: 4px;
}

.otp__field {
    display: flex;
    flex-direction: column;
    width: 40px;
    height: 40px;
    font-size: 16px;
    border-width: 1px;
    border-radius: var(--fsds-otp-size-radius, 6px);
    border-color: var(--fsds-otp-color-border, #a0a0a1);
    background-color: var(--fsds-otp-color-background, #f7f7f7);
    color: var(--fsds-otp-color-foreground-primary, #141414);
}

.otp__field:focus {
    border-color: var(--fsds-otp-color-border-accent, #d92d2e);
    border-width: var(--fsds-otp-focus-ring-width, 2px);
    border-color: var(--fsds-otp-focus-ring-color, #0566fe);
}

.otp__field:disabled {
    opacity: 0.5;
}

/* RadioGroup (.radio-group) */
.radio-group {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
}

.radio-group {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.radio-group {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-width: 0;
}

.radio-group__item {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: 8px;
    padding: 6px 10px;
    border-radius: 999px;
    background-color: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    color: var(--fsds-semantic-color-foreground-primary, #141414);
}

.radio-group__option {
    margin: 0;
    flex-shrink: 0;
}

.radio-group__label {
    min-width: 0;
}

.radio-group.radio-group--horizontal {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Select (.select) */
.select {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-input-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-input-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-input-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: var(--fsds-semantic-input-size-medium-min-height, 32px);
    --fsds-box-model-max-height: none;
    --fsds-select-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-select-color-foreground: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-select-color-border: var(--fsds-semantic-color-border-primary, #a0a0a1);
    --fsds-select-color-placeholder: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-select-size-padding: var(--fsds-core-spacing-size-03, 4px);
    --fsds-select-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-select-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-select-size-sm-height: var(--fsds-semantic-control-size-sm-height, 24px);
    --fsds-select-size-md-height: var(--fsds-semantic-control-size-md-height, 32px);
    --fsds-select-size-lg-height: var(--fsds-semantic-control-size-lg-height, 48px);
    --fsds-select-font-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-select-font-line-height: var(--fsds-semantic-typography-line-height-body, 1.5);
    --fsds-select-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-select-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-select-focus-ring-style: var(--fsds-semantic-focus-ring-style, solid);
    --fsds-select-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
}

.select {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 4px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 4px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 32px);
}

.select {
    display: flex;
    flex-direction: column;
    position: relative;
}

.select__text {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.select__trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    --fsds-gap: var(--fsds-select-size-padding, 4px);
    padding: var(--fsds-select-size-padding, 4px);
    border-width: var(--fsds-select-size-border, 1px);
    border-radius: var(--fsds-select-size-radius, 6px);
    border-color: var(--fsds-select-color-border, #a0a0a1);
    background-color: var(--fsds-select-color-background, #ffffff);
    color: var(--fsds-select-color-foreground, #141414);
    font-size: var(--fsds-select-font-size, 16px);
    width: 100%;
}

.select__content {
    background-color: var(--fsds-select-color-background, #ffffff);
    border-width: var(--fsds-select-size-border, 1px);
    border-radius: var(--fsds-select-size-radius, 6px);
    border-color: var(--fsds-select-color-border, #a0a0a1);
    padding: var(--fsds-select-size-padding, 4px);
    max-height: 320px;
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-select-size-padding, 4px);
}

.select__search {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.select__options {
    display: flex;
    flex-direction: column;
    --fsds-gap: 2px;
    padding: 0;
    margin: 0;
}

.select__option {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-select-size-padding, 4px);
    padding: var(--fsds-select-size-padding, 4px);
    border-radius: var(--fsds-select-size-radius, 6px);
    color: var(--fsds-select-color-foreground, #141414);
    border-width: 0;
    width: 100%;
    background-color: var(--fsds-select-color-background, #ffffff);
}

.select__emptyState {
    padding: var(--fsds-select-size-padding, 4px);
    color: var(--fsds-select-color-placeholder, #474647);
}

.select__trigger:focus {
    border-width: var(--fsds-select-focus-ring-width, 2px);
    border-color: var(--fsds-select-focus-ring-color, #0566fe);
    --fsds-select-color-border: var(--fsds-semantic-color-border-accent, #d92d2e);
}

.select__trigger:hover {
    --fsds-select-color-border: var(--fsds-semantic-color-border-bold, #888889);
    --fsds-select-color-background: var(--fsds-semantic-color-background-hover, #f7f7f7);
    --fsds-select-color-foreground: var(--fsds-semantic-color-foreground-hover, #474647);
}

.select__option:hover {
    --fsds-select-color-background: var(--fsds-semantic-color-background-hover, #f7f7f7);
    --fsds-select-color-foreground: var(--fsds-semantic-color-foreground-hover, #474647);
}

.select--sm .select__trigger {
    height: var(--fsds-select-size-sm-height, 24px);
}

.select--md .select__trigger {
    height: var(--fsds-select-size-md-height, 32px);
}

.select--lg .select__trigger {
    height: var(--fsds-select-size-lg-height, 48px);
}

.select__searchInput {
    padding: var(--fsds-select-size-padding, 4px);
    border-width: var(--fsds-select-size-border, 1px);
    border-radius: var(--fsds-select-size-radius, 6px);
    border-color: var(--fsds-select-color-border, #a0a0a1);
    background-color: var(--fsds-select-color-background, #ffffff);
    color: var(--fsds-select-color-foreground, #141414);
    font-size: var(--fsds-select-font-size, 16px);
    width: 100%;
    min-width: 0;
}

.select__searchInput:focus {
    border-width: var(--fsds-select-focus-ring-width, 2px);
    border-color: var(--fsds-select-focus-ring-color, #0566fe);
}

/* Shuttle (.shuttle) */
.shuttle {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-shuttle-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-shuttle-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-shuttle-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-shuttle-color-border-accent: var(--fsds-semantic-color-border-accent, #d92d2e);
    --fsds-shuttle-color-list-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-shuttle-color-item-marked-background: var(--fsds-semantic-color-background-accent, #d92d2e);
    --fsds-shuttle-color-item-marked-foreground: var(--fsds-semantic-color-foreground-on-color, #ffffff);
    --fsds-shuttle-color-focus-ring: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-shuttle-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-shuttle-size-padding: var(--fsds-core-spacing-size-07, 24px);
    --fsds-shuttle-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
}

.shuttle {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.shuttle {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    background-color: var(--fsds-shuttle-color-background, #f7f7f7);
    border-color: var(--fsds-shuttle-color-border-accent, #d92d2e);
    padding: var(--fsds-shuttle-size-padding, 24px);
    border-radius: var(--fsds-shuttle-size-radius, 6px);
}

.shuttle__list {
    margin: 0;
    padding: 0;
    background-color: var(--fsds-shuttle-color-list-background, #ffffff);
    border-width: 1px;
    border-color: var(--fsds-shuttle-color-border, #d0d0d0);
    border-radius: var(--fsds-shuttle-size-radius, 6px);
}

.shuttle__item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    color: var(--fsds-shuttle-color-foreground-primary, #141414);
    border-bottom-width: 1px;
    border-bottom-color: var(--fsds-shuttle-color-border, #d0d0d0);
}

.shuttle__item:focus {
    border-width: var(--fsds-shuttle-focus-ring-width, 2px);
    border-color: var(--fsds-shuttle-color-focus-ring, #0566fe);
}

.shuttle__controls {
    display: flex;
    flex-direction: column;
    justify-content: center;
    --fsds-gap: 8px;
}

.shuttle__add {
    padding: 6px 12px;
    color: var(--fsds-shuttle-color-foreground-primary, #141414);
    background-color: var(--fsds-shuttle-color-list-background, #ffffff);
    border-width: 1px;
    border-color: var(--fsds-shuttle-color-border, #d0d0d0);
    border-radius: var(--fsds-shuttle-size-radius, 6px);
}

.shuttle__remove {
    padding: 6px 12px;
    color: var(--fsds-shuttle-color-foreground-primary, #141414);
    background-color: var(--fsds-shuttle-color-list-background, #ffffff);
    border-width: 1px;
    border-color: var(--fsds-shuttle-color-border, #d0d0d0);
    border-radius: var(--fsds-shuttle-size-radius, 6px);
}

/* ShowMore (.show-more) */
.show-more {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-action-size-medium-padding-block, 4px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-action-size-medium-padding-inline, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-action-size-medium-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-action-size-medium-min-width, 32px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: var(--fsds-semantic-action-size-medium-min-height, 32px);
    --fsds-box-model-max-height: none;
    --fsds-show-more-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-show-more-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-show-more-color-foreground-secondary: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-show-more-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-show-more-size-padding: var(--fsds-core-spacing-size-07, 24px);
    --fsds-show-more-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
}

.show-more {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 4px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 4px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 32px);
    min-height: var(--fsds-box-model-min-height, 32px);
}

.show-more {
    background-color: var(--fsds-show-more-color-background, #f7f7f7);
    color: var(--fsds-show-more-color-foreground-secondary, #474647);
    padding: var(--fsds-show-more-size-padding, 24px);
    border-radius: var(--fsds-show-more-size-radius, 6px);
}

.show-more__content {
    overflow: hidden;
}

.show-more__trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
    color: var(--fsds-show-more-color-foreground-primary, #141414);
    border-width: 1px;
    border-color: var(--fsds-show-more-color-border, #d0d0d0);
    padding: 0;
}

/* Truncate (.truncate) */
.truncate {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-truncate-color-foreground-link: var(--fsds-semantic-color-foreground-link, #d92d2e);
    --fsds-truncate-typography-font-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-truncate-spacing-toggle: var(--fsds-core-spacing-size-02, 2px);
}

.truncate {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.truncate {
    display: flex;
    flex-direction: column;
}

.truncate__content {
    overflow: hidden;
}

.truncate__toggle {
    display: flex;
    flex-direction: row;
    align-items: center;
    color: var(--fsds-truncate-color-foreground-link, #d92d2e);
    margin-top: var(--fsds-truncate-spacing-toggle, 2px);
    border-width: 0;
    padding: 0;
}

/* PageNavigator (.page-navigator) */
.page-navigator {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
}

.page-navigator {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.page-navigator {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: 8px;
    flex-wrap: wrap;
}

.page-navigator__field {
    width: 64px;
}

.page-navigator__input {
    width: 100%;
}

/* Carousel (.carousel) */
.carousel {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-carousel-color-foreground: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-carousel-color-progress: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-carousel-spacing-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-carousel-timing-advance: var(--fsds-core-motion-dwell-medium, 6000ms);
    --fsds-carousel-size-control-size: var(--fsds-core-spacing-size-08, 32px);
    --fsds-carousel-size-radius: var(--fsds-core-shape-radius-full, 9999px);
    --fsds-carousel-motion-duration: var(--fsds-core-motion-duration-medium, 250ms);
}

.carousel {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.carousel {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-carousel-spacing-gap, 8px);
    color: var(--fsds-carousel-color-foreground, #141414);
}

.carousel__viewport {
    min-width: 0;
    position: relative;
    overflow: hidden;
}

.carousel__controls {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    --fsds-gap: var(--fsds-carousel-spacing-gap, 8px);
}

.carousel__ring {
    position: absolute;
    border-radius: 50%;
    color: var(--fsds-carousel-color-progress, #141414);
    display: none;
}

.carousel__next {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    min-width: var(--fsds-carousel-size-control-size, 32px);
    min-height: var(--fsds-carousel-size-control-size, 32px);
    border-radius: var(--fsds-carousel-size-radius, 9999px);
    background-color: rgba(0, 0, 0, 0);
}

.carousel__previous {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    min-width: var(--fsds-carousel-size-control-size, 32px);
    min-height: var(--fsds-carousel-size-control-size, 32px);
    border-radius: var(--fsds-carousel-size-radius, 9999px);
    background-color: rgba(0, 0, 0, 0);
}

.carousel__rotation {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    min-width: var(--fsds-carousel-size-control-size, 32px);
    min-height: var(--fsds-carousel-size-control-size, 32px);
    border-radius: var(--fsds-carousel-size-radius, 9999px);
    background-color: rgba(0, 0, 0, 0);
    align-self: flex-start;
    padding-left: 12px;
    padding-right: 12px;
}

/* Calendar (.calendar) */
.calendar {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-calendar-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-calendar-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-calendar-color-foreground-muted: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-calendar-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-calendar-color-day-hover: var(--fsds-semantic-interaction-background-hover, #f7f7f7);
    --fsds-calendar-color-day-selected-background: var(--fsds-semantic-color-background-accent, #d92d2e);
    --fsds-calendar-color-day-selected-foreground: var(--fsds-semantic-color-foreground-inverse, #fafafa);
    --fsds-calendar-color-today-ring: var(--fsds-semantic-color-border-accent, #d92d2e);
    --fsds-calendar-color-focus-ring: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-calendar-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-calendar-size-cell: var(--fsds-core-spacing-size-08, 32px);
    --fsds-calendar-size-nav: var(--fsds-core-spacing-size-07, 24px);
    --fsds-calendar-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-calendar-size-radius-day: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-calendar-typography-caption-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-calendar-typography-day-size: var(--fsds-semantic-typography-body-03, 14px);
    --fsds-calendar-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-calendar-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
}

.calendar {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.calendar {
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-calendar-color-background, #ffffff);
    color: var(--fsds-calendar-color-foreground-primary, #141414);
    border-color: var(--fsds-calendar-color-border, #d0d0d0);
    border-width: 1px;
    padding: var(--fsds-calendar-size-padding, 16px);
    border-radius: var(--fsds-calendar-size-radius, 6px);
}

.calendar__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--fsds-calendar-size-padding, 16px);
}

.calendar__nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--fsds-calendar-size-nav, 24px);
    height: var(--fsds-calendar-size-nav, 24px);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: var(--fsds-calendar-size-radius-day, 4px);
    color: var(--fsds-calendar-color-foreground-muted, #474647);
    font-size: var(--fsds-calendar-typography-caption-size, 16px);
}

.calendar__nav:hover {
    background-color: var(--fsds-calendar-color-day-hover, #f7f7f7);
    color: var(--fsds-calendar-color-foreground-primary, #141414);
}

.calendar__caption {
    font-size: var(--fsds-calendar-typography-caption-size, 16px);
    -unity-font-style: bold;
    color: var(--fsds-calendar-color-foreground-primary, #141414);
}

.calendar__grid {
    --fsds-gap: 2px;
    width: 100%;
}

.calendar__day {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: var(--fsds-calendar-size-cell, 32px);
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: var(--fsds-calendar-typography-day-size, 14px);
    border-radius: var(--fsds-calendar-size-radius-day, 4px);
}

.calendar__day:hover {
    background-color: var(--fsds-calendar-color-day-hover, #f7f7f7);
}

.calendar__day:focus {
    border-width: var(--fsds-calendar-focus-ring-width, 2px);
    border-color: var(--fsds-calendar-color-focus-ring, #0566fe);
}

/* Command (.command) */
.command {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-command-color-overlay: var(--fsds-semantic-overlay-scrim-strong, rgba(0, 0, 0, 0.64));
    --fsds-command-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-command-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-command-color-border-light: var(--fsds-semantic-color-border-subtle, #d0d0d0);
    --fsds-command-color-text: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-command-color-text-muted: var(--fsds-semantic-color-foreground-tertiary, #727272);
    --fsds-command-border-width: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-command-border-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-command-size-max-width: 640px;
    --fsds-command-size-max-height: 400px;
    --fsds-command-size-icon: var(--fsds-core-spacing-size-04, 8px);
    --fsds-command-spacing-dialog-padding: var(--fsds-core-spacing-size-04, 8px);
    --fsds-command-text-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-command-text-size-small: var(--fsds-semantic-typography-body-04, 12px);
    --fsds-command-opacity-disabled: var(--fsds-semantic-interaction-disabled-opacity, 0.5);
    --fsds-command-color-background-hover: var(--fsds-semantic-interaction-background-hover, #f7f7f7);
}

.command {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.command:disabled {
    opacity: var(--fsds-command-opacity-disabled, 0.5);
}

.command {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
}

.command__overlay {
    position: absolute;
    background-color: var(--fsds-command-color-overlay, rgba(0, 0, 0, 0.64));
}

.command__dialog {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: var(--fsds-command-size-max-width, 640px);
    max-height: var(--fsds-command-size-max-height, 400px);
    background-color: var(--fsds-command-color-background, #ffffff);
    color: var(--fsds-command-color-text, #141414);
    border-color: var(--fsds-command-color-border, #d0d0d0);
    border-width: var(--fsds-command-border-width, 1px);
    border-radius: var(--fsds-command-border-radius, 6px);
    overflow: hidden;
}

.command__inputWrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: 8px;
    padding: var(--fsds-command-spacing-dialog-padding, 8px);
    border-bottom-color: var(--fsds-command-color-border-light, #d0d0d0);
    border-bottom-width: 1px;
}

.command__searchIcon {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--fsds-command-size-icon, 8px);
    height: var(--fsds-command-size-icon, 8px);
    color: var(--fsds-command-color-text-muted, #727272);
}

.command__input {
    flex: 1 1 auto;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    color: var(--fsds-command-color-text, #141414);
    font-size: var(--fsds-command-text-size, 16px);
}

.command__list {
    flex: 1 1 auto;
    padding: 4px 0;
    margin: 0;
}

.command__empty {
    display: flex;
    flex-direction: column;
    padding: var(--fsds-command-spacing-dialog-padding, 8px);
    color: var(--fsds-command-color-text-muted, #727272);
    font-size: var(--fsds-command-text-size-small, 12px);
}

.command__group {
    display: flex;
    flex-direction: column;
}

.command__groupHeading {
    display: flex;
    flex-direction: column;
    padding: 8px 12px 4px;
    color: var(--fsds-command-color-text-muted, #727272);
    font-size: var(--fsds-command-text-size-small, 12px);
    -unity-font-style: bold;
}

.command__groupItems {
    display: flex;
    flex-direction: column;
}

.command__item {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: 8px;
    padding: 8px 12px;
    color: var(--fsds-command-color-text, #141414);
    border-radius: var(--fsds-command-border-radius, 6px);
}

.command__item:hover {
    background-color: var(--fsds-command-color-background-hover, #f7f7f7);
}

.command__itemIcon {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--fsds-command-size-icon, 8px);
    height: var(--fsds-command-size-icon, 8px);
    color: var(--fsds-command-color-text-muted, #727272);
}

.command__itemContent {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.command__itemLabel {
    display: flex;
    flex-direction: column;
    color: var(--fsds-command-color-text, #141414);
    font-size: var(--fsds-command-text-size, 16px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.command__itemDescription {
    display: flex;
    flex-direction: column;
    color: var(--fsds-command-color-text-muted, #727272);
    font-size: var(--fsds-command-text-size-small, 12px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.command__separator {
    display: flex;
    flex-direction: column;
    height: 1px;
    margin: 4px 8px;
    background-color: var(--fsds-command-color-border-light, #d0d0d0);
}

/* Spinner (.spinner) */
.spinner {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-spinner-size-xs: var(--fsds-semantic-glyph-size-small-extent, 12px);
    --fsds-spinner-size-sm: var(--fsds-core-icon-size-sm, 16px);
    --fsds-spinner-size-md: var(--fsds-core-icon-size-md, 20px);
    --fsds-spinner-size-lg: var(--fsds-core-icon-size-lg, 24px);
    --fsds-spinner-thickness-hairline: 2px;
    --fsds-spinner-thickness-regular: 3px;
    --fsds-spinner-thickness-bold: 4px;
    --fsds-spinner-color-accent: var(--fsds-semantic-color-background-accent, #d92d2e);
    --fsds-spinner-color-track: var(--fsds-semantic-color-border-subtle, #d0d0d0);
    --fsds-spinner-anim-duration: 800ms;
}

.spinner {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.spinner__visual {
    display: flex;
    flex-direction: column;
    border-radius: 50%;
    border-width: var(--fsds-spinner-thickness-regular, 3px);
    border-color: var(--fsds-spinner-color-track, #d0d0d0);
    border-top-color: var(--fsds-spinner-color-accent, #d92d2e);
}

.spinner.spinner--xs {
    font-size: var(--fsds-spinner-size-xs, 12px);
}

.spinner.spinner--sm {
    font-size: var(--fsds-spinner-size-sm, 16px);
}

.spinner.spinner--md {
    font-size: var(--fsds-spinner-size-md, 20px);
}

.spinner.spinner--lg {
    font-size: var(--fsds-spinner-size-lg, 24px);
}

.spinner--hairline .spinner__visual {
    border-width: var(--fsds-spinner-thickness-hairline, 2px);
}

.spinner--regular .spinner__visual {
    border-width: var(--fsds-spinner-thickness-regular, 3px);
}

.spinner--bold .spinner__visual {
    border-width: var(--fsds-spinner-thickness-bold, 4px);
}

/* Markdown (.markdown) */
.markdown {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-markdown-color-foreground: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-markdown-typography-font-size: var(--fsds-core-typography-ramp-3, 14px);
    --fsds-markdown-typography-line-height: var(--fsds-semantic-typography-line-height-body, 1.5);
}

.markdown {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.markdown {
    color: var(--fsds-markdown-color-foreground, #141414);
    font-size: var(--fsds-markdown-typography-font-size, 14px);
}
