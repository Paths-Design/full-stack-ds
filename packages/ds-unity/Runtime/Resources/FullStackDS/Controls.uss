    --fsds-alert-notice-typography-title-font-weight: var(--fsds-semantic-typography-font-weight-bold, 700);
    --fsds-alert-notice-color-background-info: var(--fsds-semantic-color-background-info-softer, #cfeefe);
    --fsds-alert-notice-color-background-success: var(--fsds-semantic-color-background-success-softer, #ddefd8);
    --fsds-alert-notice-color-background-warning: var(--fsds-semantic-color-background-warning-softer, #ffe6c8);
    --fsds-alert-notice-color-background-danger: var(--fsds-semantic-color-background-danger-softer, #fee4e4);
}

/* Label (.label) */
.label {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-label-color-text: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-label-typo-line-height: var(--fsds-semantic-typography-line-height-tight, 1.2);
}

.label {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.label {
    color: var(--fsds-label-color-text, #141414);
}

/* Breadcrumbs (.breadcrumbs) */
.breadcrumbs {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-breadcrumbs-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-breadcrumbs-color-background-elevated: var(--fsds-semantic-color-background-elevated, #ffffff);
    --fsds-breadcrumbs-color-border-subtle: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-breadcrumbs-typography-line-height-collapse: var(--fsds-semantic-typography-line-height-collapse, 1);
    --fsds-breadcrumbs-shape-radius-medium: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-breadcrumbs-spacing-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-breadcrumbs-spacing-padding: var(--fsds-core-spacing-size-04, 8px);
    --fsds-breadcrumbs-color-focus: var(--fsds-semantic-focus-ring-color, #0566fe);
}

.breadcrumbs {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.breadcrumbs {
    background-color: var(--fsds-breadcrumbs-color-background-elevated, #ffffff);
    border-color: var(--fsds-breadcrumbs-color-border-subtle, #d0d0d0);
    display: flex;
    flex-direction: column;
    border-radius: var(--fsds-breadcrumbs-shape-radius-medium, 6px);
    padding: var(--fsds-breadcrumbs-spacing-padding, 8px);
    color: var(--fsds-breadcrumbs-color-foreground-primary, #141414);
}

.breadcrumbs:focus {
    border-color: var(--fsds-breadcrumbs-color-focus, #0566fe);
}

.breadcrumbs__list {
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    --fsds-gap: var(--fsds-breadcrumbs-spacing-gap, 8px);
}

/* Tooltip (.tooltip) */
.tooltip {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-tooltip-color-background: var(--fsds-semantic-color-background-inverse, #141414);
    --fsds-tooltip-color-foreground: var(--fsds-semantic-color-foreground-on-inverse, #fafafa);
    --fsds-tooltip-color-border: var(--fsds-semantic-color-border-subtle, #d0d0d0);
    --fsds-tooltip-size-padding-x: var(--fsds-core-spacing-size-04, 8px);
    --fsds-tooltip-size-radius: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-tooltip-size-max-width: 200px;
    --fsds-tooltip-typography-font-size: var(--fsds-semantic-typography-caption-01, 14px);
    --fsds-tooltip-layer-content: var(--fsds-core-layer-tooltip, 1800);
}

.tooltip {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.tooltip {
    display: flex;
    flex-direction: column;
}

.tooltip__trigger {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.tooltip__content {
    background-color: var(--fsds-tooltip-color-background, #141414);
    color: var(--fsds-tooltip-color-foreground, #fafafa);
    border-color: var(--fsds-tooltip-color-border, #d0d0d0);
    border-radius: var(--fsds-tooltip-size-radius, 4px);
    padding: var(--fsds-tooltip-size-padding-x, 8px);
    max-width: var(--fsds-tooltip-size-max-width, 200px);
    font-size: var(--fsds-tooltip-typography-font-size, 14px);
    display: flex;
    flex-direction: column;
    border-width: 1px;
}

.tooltip__content {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-tooltip-color-background: var(--fsds-semantic-color-background-inverse, #141414);
    --fsds-tooltip-color-foreground: var(--fsds-semantic-color-foreground-on-inverse, #fafafa);
    --fsds-tooltip-color-border: var(--fsds-semantic-color-border-subtle, #d0d0d0);
    --fsds-tooltip-size-padding-x: var(--fsds-core-spacing-size-04, 8px);
    --fsds-tooltip-size-radius: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-tooltip-size-max-width: 200px;
    --fsds-tooltip-typography-font-size: var(--fsds-semantic-typography-caption-01, 14px);
    --fsds-tooltip-layer-content: var(--fsds-core-layer-tooltip, 1800);
}

/* Status (.status) */
.status {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-glyph-badge-size-md-padding-y, 2px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-glyph-badge-size-md-padding-y, 2px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-glyph-badge-size-md-padding-x, 8px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-glyph-badge-size-md-padding-x, 8px);
    --fsds-box-model-gap: var(--fsds-semantic-glyph-badge-size-md-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-status-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-status-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-status-size-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-status-size-min-height: var(--fsds-semantic-glyph-badge-size-md-min-height, 24px);
    --fsds-status-size-font-size: var(--fsds-semantic-glyph-badge-size-md-font-size, 12px);
    --fsds-status-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-status-text-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-status-typography-line-height: var(--fsds-semantic-typography-line-height-collapse, 1);
}

.status {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 2px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 2px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 8px);
    padding-right: var(--fsds-box-model-padding-inline-end, 8px);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.status {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    background-color: var(--fsds-status-color-background, #f7f7f7);
    color: var(--fsds-status-color-foreground-primary, #474647);
    border-color: var(--fsds-status-color-border, #d0d0d0);
    border-width: var(--fsds-status-size-border, 1px);
    border-radius: var(--fsds-status-size-radius, 9999px);
    min-height: var(--fsds-status-size-min-height, 24px);
    font-size: var(--fsds-status-size-font-size, 12px);
}

.status__icon {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.status__label {
    display: flex;
    flex-direction: column;
    color: var(--fsds-status-color-foreground-primary, #474647);
}

.status.status--info {
    --fsds-status-color-background: var(--fsds-semantic-color-background-info-subtle, #95dafb);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-info-subtle, #013ab0);
    --fsds-status-color-border: var(--fsds-semantic-color-border-info, #034fd6);
}

.status.status--success {
    --fsds-status-color-background: var(--fsds-semantic-color-background-success-subtle, #b3dba7);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-success-subtle, #2c4f09);
    --fsds-status-color-border: var(--fsds-semantic-color-border-success, #3a6614);
}

.status.status--warning {
    --fsds-status-color-background: var(--fsds-semantic-color-background-warning-subtle, #fdc67f);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-warning-subtle, #6c3a00);
    --fsds-status-color-border: var(--fsds-semantic-color-border-warning, #8b4b00);
}

.status.status--danger {
    --fsds-status-color-background: var(--fsds-semantic-color-background-danger-subtle, #fac2c2);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-danger-subtle, #900909);
    --fsds-status-color-border: var(--fsds-semantic-color-border-danger, #b31b1b);
}

.status.status--error {
    --fsds-status-color-background: var(--fsds-semantic-color-background-danger-subtle, #fac2c2);
    --fsds-status-color-foreground-primary: var(--fsds-semantic-color-foreground-on-danger-subtle, #900909);
    --fsds-status-color-border: var(--fsds-semantic-color-border-danger, #b31b1b);
}

/* Card (.card) */
.card {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-card-color-background-default: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-card-color-background-hover: var(--fsds-semantic-color-background-hover, #f7f7f7);
    --fsds-card-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-card-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-card-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-card-size-padding-inset: var(--fsds-core-spacing-size-04, 8px);
    --fsds-card-size-radius: var(--fsds-semantic-shape-radius-medium, 8px);
    --fsds-card-size-gap: var(--fsds-core-spacing-size-03, 4px);
    --fsds-card-typography-line-height-heading: var(--fsds-semantic-typography-line-height-heading, 1);
    --fsds-card-typography-line-height-normal: var(--fsds-semantic-typography-line-height-normal, 1.5);
    --fsds-card-color-focus-ring: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-card-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-card-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
}

.card {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.card {
    background-color: var(--fsds-card-color-background-default, #ffffff);
    border-color: var(--fsds-card-color-border, #d0d0d0);
    color: var(--fsds-card-color-foreground-primary, #141414);
    padding: var(--fsds-card-size-padding, 16px);
    border-radius: var(--fsds-card-size-radius, 8px);
    --fsds-gap: var(--fsds-card-size-gap, 4px);
    display: flex;
    flex-direction: column;
    border-width: 1px;
}

.card:focus {
    border-width: var(--fsds-card-focus-ring-width, 2px);
    border-color: var(--fsds-card-color-focus-ring, #0566fe);
}

.card.card--inset {
    padding: var(--fsds-card-size-padding-inset, 8px);
}

.card__header {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    --fsds-gap: var(--fsds-card-size-gap, 4px);
    color: var(--fsds-card-color-foreground-primary, #141414);
}

.card__media {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border-radius: var(--fsds-card-size-radius, 8px);
}

.card__content {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-card-size-gap, 4px);
    flex: 1 1 auto;
    color: var(--fsds-card-color-foreground-primary, #141414);
}

.card__description {
    margin: 0;
    --fsds-card-color-foreground-primary: var(--fsds-semantic-color-foreground-secondary, #474647);
}

.card__footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    --fsds-gap: var(--fsds-card-size-gap, 4px);
    padding-top: var(--fsds-card-size-padding, 16px);
    margin-top: auto;
    border-top-color: var(--fsds-card-color-border, #d0d0d0);
    border-top-width: 1px;
}

.card__actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-card-size-gap, 4px);
}

.card__badge {
    display: flex;
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
}

.card__link {
    --fsds-card-color-foreground-primary: var(--fsds-semantic-color-foreground-link, #d92d2e);
}

.card__note {
    --fsds-card-color-foreground-primary: var(--fsds-semantic-color-foreground-secondary, #474647);
}

/* NavList (.nav-list) */
.nav-list {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-nav-list-color-foreground-default: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-nav-list-color-foreground-hover: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-nav-list-color-foreground-current: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-nav-list-color-background-default: var(--fsds-semantic-color-background-transparent, rgba(0, 0, 0, 0));
    --fsds-nav-list-color-background-hover: var(--fsds-semantic-color-background-subtle, #f7f7f7);
    --fsds-nav-list-state-layer-hover: var(--fsds-semantic-interaction-state-layer-hover, 0.04);
    --fsds-nav-list-state-layer-selected: var(--fsds-semantic-interaction-state-layer-selected, 0.08);
    --fsds-nav-list-color-outline-focus: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-nav-list-size-padding-block: var(--fsds-core-spacing-size-02, 2px);
    --fsds-nav-list-size-padding-inline: var(--fsds-core-spacing-size-04, 8px);
    --fsds-nav-list-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-nav-list-size-gap-list: var(--fsds-core-spacing-size-01, 1px);
}

.nav-list {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.nav-list {
    display: flex;
    flex-direction: column;
}

.nav-list__list {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-nav-list-size-gap-list, 1px);
    margin: 0;
    padding: 0;
}

.nav-list__item {
    display: flex;
    flex-direction: column;
    color: var(--fsds-nav-list-color-foreground-default, #474647);
    padding-top: var(--fsds-nav-list-size-padding-block, 2px);
    padding-bottom: var(--fsds-nav-list-size-padding-block, 2px);
    padding-left: var(--fsds-nav-list-size-padding-inline, 8px);
    padding-right: var(--fsds-nav-list-size-padding-inline, 8px);
    border-radius: var(--fsds-nav-list-size-radius, 6px);
}

.nav-list__item:hover {
    color: var(--fsds-nav-list-color-foreground-hover, #141414);
}

.nav-list__item:focus {
    border-width: var(--fsds-semantic-focus-ring-width, 2px);
    border-color: var(--fsds-nav-list-color-outline-focus, #0566fe);
}

/* Skeleton (.skeleton) */
.skeleton {
    --fsds-box-model-width: 100%;
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-max-height: none;
    --fsds-skeleton-color-base: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-skeleton-color-highlight: var(--fsds-semantic-color-background-highlight, #f5a2a1);
    --fsds-skeleton-radius-sm: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    --fsds-skeleton-gap-compact: var(--fsds-core-spacing-size-03, 4px);
    --fsds-skeleton-gap-md: var(--fsds-core-spacing-size-05, 12px);
    --fsds-skeleton-gap-spacious: var(--fsds-core-spacing-size-07, 24px);
    --fsds-skeleton-anim-duration: var(--fsds-core-motion-duration-long, 400ms);
    --fsds-skeleton-shape-height-text: var(--fsds-core-typography-ramp-4, 16px);
}

.skeleton {
    width: var(--fsds-box-model-width, 100%);
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    display: flex;
    flex-direction: column;
}

.skeleton {
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-skeleton-color-base, #f7f7f7);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton__shape {
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-skeleton-color-base, #f7f7f7);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton__stack {
    display: flex;
    flex-direction: column;
    --fsds-gap: var(--fsds-skeleton-gap-md, 12px);
}

.skeleton.skeleton--block {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton.skeleton--text {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-small, 4px);
    --fsds-skeleton-shape-height-text: var(--fsds-core-typography-ramp-4, 16px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton.skeleton--avatar {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
}

.skeleton.skeleton--media {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
    width: 100%;
}

.skeleton.skeleton--dataviz {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
    width: 100%;
}

.skeleton.skeleton--actions {
    --fsds-skeleton-radius-md: var(--fsds-semantic-shape-radius-medium, 8px);
    border-radius: var(--fsds-skeleton-radius-md, 8px);
    height: 36px;
    min-width: 80px;
}

.skeleton.skeleton--wipe {
    --fsds-skeleton-color-base: var(--fsds-semantic-color-background-tertiary, #d0d0d0);
    overflow: hidden;
    position: relative;
}

.skeleton.skeleton--compact {
    --fsds-skeleton-gap-md: var(--fsds-skeleton-gap-compact, 4px);
}

.skeleton.skeleton--regular {
    --fsds-skeleton-gap-md: var(--fsds-core-spacing-size-05, 12px);
}

.skeleton.skeleton--spacious {
    --fsds-skeleton-gap-md: var(--fsds-skeleton-gap-spacious, 24px);
}

/* Table (.table) */
.table {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-table-color-text: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-table-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-table-color-background-footer: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-table-border-width: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-table-spacing-cell-x: var(--fsds-core-spacing-size-03, 4px);
    --fsds-table-spacing-cell-y: var(--fsds-core-spacing-size-02, 2px);
    --fsds-table-spacing-caption: var(--fsds-core-spacing-size-04, 8px);
    --fsds-table-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-table-text-size: var(--fsds-semantic-typography-body-03, 14px);
    --fsds-table-text-line-height: var(--fsds-semantic-typography-line-height-normal, 1.5);
    --fsds-table-text-size-caption: var(--fsds-semantic-typography-body-04, 12px);
    --fsds-table-text-weight-head: var(--fsds-semantic-typography-font-weight-bold, 700);
    --fsds-table-text-weight-footer: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-table-color-background-hover: var(--fsds-semantic-interaction-background-hover, #f7f7f7);
    --fsds-table-color-background-selected: var(--fsds-semantic-color-background-accent-subtle, #95dafb);
}

.table {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.table {
    color: var(--fsds-table-color-text, #141414);
    font-size: var(--fsds-table-text-size, 14px);
    width: 100%;
}

.table__container {
    border-color: var(--fsds-table-color-border, #d0d0d0);
    border-width: var(--fsds-table-border-width, 1px);
    border-radius: var(--fsds-table-size-radius, 6px);
    width: 100%;
}

.table__caption {
    font-size: var(--fsds-table-text-size-caption, 12px);
    padding-bottom: var(--fsds-table-spacing-caption, 8px);
}

.table__head {
    background-color: var(--fsds-table-color-background-footer, #f7f7f7);
}

.table__footer {
    background-color: var(--fsds-table-color-background-footer, #f7f7f7);
}

.table__headerCell {
    -unity-font-style: bold;
    color: var(--fsds-table-color-text, #141414);
    padding-left: var(--fsds-table-spacing-cell-x, 4px);
    padding-right: var(--fsds-table-spacing-cell-x, 4px);
    padding-top: var(--fsds-table-spacing-cell-y, 2px);
    padding-bottom: var(--fsds-table-spacing-cell-y, 2px);
    border-bottom-width: var(--fsds-table-border-width, 1px);
    border-bottom-color: var(--fsds-table-color-border, #d0d0d0);
}

.table__cell {
    padding-left: var(--fsds-table-spacing-cell-x, 4px);
    padding-right: var(--fsds-table-spacing-cell-x, 4px);
    padding-top: var(--fsds-table-spacing-cell-y, 2px);
    padding-bottom: var(--fsds-table-spacing-cell-y, 2px);
    border-bottom-width: var(--fsds-table-border-width, 1px);
    border-bottom-color: var(--fsds-table-color-border, #d0d0d0);
}

.table:hover {
    background-color: var(--fsds-table-color-background-hover, #f7f7f7);
}

/* CodeBlock (.code-block) */
.code-block {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-code-block-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-code-block-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-code-block-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-code-block-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-code-block-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-code-block-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-code-block-size-font-size: var(--fsds-core-typography-ramp-3, 14px);
    --fsds-code-block-typography-line-height: var(--fsds-semantic-typography-line-height-body, 1.5);
    --fsds-code-block-token-color-plain: var(--fsds-semantic-color-foreground-syntax-plain, #141414);
    --fsds-code-block-token-color-comment: var(--fsds-semantic-color-foreground-syntax-comment-color, #474647);
    --fsds-code-block-token-color-keyword: var(--fsds-semantic-color-foreground-syntax-keyword, #013ab0);
    --fsds-code-block-token-color-definition: var(--fsds-semantic-color-foreground-syntax-definition, #900909);
    --fsds-code-block-token-color-punctuation: var(--fsds-semantic-color-foreground-syntax-punctuation, #013ab0);
    --fsds-code-block-token-color-property: var(--fsds-semantic-color-foreground-syntax-property, #6c3a00);
    --fsds-code-block-token-color-static: var(--fsds-semantic-color-foreground-syntax-static, #900909);
    --fsds-code-block-token-color-string: var(--fsds-semantic-color-foreground-syntax-string, #900909);
    --fsds-code-block-token-color-tag: var(--fsds-semantic-color-foreground-syntax-tag, #900909);
    --fsds-code-block-gutter-color-number: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-code-block-gutter-size-gap: var(--fsds-core-spacing-size-03, 4px);
}

.code-block {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.code-block {
    background-color: var(--fsds-code-block-color-background, #f7f7f7);
    border-color: var(--fsds-code-block-color-border, #d0d0d0);
    border-width: var(--fsds-code-block-size-border, 1px);
    border-radius: var(--fsds-code-block-size-radius, 6px);
    color: var(--fsds-code-block-color-foreground-primary, #141414);
    font-size: var(--fsds-code-block-size-font-size, 14px);
    margin: 0;
    padding: var(--fsds-code-block-size-padding, 16px);
}

.code-block__code {
    display: flex;
    flex-direction: column;
}

.code-block__code > .code-block__children {
    display: flex;
    flex-direction: column;
}

.code-block__gutter {
    display: none;
}

/* Details (.details) */
.details {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-structure-size-gap, 16px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-details-size-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-details-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-details-size-icon: var(--fsds-core-spacing-size-05, 12px);
    --fsds-details-color-background-default: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-details-color-background-hover: var(--fsds-semantic-color-background-hover, #f7f7f7);
    --fsds-details-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-details-color-border-default: var(--fsds-semantic-color-border-primary, #a0a0a1);
    --fsds-details-color-border-hover: var(--fsds-semantic-color-border-bold, #888889);
    --fsds-details-focus-ring-width: var(--fsds-semantic-focus-ring-width, 2px);
    --fsds-details-focus-ring-color: var(--fsds-semantic-focus-ring-color, #0566fe);
    --fsds-details-focus-ring-offset: var(--fsds-semantic-focus-ring-offset, 2px);
    --fsds-details-spacing-gap: var(--fsds-core-spacing-size-02, 2px);
    --fsds-details-typography-line-height-body: var(--fsds-semantic-typography-line-height-body, 1.5);
    --fsds-details-typography-font-weight-medium: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-details-size-padding-compact: var(--fsds-core-spacing-size-04, 8px);
}

.details {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 16px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.details {
    padding: var(--fsds-details-size-padding, 16px);
    border-radius: var(--fsds-details-size-radius, 6px);
    background-color: var(--fsds-details-color-background-default, #ffffff);
    --fsds-gap: var(--fsds-details-spacing-gap, 2px);
    display: flex;
    flex-direction: column;
    border-width: 1px;
    border-color: var(--fsds-details-color-border-default, #a0a0a1);
    color: var(--fsds-details-color-foreground-primary, #141414);
}

.details:hover {
    background-color: var(--fsds-details-color-background-hover, #f7f7f7);
    border-color: var(--fsds-details-color-border-hover, #888889);
}

.details__summary {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-details-spacing-gap, 2px);
    padding: var(--fsds-details-size-padding, 16px);
    color: var(--fsds-details-color-foreground-primary, #141414);
}

.details__summary:hover {
    --fsds-details-color-background-default: var(--fsds-semantic-color-background-hover, #f7f7f7);
}

.details__summary:focus {
    border-width: var(--fsds-details-focus-ring-width, 2px);
    border-color: var(--fsds-details-focus-ring-color, #0566fe);
}

.details__summaryContent {
    display: flex;
    flex-direction: row;
    align-items: center;
    --fsds-gap: var(--fsds-details-spacing-gap, 2px);
    flex: 1 1 auto;
}

.details__summaryText {
    flex: 1 1 auto;
    color: var(--fsds-details-color-foreground-primary, #141414);
}

.details__icon {
    display: flex;
    flex-direction: row;
    flex-shrink: 0;
    width: var(--fsds-details-size-icon, 12px);
    height: var(--fsds-details-size-icon, 12px);
    align-items: center;
    justify-content: center;
}

.details__content {
    display: flex;
    flex-direction: column;
    padding: var(--fsds-details-size-padding, 16px);
    color: var(--fsds-details-color-foreground-primary, #141414);
}

.details.details--compact {
    --fsds-details-size-padding: var(--fsds-details-size-padding-compact, 8px);
    --fsds-details-typography-line-height-body: var(--fsds-core-spacing-size-06, 16px);
}

.details.details--inline {
    --fsds-details-size-padding: var(--fsds-core-spacing-size-07, 24px);
    --fsds-details-color-background-default: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-details-color-border-default: var(--fsds-semantic-color-border-subtle, #d0d0d0);
}

.details--none .details__icon {
    display: none;
}

.details--right .details__icon {
    margin-left: auto;
}

/* Progress (.progress) */
.progress {
    --fsds-box-model-width: 100%;
    --fsds-box-model-height: 8px;
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: 0;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-progress-color-text: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-progress-spacing-gap: var(--fsds-core-spacing-size-02, 2px);
    --fsds-progress-motion-duration-indeterminate: var(--fsds-core-motion-duration-extra-long1, 1500ms);
    --fsds-progress-color-track-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-progress-color-fill-info: var(--fsds-semantic-color-status-info, #0566fe);
    --fsds-progress-color-fill-success: var(--fsds-semantic-color-status-success, #497f21);
    --fsds-progress-color-fill-warning: var(--fsds-semantic-color-status-warning, #ae5d00);
    --fsds-progress-color-fill-danger: var(--fsds-semantic-color-status-danger, #d92d2e);
}

.progress {
    width: var(--fsds-box-model-width, 100%);
    height: var(--fsds-box-model-height, 8px);
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 0);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
    display: flex;
    flex-direction: column;
}

.progress {
    color: var(--fsds-progress-color-text, #474647);
    --fsds-gap: var(--fsds-progress-spacing-gap, 2px);
}

.progress__track {
    background-color: var(--fsds-progress-color-track-background, #f7f7f7);
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.progress__fill {
    background-color: var(--fsds-progress-color-fill-info, #0566fe);
    display: flex;
    flex-direction: column;
    height: 100%;
}

.progress__value {
    display: flex;
    flex-direction: column;
    color: var(--fsds-progress-color-text, #474647);
    margin-left: var(--fsds-progress-spacing-gap, 2px);
}

.progress--info .progress__fill {
    background-color: var(--fsds-progress-color-fill-info, #0566fe);
}

.progress--success .progress__fill {
    background-color: var(--fsds-progress-color-fill-success, #497f21);
}

.progress--warning .progress__fill {
    background-color: var(--fsds-progress-color-fill-warning, #ae5d00);
}

.progress--danger .progress__fill {
    background-color: var(--fsds-progress-color-fill-danger, #d92d2e);
}

/* Chip (.chip) */
.chip {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: 0;
    --fsds-box-model-padding-block-end: 0;
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: 0;
    --fsds-box-model-padding-inline-end: 0;
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-chip-color-background-default: var(--fsds-semantic-color-action-background-secondary-default, #fafafa);
    --fsds-chip-color-background-hover: var(--fsds-semantic-color-action-background-secondary-hover, #d0d0d0);
    --fsds-chip-color-foreground-default: var(--fsds-semantic-color-action-foreground-secondary-default, #141414);
    --fsds-chip-color-border-default: var(--fsds-semantic-color-action-border-secondary-default, #a0a0a1);
    --fsds-chip-size-padding-horizontal: var(--fsds-core-spacing-size-04, 8px);
    --fsds-chip-size-padding-vertical: var(--fsds-core-spacing-size-02, 2px);
    --fsds-chip-size-gap: var(--fsds-core-spacing-size-02, 2px);
    --fsds-chip-size-radius: var(--fsds-semantic-shape-control-radius-pill, 9999px);
    --fsds-chip-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-chip-text-size: var(--fsds-semantic-typography-body-04, 12px);
    --fsds-chip-text-weight: var(--fsds-semantic-typography-font-weight-medium, 500);
    --fsds-chip-motion-duration-fast: var(--fsds-core-motion-duration-short, 150ms);
    --fsds-chip-size-min-height: var(--fsds-core-dimension-action-min-height, 36px);
    --fsds-chip-color-background-selected: var(--fsds-semantic-color-background-info-subtle, #95dafb);
    --fsds-chip-color-foreground-selected: var(--fsds-semantic-color-foreground-on-info-subtle, #013ab0);
    --fsds-chip-color-border-selected: var(--fsds-semantic-color-border-info, #034fd6);
    --fsds-chip-dismiss-size: var(--fsds-core-spacing-size-05, 12px);
    --fsds-chip-dismiss-gap: var(--fsds-core-spacing-size-02, 2px);
}

.chip {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 0);
    padding-bottom: var(--fsds-box-model-padding-block-end, 0);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 0);
    padding-right: var(--fsds-box-model-padding-inline-end, 0);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.chip {
    display: flex;
    flex-direction: row;
    align-items: center;
    white-space: nowrap;
    background-color: var(--fsds-chip-color-background-default, #fafafa);
    color: var(--fsds-chip-color-foreground-default, #141414);
    border-color: var(--fsds-chip-color-border-default, #a0a0a1);
    border-width: var(--fsds-chip-size-border, 1px);
    padding-top: var(--fsds-chip-size-padding-vertical, 2px);
    padding-bottom: var(--fsds-chip-size-padding-vertical, 2px);
    padding-left: var(--fsds-chip-size-padding-horizontal, 8px);
    padding-right: var(--fsds-chip-size-padding-horizontal, 8px);
    --fsds-gap: var(--fsds-chip-size-gap, 2px);
    border-radius: var(--fsds-chip-size-radius, 9999px);
    min-height: var(--fsds-chip-size-min-height, 36px);
    font-size: var(--fsds-chip-text-size, 12px);
}

.chip:hover {
    background-color: var(--fsds-chip-color-background-hover, #d0d0d0);
}

.chip__action {
    flex: 1 1 auto;
    min-width: 0;
}

.chip__dismiss {
    flex: 0 0 auto;
    margin-left: var(--fsds-chip-dismiss-gap, 2px);
}

.chip__icon {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 2px;
}

.chip__text {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    font-size: var(--fsds-chip-text-size, 12px);
}

.chip.chip--selected {
    --fsds-chip-color-background-default: var(--fsds-chip-color-background-selected, #95dafb);
    --fsds-chip-color-foreground-default: var(--fsds-chip-color-foreground-selected, #013ab0);
    --fsds-chip-color-border-default: var(--fsds-chip-color-border-selected, #034fd6);
}

.chip.chip--dismissible {
    --fsds-chip-size-padding-horizontal: var(--fsds-core-spacing-size-05, 12px);
}

.chip.chip--small {
    --fsds-chip-size-padding-vertical: var(--fsds-semantic-glyph-badge-size-sm-padding-y, 2px);
    --fsds-chip-size-padding-horizontal: var(--fsds-semantic-glyph-badge-size-sm-padding-x, 4px);
    --fsds-chip-text-size: var(--fsds-semantic-glyph-badge-size-sm-font-size, 10px);
    --fsds-chip-size-gap: var(--fsds-semantic-glyph-badge-size-sm-gap, 2px);
    --fsds-chip-size-min-height: var(--fsds-semantic-glyph-badge-size-sm-min-height, 16px);
}

.chip.chip--medium {
    --fsds-chip-size-padding-vertical: var(--fsds-semantic-glyph-badge-size-md-padding-y, 2px);
    --fsds-chip-size-padding-horizontal: var(--fsds-semantic-glyph-badge-size-md-padding-x, 8px);
    --fsds-chip-text-size: var(--fsds-semantic-glyph-badge-size-md-font-size, 12px);
    --fsds-chip-size-gap: var(--fsds-semantic-glyph-badge-size-md-gap, 4px);
    --fsds-chip-size-min-height: var(--fsds-semantic-glyph-badge-size-md-min-height, 24px);
}

.chip.chip--large {
    --fsds-chip-size-padding-vertical: var(--fsds-semantic-glyph-badge-size-lg-padding-y, 4px);
    --fsds-chip-size-padding-horizontal: var(--fsds-semantic-glyph-badge-size-lg-padding-x, 12px);
    --fsds-chip-text-size: var(--fsds-semantic-glyph-badge-size-lg-font-size, 14px);
    --fsds-chip-size-gap: var(--fsds-semantic-glyph-badge-size-lg-gap, 4px);
    --fsds-chip-size-min-height: var(--fsds-semantic-glyph-badge-size-lg-min-height, 32px);
}

/* CodeSnippet (.code-snippet) */
.code-snippet {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-display-size-gap, 4px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: 0;
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-code-snippet-color-background: var(--fsds-semantic-color-background-secondary, #f7f7f7);
    --fsds-code-snippet-color-foreground-primary: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-code-snippet-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-code-snippet-size-padding-inline: var(--fsds-core-spacing-size-02, 2px);
    --fsds-code-snippet-size-padding-block: var(--fsds-core-spacing-size-01, 1px);
    --fsds-code-snippet-size-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-code-snippet-size-border: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-code-snippet-size-font-size: var(--fsds-core-typography-ramp-3, 14px);
    --fsds-code-snippet-typography-line-height: var(--fsds-semantic-typography-line-height-body, 1.5);
}

.code-snippet {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 4px);
    min-width: var(--fsds-box-model-min-width, 0);
    min-height: var(--fsds-box-model-min-height, 0);
}

.code-snippet {
    background-color: var(--fsds-code-snippet-color-background, #f7f7f7);
    border-color: var(--fsds-code-snippet-color-border, #d0d0d0);
    border-width: var(--fsds-code-snippet-size-border, 1px);
    border-radius: var(--fsds-code-snippet-size-radius, 6px);
    color: var(--fsds-code-snippet-color-foreground-primary, #141414);
    font-size: var(--fsds-code-snippet-size-font-size, 14px);
    margin: 0;
    padding-top: var(--fsds-code-snippet-size-padding-block, 1px);
    padding-bottom: var(--fsds-code-snippet-size-padding-block, 1px);
    padding-left: var(--fsds-code-snippet-size-padding-inline, 2px);
    padding-right: var(--fsds-code-snippet-size-padding-inline, 2px);
    white-space: nowrap;
}

.code-snippet.code-snippet--samp {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

/* Dialog (.dialog) */
.dialog {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-dialog-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-dialog-color-foreground: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-dialog-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-dialog-size-radius: var(--fsds-semantic-shape-radius-large, 16px);
    --fsds-dialog-size-sm-width: 400px;
    --fsds-dialog-size-md-width: 500px;
    --fsds-dialog-size-lg-width: 700px;
    --fsds-dialog-size-xl-width: 900px;
    --fsds-dialog-size-close-button-size: var(--fsds-core-spacing-size-08, 32px);
    --fsds-dialog-spacing-header-padding-top: var(--fsds-core-spacing-size-06, 16px);
    --fsds-dialog-spacing-body-padding-right: var(--fsds-core-spacing-size-07, 24px);
    --fsds-dialog-spacing-footer-gap: var(--fsds-core-spacing-size-03, 4px);
    --fsds-dialog-typography-title-font-size: var(--fsds-semantic-typography-heading-04, 18px);
    --fsds-dialog-typography-title-font-weight: var(--fsds-semantic-typography-font-weight-bold, 700);
    --fsds-dialog-typography-title-line-height: var(--fsds-semantic-typography-line-height-heading, 1);
}

.dialog {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.dialog {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.dialog__backdrop {
    position: absolute;
    --fsds-dialog-color-background: var(--fsds-semantic-color-overlay-scrim, rgba(0, 0, 0, 0.4));
}

.dialog__modal {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-dialog-color-background, #ffffff);
    color: var(--fsds-dialog-color-foreground, #141414);
    border-color: var(--fsds-dialog-color-border, #d0d0d0);
    border-width: 1px;
    border-radius: var(--fsds-dialog-size-radius, 16px);
    width: var(--fsds-dialog-size-md-width, 500px);
    overflow: hidden;
    min-width: 0;
}

.dialog__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-top: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-right: var(--fsds-dialog-spacing-body-padding-right, 24px);
    padding-bottom: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-left: var(--fsds-dialog-spacing-body-padding-right, 24px);
    border-bottom-color: var(--fsds-dialog-color-border, #d0d0d0);
    border-bottom-width: 1px;
    flex-shrink: 0;
}

.dialog__title {
    margin: 0;
    font-size: var(--fsds-dialog-typography-title-font-size, 18px);
    -unity-font-style: bold;
    color: var(--fsds-dialog-color-foreground, #141414);
}

.dialog__body {
    flex: 1 1 auto;
    padding-top: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-right: var(--fsds-dialog-spacing-body-padding-right, 24px);
    padding-bottom: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-left: var(--fsds-dialog-spacing-body-padding-right, 24px);
    --fsds-dialog-color-foreground: var(--fsds-semantic-color-foreground-secondary, #474647);
    min-width: 0;
    min-height: 0;
}

.dialog__footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    --fsds-gap: var(--fsds-dialog-spacing-footer-gap, 4px);
    padding-top: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-right: var(--fsds-dialog-spacing-body-padding-right, 24px);
    padding-bottom: var(--fsds-dialog-spacing-header-padding-top, 16px);
    padding-left: var(--fsds-dialog-spacing-body-padding-right, 24px);
    border-top-color: var(--fsds-dialog-color-border, #d0d0d0);
    border-top-width: 1px;
    flex-shrink: 0;
}

.dialog__closeButton {
    position: absolute;
    top: var(--fsds-dialog-spacing-header-padding-top, 16px);
    right: var(--fsds-dialog-spacing-body-padding-right, 24px);
    width: var(--fsds-dialog-size-close-button-size, 32px);
    height: var(--fsds-dialog-size-close-button-size, 32px);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 9999px;
    --fsds-dialog-color-foreground: var(--fsds-semantic-color-foreground-secondary, #474647);
}

.dialog__closeButton:hover {
    --fsds-dialog-color-background: var(--fsds-semantic-color-background-hover, #f7f7f7);
}

.dialog--sm .dialog__modal {
    width: var(--fsds-dialog-size-sm-width, 400px);
}

.dialog--lg .dialog__modal {
    width: var(--fsds-dialog-size-lg-width, 700px);
}

.dialog--xl .dialog__modal {
    width: var(--fsds-dialog-size-xl-width, 900px);
}

.dialog--full .dialog__modal {
    border-radius: 0;
}

/* Sheet (.sheet) */
.sheet {
    --fsds-box-model-padding: 0;
    --fsds-box-model-padding-block: 0;
    --fsds-box-model-padding-block-start: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-block-end: var(--fsds-semantic-surface-size-padding-block, 16px);
    --fsds-box-model-padding-inline: 0;
    --fsds-box-model-padding-inline-start: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-padding-inline-end: var(--fsds-semantic-surface-size-padding-inline, 16px);
    --fsds-box-model-gap: var(--fsds-semantic-surface-size-gap, 8px);
    --fsds-box-model-width: auto;
    --fsds-box-model-min-width: var(--fsds-semantic-surface-size-min-width, 64px);
    --fsds-box-model-max-width: none;
    --fsds-box-model-height: auto;
    --fsds-box-model-min-height: 0;
    --fsds-box-model-max-height: none;
    --fsds-sheet-color-overlay: var(--fsds-semantic-overlay-scrim-medium, rgba(0, 0, 0, 0.40));
    --fsds-sheet-color-background: var(--fsds-semantic-color-background-primary, #ffffff);
    --fsds-sheet-color-border: var(--fsds-semantic-surface-border-subtle, #d0d0d0);
    --fsds-sheet-color-text: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-sheet-color-text-title: var(--fsds-semantic-color-foreground-primary, #141414);
    --fsds-sheet-color-text-description: var(--fsds-semantic-color-foreground-secondary, #474647);
    --fsds-sheet-border-width: var(--fsds-semantic-shape-control-border-default-width, 1px);
    --fsds-sheet-border-radius: var(--fsds-semantic-shape-control-radius-default, 6px);
    --fsds-sheet-size-width: 400px;
    --fsds-sheet-size-height: 300px;
    --fsds-sheet-size-close: var(--fsds-core-spacing-size-06, 16px);
    --fsds-sheet-spacing-padding: var(--fsds-core-spacing-size-06, 16px);
    --fsds-sheet-spacing-gap: var(--fsds-core-spacing-size-04, 8px);
    --fsds-sheet-text-size: var(--fsds-semantic-typography-body-02, 16px);
    --fsds-sheet-text-size-title: var(--fsds-semantic-typography-heading-06, 14px);
    --fsds-sheet-text-weight-title: var(--fsds-semantic-typography-font-weight-medium, 500);
}

.sheet {
    padding: var(--fsds-box-model-padding, 0);
    padding-top: var(--fsds-box-model-padding-block, 0);
    padding-bottom: var(--fsds-box-model-padding-block, 0);
    padding-top: var(--fsds-box-model-padding-block-start, 16px);
    padding-bottom: var(--fsds-box-model-padding-block-end, 16px);
    padding-left: var(--fsds-box-model-padding-inline, 0);
    padding-right: var(--fsds-box-model-padding-inline, 0);
    padding-left: var(--fsds-box-model-padding-inline-start, 16px);
    padding-right: var(--fsds-box-model-padding-inline-end, 16px);
    --fsds-gap: var(--fsds-box-model-gap, 8px);
    min-width: var(--fsds-box-model-min-width, 64px);
    min-height: var(--fsds-box-model-min-height, 0);
}

.sheet {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.sheet__overlay {
    position: absolute;
    background-color: var(--fsds-sheet-color-overlay, rgba(0, 0, 0, 0.40));
}

.sheet__content {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--fsds-sheet-color-background, #ffffff);
    color: var(--fsds-sheet-color-text, #141414);
    border-color: var(--fsds-sheet-color-border, #d0d0d0);
    border-width: var(--fsds-sheet-border-width, 1px);
    width: var(--fsds-sheet-size-width, 400px);
    overflow: hidden;
}

.sheet__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: var(--fsds-sheet-spacing-padding, 16px);
    border-bottom-color: var(--fsds-sheet-color-border, #d0d0d0);
    border-bottom-width: 1px;
    --fsds-gap: var(--fsds-sheet-spacing-gap, 8px);
}

.sheet__title {
    margin: 0;
    font-size: var(--fsds-sheet-text-size-title, 14px);
    color: var(--fsds-sheet-color-text-title, #141414);
    flex: 1 1 auto;
}

.sheet__description {
    margin: 0;
    color: var(--fsds-sheet-color-text-description, #474647);
    font-size: var(--fsds-sheet-text-size, 16px);
}

.sheet__body {
    flex: 1 1 auto;
    padding: var(--fsds-sheet-spacing-padding, 16px);
    color: var(--fsds-sheet-color-text, #141414);
}

.sheet__footer {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    --fsds-gap: var(--fsds-sheet-spacing-gap, 8px);
    padding: var(--fsds-sheet-spacing-padding, 16px);
    border-top-color: var(--fsds-sheet-color-border, #d0d0d0);
    border-top-width: 1px;
}

.sheet__close {
    position: absolute;
    top: var(--fsds-sheet-spacing-padding, 16px);
    right: var(--fsds-sheet-spacing-padding, 16px);
    width: var(--fsds-sheet-size-close, 16px);
    height: var(--fsds-sheet-size-close, 16px);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 9999px;
    color: var(--fsds-sheet-color-text-description, #474647);
}

.sheet--right .sheet__content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--fsds-sheet-size-width, 400px);
    border-radius: var(--fsds-sheet-border-radius, 6px);
}

.sheet--left .sheet__content {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: var(--fsds-sheet-size-width, 400px);
    border-radius: var(--fsds-sheet-border-radius, 6px);
}

.sheet--top .sheet__content {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-height: var(--fsds-sheet-size-height, 300px);
    border-radius: var(--fsds-sheet-border-radius, 6px);
}

.sheet--bottom .sheet__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-height: var(--fsds-sheet-size-height, 300px);
    border-radius: var(--fsds-sheet-border-radius, 6px);
}
