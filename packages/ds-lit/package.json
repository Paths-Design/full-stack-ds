{
  "name": "@full-stack-ds/lit",
  "version": "0.1.0",
  "type": "module",
  "description": "Lit implementation of Full Stack DS (Stack element + generated components)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives/index.js",
      "require": "./dist/primitives/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:templates": "lit-analyzer 'src/components/**/*.ts' --format list --noColor --rules.no-incompatible-type-binding off",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "jsdom": "^27.0.1",
    "lit": "^3.2.0",
    "lit-analyzer": "^2.0.3",
    "tsup": "^8.3.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@full-stack-ds/iconography": "workspace:*"
  },
  "license": "MIT",
  "author": "DesignPaths, LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paths-Design/full-stack-ds.git",
    "directory": "packages/ds-lit"
  },
  "homepage": "https://github.com/Paths-Design/full-stack-ds/tree/main/packages/ds-lit#readme",
  "bugs": {
    "url": "https://github.com/Paths-Design/full-stack-ds/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
