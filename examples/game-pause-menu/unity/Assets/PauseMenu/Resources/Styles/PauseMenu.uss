/*
 * Game pause menu — parity lane stylesheet (Unity UI Toolkit).
 *
 * The parity pass places every region, colour and type size from
 * fixtures/parity-layout.json as inline styles, so this sheet only carries what inline styles
 * cannot express: the generated-component state rules that must be overridden explicitly and the
 * root structure. The one mandatory override is the switch geometry pin (below): the generated
 * sheet projects the token `9999px` pill radius verbatim, which Unity paints as an ellipse on the
 * 64x32 track. The lane pins explicit stadium radii instead of trusting the token.
 *
 * NOT FSDS: this is consumer styling of generated component parts and state classes, not generated
 * component source.
 */

/* Generated Tabs: the tab bar strip and tab cells are placed by inline geometry; remove the
 * generated padding/indicator chrome that would paint outside the pinned boxes. */
.pause-app .parity-tabs > .tabs__list {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-radius: 0;
}

.pause-app .parity-tabs .tabs__indicator {
    display: none;
}

.pause-app .parity-tabs > .tabs__panel {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* ---- SWITCH PARITY FIX ---------------------------------------------------
 * Canonical geometry from fixtures/parity-layout.json `switch`:
 *   track 64x32, radius 16 (half height -> stadium), thumb 24x24 radius 12, inset 4,
 *   checked thumb offset x=36, on track signal / off track graphite, on thumb onSignal /
 *   off thumb boneBright, off border 1px ruleStrong, on border none.
 * Root cause of the first-pass oval: the generated `.switch__track` rule sets
 * `border-radius: var(--fsds-switch-size-*-track-radius, 9999px)`; UI Toolkit does not clamp that
 * oversized single radius to a stadium, it stretches the corner arcs into an ellipse. These rules
 * replace the radius with explicit half-height values and pin the 64x32 / 24px / 36px geometry.
 * The on/off colours stay inline from the layout fixture (colours come from the JSON table only).
 * ------------------------------------------------------------------------- */
.pause-app .switch--lg {
    width: 64px;
    height: 32px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    min-width: 0;
    min-height: 0;
}

.pause-app .switch--lg > .switch__track {
    width: 64px;
    height: 32px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.pause-app .switch--lg .switch__thumb {
    width: 24px;
    height: 24px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    top: 4px;
    left: 4px;
    translate: 0 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.pause-app .switch--lg > .switch__input {
    display: none;
}

.pause-app .switch--lg > .switch__children {
    display: none;
}

/* Generated structural surfaces: the lane paints every colour inline from the fixture, so the
 * generated padding/gap defaults are stripped here to keep the pinned boxes exact. */
.pause-app .parity-panel,
.pause-app .ability-card {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.pause-app .parity-popover-content {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* Generated Card token channel. The lane sets the generated component's token
 * variables and lets its own rules consume them, rather than repeating the
 * authority values as inline colour/border/radius styles. The values resolve
 * through the generated .fsds-brand-orion(.fsds-theme--dark) scope. */
.pause-app .parity-panel {
    --fsds-card-color-background-default: var(--fsds-semantic-color-background-secondary);
    --fsds-card-color-border: var(--fsds-semantic-color-border-subtle);
    --fsds-card-size-radius: var(--fsds-semantic-shape-card-radius);
}

.pause-app .parity-panel--steel {
    --fsds-card-color-background-default: var(--fsds-semantic-color-border-default);
}

.pause-app .ability-card {
    --fsds-card-color-background-default: var(--fsds-semantic-color-background-secondary);
    --fsds-card-color-border: var(--fsds-semantic-color-border-subtle);
    --fsds-card-size-radius: var(--fsds-semantic-shape-card-radius);
}

.pause-app .parity-panel-header {
    border-bottom-color: var(--fsds-semantic-color-border-subtle);
}

/* Industrial pass 3: thicker parity panel frames. */
.pause-app .parity-panel.parity-panel {
    border-width: 2px;
}
