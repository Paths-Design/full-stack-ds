# Godot import cache / generated project state.
.godot/
*.uid

# The generated Full Stack DS addon is materialized by ./setup.sh from
# packages/ds-godot/addons/full_stack_ds; generated bytes stay out of git.
addons/full_stack_ds/

# Export bundles never belong to the consumer project.
build/
export/

# Sampled-state captures (evidence). Committed sources only; the Lead collects
# the PNGs from here.
evidence/

# Inter faces are copied from ../fonts by setup.sh (committed single source).
fonts/
